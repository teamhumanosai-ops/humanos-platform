 10: 
 11: export class GraphQuery {
 12:   getNode(
 13:     id: string
 14:   ): GraphNode | undefined {
 15:     return graphStore.getNode(
 16:       id
 17:     );
 18:   }
 19: 
 20:   getNodes(): GraphNode[] {
 21:     return graphStore.getNodes();
 22:   }
 23: 
 24:   getEdges(): GraphEdge[] {
 25:     return graphStore.getEdges();
 26:   }
 27: 
 28:   getNeighbors(
 29:     nodeId: string
 30:   ): GraphNode[] {
 31:     const neighbors =
 32:       new Map<
 33:         string,
 34:         GraphNode
 35:       >();
 36: 
 37:     for (
 38:       const edge of
 39:       graphStore.getEdges()
 40:     ) {
 41:       if (
 42:         edge.from === nodeId
 43:       ) {
 44:         const node =
 45:           graphStore.getNode(
 46:             edge.to
 47:           );
 48: 
 49:         if (node) {
 50:           neighbors.set(
 51:             node.id,
 52:             node
 53:           );
 54:         }
 55:       }
 56: 
 57:       if (
 58:         edge.to === nodeId
 59:       ) {
 60:         const node =
 61:           graphStore.getNode(
 62:             edge.from
 63:           );
 64: 
 65:         if (node) {
 66:           neighbors.set(
 67:             node.id,
 68:             node
 69:           );
 70:         }
 71:       }
 72:     }
 73: 
 74:     return [
 75:       ...neighbors.values(),
 76:     ];
 77:   }
