<file path="frontend/brain/memory/retrieval.ts">
 1: import { loadMemories } from "./store";
 2: import type { Memory } from "./types";
 3: import { semanticScore } from "./semantic";
 4: 
 5: export async function retrieveRelevantMemories(
 6:   query = "",
 7:   limit = 10
 8: ): Promise<Memory[]> {
 9:   const memories = await loadMemories();
10: 
11:   return memories
12:     .map((memory) => ({
13:       memory,
14:       score:
15:         semanticScore(memory, query) +
16:         memory.importance,
17:     }))
18:     .sort((a, b) => {
19:       if (a.score !== b.score) {
20:         return b.score - a.score;
21:       }
22: 
23:       if (
24:         a.memory.kind === "long_term" &&
25:         b.memory.kind !== "long_term"
26:       ) {
27:         return -1;
28:       }
29: 
30:       if (
31:         a.memory.kind !== "long_term" &&
32:         b.memory.kind === "long_term"
33:       ) {
34:         return 1;
35:       }
36: 
37:       return a.memory.key.localeCompare(
38:         b.memory.key
39:       );
40:     })
41:     .slice(0, limit)
42:     .map((entry) => entry.memory);
43: }
</file>

<file path="frontend/brain/runtime/steps/decisionStage.ts">
  1: import {
  2:   BrainState,
  3: } from "../../brainState";
  4: 
  5: import {
  6:   getBestDecision,
  7: } from "../../decision";
  8: 
  9: import {
 10:   getPlan,
 11: } from "../../planning";
 12: 
 13: import {
 14:   BaseStage,
 15: } from "./baseStage";
 16: 
 17: /**
 18:  * DecisionStage
 19:  *
 20:  * Integrates the existing Decision Engine
 21:  * into the Cognitive Runtime.
 22:  *
 23:  * The Decision Engine remains authoritative
 24:  * for selecting the action.
 25:  *
 26:  * BrainState reasoning evidence is preserved
 27:  * alongside the resulting decision so later
 28:  * runtime stages can understand the cognitive
 29:  * evidence that preceded the decision.
 30:  */
 31: export class DecisionStage
 32:   extends BaseStage {
 33:   readonly name =
 34:     "Decision";
 35: 
 36:   protected async process(
 37:     state: BrainState
 38:   ): Promise<BrainState> {
 39:     /*
 40:     |--------------------------------------------------------------------------
 41:     | A local skill response does not require
 42:     | decision generation.
 43:     |--------------------------------------------------------------------------
 44:     */
 45: 
 46:     if (
 47:       state.response
 48:     ) {
 49:       return state;
 50:     }
 51: 
 52:     /*
 53:     |--------------------------------------------------------------------------
 54:     | Decision requires an active plan.
 55:     |--------------------------------------------------------------------------
 56:     */
 57: 
 58:     if (
 59:       !state.currentPlanId
 60:     ) {
 61:       return state;
 62:     }
 63: 
 64:     const plan =
 65:       getPlan(
 66:         state.currentPlanId
 67:       );
 68: 
 69:     if (!plan) {
 70:       return state;
 71:     }
 72: 
 73:     /*
 74:     |--------------------------------------------------------------------------
 75:     | Existing Decision Engine
 76:     |--------------------------------------------------------------------------
 77:     |
 78:     | The engine remains responsible for selecting
 79:     | the best action from the current plan.
 80:     |
 81:     */
 82: 
 83:     const decision =
 84:       getBestDecision(
 85:         plan
 86:       );
 87: 
 88:     state.currentDecisionId =
 89:       decision.id;
 90: 
 91:     /*
 92:     |--------------------------------------------------------------------------
 93:     | Structured reasoning evidence
 94:     |--------------------------------------------------------------------------
 95:     |
 96:     | Preserve the reasoning signals that were
 97:     | available before the decision was created.
 98:     |
 99:     */
100: 
101:     const reasoningEvidence =
102:       state.reasoningObservations
103:         .map(
104:           (
105:             observation,
106:             index
107:           ) =>
108:             `${index + 1}. [${
109:               observation.source
110:             }] ${
111:               observation.statement
112:             } (confidence ${
113:               observation.confidence.toFixed(
114:                 2
115:               )
116:             })`
117:         );
118: 
119:     /*
120:     |--------------------------------------------------------------------------
121:     | Decision artifact
122:     |--------------------------------------------------------------------------
123:     */
124: 
125:     state.decision =
126:       [
127:         `Decision: ${decision.title}`,
128: 
129:         `Description: ${decision.description}`,
130: 
131:         `Selected Action: ${decision.selectedAction}`,
132: 
133:         "Alternatives:",
134: 
135:         ...decision.alternatives.map(
136:           (
137:             alternative,
138:             index
139:           ) =>
140:             `${index + 1}. ${alternative}`
141:         ),
142: 
143:         `Reason: ${decision.reason}`,
144: 
145:         `Confidence: ${decision.confidence}`,
146: 
147:         ...(reasoningEvidence.length > 0
148:           ? [
149:               "",
150: 
151:               "Reasoning Evidence:",
152: 
153:               ...reasoningEvidence,
154:             ]
155:           : []),
156: 
157:         ...(state.reasoningConfidence > 0
158:           ? [
159:               "",
160: 
161:               `Overall Reasoning Confidence: ${state.reasoningConfidence.toFixed(
162:                 2
163:               )}`,
164:             ]
165:           : []),
166:       ].join("\n");
167: 
168:     return state;
169:   }
170: }
</file>

<file path="frontend/brain/runtime/steps/liveKnowledgeStage.ts">
  1: import { BrainState } from "../../brainState";
  2: import { Intent } from "../../intent";
  3: 
  4: import {
  5:   buildCitationSources,
  6: } from "../../websearch/citations";
  7: 
  8: import type {
  9:   RuntimeServices,
 10: } from "../runtimeServices";
 11: 
 12: import { BaseStage } from "./baseStage";
 13: 
 14: export class LiveKnowledgeStage
 15:   extends BaseStage {
 16:   readonly name =
 17:     "LiveKnowledge";
 18: 
 19:   constructor(
 20:     private readonly services:
 21:       RuntimeServices
 22:   ) {
 23:     super();
 24:   }
 25: 
 26:   protected async process(
 27:     state: BrainState
 28:   ): Promise<BrainState> {
 29:     if (
 30:       state.intent !==
 31:       Intent.LIVE_SEARCH
 32:     ) {
 33:       return state;
 34:     }
 35: 
 36:     try {
 37:       const search =
 38:         await this.services.searchWeb(
 39:           state.userMessage
 40:         );
 41: 
 42:       state.citations =
 43:         buildCitationSources(
 44:           search.results
 45:         );
 46: 
 47:       const evidence =
 48:         search.results.map(
 49:           (result, index) =>
 50:             `[${index + 1}]
 51: Title: ${result.title}
 52: URL: ${result.url}
 53: Published: ${
 54:               result.publishedDate ??
 55:               "unknown"
 56:             }
 57: Evidence: ${result.snippet}`
 58:         );
 59: 
 60:       state.liveKnowledge = [
 61:         [
 62:           "LIVE WEB SEARCH EXECUTED.",
 63: 
 64:           `Search time: ${search.searchedAt}`,
 65: 
 66:           `Search query: ${search.query}`,
 67: 
 68:           search.answer
 69:             ? `Search synthesis:\n${search.answer}`
 70:             : "No search synthesis was returned.",
 71: 
 72:           evidence.length > 0
 73:             ? `Evidence:\n\n${evidence.join(
 74:                 "\n\n"
 75:               )}`
 76:             : "No usable evidence was returned.",
 77:         ].join("\n\n"),
 78:       ];
 79: 
 80:       return state;
 81:     } catch (error) {
 82:       const message =
 83:         error instanceof Error
 84:           ? error.message
 85:           : String(error);
 86: 
 87:       state.citations = [];
 88: 
 89:       state.liveKnowledge = [];
 90: 
 91:       state.errors.push(
 92:         `LiveKnowledge: ${message}`
 93:       );
 94: 
 95:       state.response =
 96:         "I couldn't retrieve current web information for that request. Please try again in a moment.";
 97: 
 98:       return state;
 99:     }
100:   }
101: }
</file>

<file path="frontend/brain/runtime/steps/responseValidationStage.ts">
  1: import {
  2:   BrainState,
  3: } from "../../brainState";
  4: 
  5: import {
  6:   BaseStage,
  7: } from "./baseStage";
  8: 
  9: /**
 10:  * ResponseValidationStage
 11:  *
 12:  * Performs deterministic validation of the generated
 13:  * response before the runtime finalizes the outcome.
 14:  *
 15:  * This stage does not attempt to judge whether the
 16:  * model's answer is factually correct.
 17:  *
 18:  * Its purpose is to detect structural response failures
 19:  * that the runtime can identify deterministically,
 20:  * including evidence-grounding failures.
 21:  */
 22: export class ResponseValidationStage
 23:   extends BaseStage {
 24:   readonly name =
 25:     "ResponseValidation";
 26: 
 27:   protected async process(
 28:     state: BrainState
 29:   ): Promise<BrainState> {
 30:     if (!state.response) {
 31:       state.errors.push(
 32:         "ResponseValidation: no response was generated."
 33:       );
 34: 
 35:       return state;
 36:     }
 37: 
 38:     const response =
 39:       state.response.trim();
 40: 
 41:     if (response.length === 0) {
 42:       state.errors.push(
 43:         "ResponseValidation: generated response is empty."
 44:       );
 45: 
 46:       return state;
 47:     }
 48: 
 49:     /*
 50:     |--------------------------------------------------------------------------
 51:     | Current-information validation
 52:     |--------------------------------------------------------------------------
 53:     |
 54:     | If live evidence was retrieved, the response should
 55:     | not claim that no information was found.
 56:     |
 57:     */
 58: 
 59:     if (
 60:       state.liveKnowledge.length > 0 &&
 61:       this.isUnsupportedNoInformationResponse(
 62:         response
 63:       )
 64:     ) {
 65:       state.errors.push(
 66:         "ResponseValidation: response contradicts available live evidence."
 67:       );
 68:     }
 69: 
 70:     /*
 71:     |--------------------------------------------------------------------------
 72:     | Citation validation
 73:     |--------------------------------------------------------------------------
 74:     |
 75:     | When citation sources exist, every citation marker
 76:     | used by the response must correspond to an actual
 77:     | citation supplied by the runtime.
 78:     |
 79:     | This prevents the model from inventing citation
 80:     | numbers such as [7] when only [1] and [2] exist.
 81:     |
 82:     */
 83: 
 84:     if (
 85:       state.citations.length > 0
 86:     ) {
 87:       const citationMarkers =
 88:         this.extractCitationMarkers(
 89:           response
 90:         );
 91: 
 92:       const validCitationIndexes =
 93:         new Set(
 94:           state.citations.map(
 95:             (citation) =>
 96:               citation.index
 97:           )
 98:         );
 99: 
100:       const invalidMarkers =
101:         citationMarkers.filter(
102:           (index) =>
103:             !validCitationIndexes.has(
104:               index
105:             )
106:         );
107: 
108:       for (
109:         const index of
110:         new Set(invalidMarkers)
111:       ) {
112:         state.errors.push(
113:           `ResponseValidation: response contains unsupported citation marker [${index}].`
114:         );
115:       }
116: 
117:       /*
118:       |--------------------------------------------------------------------------
119:       | Evidence usage
120:       |--------------------------------------------------------------------------
121:       |
122:       | For live/current-information responses, the
123:       | presence of retrieved citation evidence should
124:       | normally result in at least one valid citation
125:       | marker in the generated response.
126:       |
127:       | We intentionally do not require citations for
128:       | every sentence because deterministic validation
129:       | cannot safely determine which individual claims
130:       | require which source.
131:       |
132:       */
133: 
134:       if (
135:         state.liveKnowledge.length > 0 &&
136:         citationMarkers.length === 0
137:       ) {
138:         state.errors.push(
139:           "ResponseValidation: live evidence is available but the response contains no citation markers."
140:         );
141:       }
142:     }
143: 
144:     return state;
145:   }
146: 
147:   private extractCitationMarkers(
148:     response: string
149:   ): number[] {
150:     const markers: number[] = [];
151: 
152:     const pattern =
153:       /\[(\d+)\]/g;
154: 
155:     let match =
156:       pattern.exec(
157:         response
158:       );
159: 
160:     while (
161:       match
162:     ) {
163:       markers.push(
164:         Number(
165:           match[1]
166:         )
167:       );
168: 
169:       match =
170:         pattern.exec(
171:           response
172:         );
173:     }
174: 
175:     return markers;
176:   }
177: 
178:   private isUnsupportedNoInformationResponse(
179:     response: string
180:   ): boolean {
181:     const normalized =
182:       response.toLowerCase();
183: 
184:     const indicators = [
185:       "i don't have access to current information",
186:       "i do not have access to current information",
187:       "i can't access the web",
188:       "i cannot access the web",
189:       "i don't have access to the web",
190:       "i do not have access to the web",
191:       "i cannot browse the web",
192:       "i can't browse the web",
193:     ];
194: 
195:     return indicators.some(
196:       (indicator) =>
197:         normalized.includes(
198:           indicator
199:         )
200:     );
201:   }
202: }
</file>

