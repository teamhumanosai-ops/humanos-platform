12:     constructor(
13:         private readonly engine: PdfEngine =
14:             new PdfParseEngine()
15:     ) {
16:         super();
17:     }
18: 
19:     protected async doExtract(
20:         content?: Buffer | string
21:     ): Promise<ExtractedContent> {
22:         if (!content) {
23:             return {
24:                 text: "",
25:                 sections: [],
26:             };
27:         }
28: 
29:         const buffer =
30:             typeof content === "string"
