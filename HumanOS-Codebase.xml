<file path="frontend/brain/graph/MemoryGraphAdapter.ts">
  1: import { graphBuilder } from "./GraphBuilder";
  2: 
  3: import type {
  4:   ExtractedRelationship,
  5: } from "../memory/RelationshipAnalyzer";
  6: 
  7: export interface MemoryGraphRecord {
  8:   id: string;
  9: 
 10:   label: string;
 11: 
 12:   properties?: Record<string, unknown>;
 13: 
 14:   entities?: string[];
 15: 
 16:   relationships?: ExtractedRelationship[];
 17: }
 18: 
 19: function entityId(
 20:   value: string
 21: ): string {
 22:   return `entity:${value
 23:     .trim()
 24:     .toLowerCase()}`;
 25: }
 26: 
 27: function addEntity(
 28:   label: string
 29: ): string {
 30:   const id = entityId(label);
 31: 
 32:   graphBuilder.addEntity(
 33:     id,
 34:     label,
 35:     {
 36:       source: "memory",
 37:     }
 38:   );
 39: 
 40:   return id;
 41: }
 42: 
 43: export class MemoryGraphAdapter {
 44:   sync(
 45:     memory: MemoryGraphRecord
 46:   ): void {
 47:     graphBuilder.addMemory(
 48:       memory.id,
 49:       memory.label,
 50:       memory.properties ?? {}
 51:     );
 52: 
 53:     for (
 54:       const entity of
 55:       memory.entities ?? []
 56:     ) {
 57:       const id =
 58:         addEntity(entity);
 59: 
 60:       graphBuilder.connect(
 61:         memory.id,
 62:         id,
 63:         "mentions"
 64:       );
 65:     }
 66: 
 67:     for (
 68:       const relationship of
 69:       memory.relationships ?? []
 70:     ) {
 71:       const subjectId =
 72:         addEntity(
 73:           relationship.subject
 74:         );
 75: 
 76:       const objectId =
 77:         addEntity(
 78:           relationship.object
 79:         );
 80: 
 81:       graphBuilder.connect(
 82:         subjectId,
 83:         objectId,
 84:         relationship.predicate as
 85:           | "uses"
 86:           | "built_with"
 87:           | "depends_on"
 88:           | "based_on"
 89:           | "created_by"
 90:           | "works_with"
 91:           | "integrates_with"
 92:           | "part_of"
 93:           | "belongs_to",
 94:         relationship.confidence,
 95:         {
 96:           source: "memory",
 97:           confidence:
 98:             relationship.confidence,
 99:         }
100:       );
101:     }
102:   }
103: }
104: 
105: export const memoryGraphAdapter =
106:   new MemoryGraphAdapter();
</file>

