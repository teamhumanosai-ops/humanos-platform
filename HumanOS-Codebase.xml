 5: export class HookRegistry {
 6:     private static readonly hooks: ProcessingHook[] = [];
 7: 
 8:     static register(hook: ProcessingHook): void {
 9:         this.hooks.push(hook);
10:     }
11: 
12:     static async beforeProcess(
13:         context: ProcessingContext
14:     ): Promise<void> {
15:         for (const hook of this.hooks) {
16:             await hook.beforeProcess?.(context);
17:         }
18:     }
19: 
20:     static async afterProcess(
21:         context: ProcessingContext
22:     ): Promise<void> {
23:         for (const hook of this.hooks) {
24:             await hook.afterProcess?.(context);
25:         }
26:     }
27: 
28:     static async onError(
29:         context: ProcessingContext,
30:         error: unknown
31:     ): Promise<void> {
32:         for (const hook of this.hooks) {
33:             await hook.onError?.(context, error);
34:         }
35:     }
36: }
