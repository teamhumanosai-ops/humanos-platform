 2:   | "short_term"
 3:   | "long_term"
 4:   | "episodic"
 5:   | "semantic";
 6: 
 7: export function classifyMemory(
 8:   key: string,
 9:   value: string
10: ): MemoryKind {
11:   const combined = `${key} ${value}`.toLowerCase();
12: 
13:   if (
