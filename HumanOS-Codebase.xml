108: async function callOpenRouter(
109:   messages: ChatMessage[]
110: ): Promise<string> {
111:   const apiKey =
112:     process.env
113:       .OPENROUTER_API_KEY;
114: 
115:   if (
116:     !apiKey
117:   ) {
118:     throw new Error(
119:       "OPENROUTER_API_KEY is not configured."
120:     );
121:   }
122: 
123:   const response =
124:     await fetch(
125:       "https://openrouter.ai/api/v1/chat/completions",
126:       {
127:         method:
128:           "POST",
129: 
130:         headers: {
131:           Authorization:
132:             `Bearer ${apiKey}`,
133: 
134:           "Content-Type":
135:             "application/json",
136:         },
137: 
138:         body:
139:           JSON.stringify({
140:             model:
141:               AI_CONFIG.openRouterModel,
142: 
143:             temperature:
144:               AI_CONFIG.temperature,
145: 
146:             max_tokens:
147:               AI_CONFIG.maxTokens,
148: 
149:             messages,
150:           }),
151:       }
152:     );
153: 
154:   const data:
155:     OpenRouterResponse =
156:     await response.json();
157: 
158:   if (
159:     !response.ok
160:   ) {
161:     throw new Error(
162:       data.error?.message ??
163:         `OpenRouter request failed with status ${response.status}.`
164:     );
165:   }
166: 
167:   const content =
168:     data
169:       .choices?.[0]
170:       ?.message
171:       ?.content;
172: 
173:   if (
174:     !content?.trim()
175:   ) {
176:     throw new Error(
177:       "OpenRouter returned no usable response."
178:     );
179:   }
180: 
181:   return content;
182: }
183: 
184: async function callGemini(
185:   messages: ChatMessage[]
186: ): Promise<string> {
187:   const apiKey =
188:     process.env
189:       .GEMINI_API_KEY;
190: 
191:   if (
192:     !apiKey
193:   ) {
194:     throw new Error(
195:       "GEMINI_API_KEY is not configured."
196:     );
197:   }
198: 
199:   const systemMessage =
200:     messages.find(
201:       (
202:         message
203:       ) =>
204:         message.role ===
205:         "system"
206:     )?.content ?? "";
207: 
208:   const contents =
209:     messages
210:       .filter(
211:         (
212:           message
213:         ) =>
214:           message.role !==
215:           "system"
216:       )
217:       .map(
218:         (
219:           message
220:         ) => ({
221:           role:
222:             message.role ===
223:             "assistant"
224:               ? "model"
225:               : "user",
226: 
227:           parts: [
228:             {
229:               text:
230:                 message.content,
231:             },
232:           ],
233:         })
234:       );
235: 
236:   const response =
237:     await fetch(
238:       `https://generativelanguage.googleapis.com/v1beta/models/${AI_CONFIG.geminiModel}:generateContent?key=${encodeURIComponent(
239:         apiKey
240:       )}`,
241:       {
242:         method:
243:           "POST",
244: 
245:         headers: {
246:           "Content-Type":
247:             "application/json",
248:         },
249: 
250:         body:
251:           JSON.stringify({
252:             systemInstruction:
253:               systemMessage
254:                 ? {
255:                     parts: [
256:                       {
257:                         text:
258:                           systemMessage,
259:                       },
260:                     ],
261:                   }
262:                 : undefined,
263: 
264:             contents,
265: 
266:             generationConfig: {
267:               temperature:
268:                 AI_CONFIG.temperature,
269: 
270:               maxOutputTokens:
271:                 AI_CONFIG.maxTokens,
272:             },
273:           }),
274:       }
275:     );
276: 
277:   const data:
278:     GeminiResponse =
279:     await response.json();
280: 
281:   if (
282:     !response.ok
283:   ) {
284:     throw new Error(
285:       data.error?.message ??
286:         `Gemini request failed with status ${response.status}.`
287:     );
288:   }
289: 
290:   const content =
291:     data
292:       .candidates?.[0]
293:       ?.content
294:       ?.parts
295:       ?.map(
296:         (
297:           part
298:         ) =>
299:           part.text ?? ""
300:       )
301:       .join("")
302:       .trim();
303: 
304:   if (
305:     !content
306:   ) {
307:     throw new Error(
308:       "Gemini returned no usable response."
309:     );
310:   }
311: 
312:   return content;
313: }
314: 
315: async function callProvider(
316:   provider: AIProvider,
317:   messages: ChatMessage[]
318: ): Promise<string> {
319:   switch (
320:     provider
321:   ) {
322:     case "gemini":
323:       return callGemini(
324:         messages
325:       );
326: 
327:     case "openrouter":
328:       return callOpenRouter(
329:         messages
330:       );
331: 
332:     default:
333:       throw new Error(
334:         `Unsupported AI provider: ${provider}`
335:       );
336:   }
337: }
338: 
339: /**
340:  * Human OS multi-provider AI service.
341:  *
342:  * Gemini and OpenRouter are both configured.
343:  *
344:  * The caller never selects a provider manually.
345:  *
346:  * Human OS automatically:
347:  *
348:  * 1. Tries the preferred available provider.
349:  * 2. Marks failed providers temporarily unavailable.
350:  * 3. Falls back to another configured provider.
351:  * 4. Returns the successful provider response.
352:  */
353: export async function generateAIResponse(
354:   messages: ChatMessage[]
355: ): Promise<string> {
356:   const providers =
357:     getProviderOrder();
358: 
359:   if (
360:     providers.length ===
361:     0
362:   ) {
363:     /*
364:      * Cooldowns may temporarily hide
365:      * all providers. Give every configured
366:      * provider another chance rather than
367:      * making Human OS permanently unavailable.
368:      */
369: 
370:     providerFailures.clear();
371: 
372:     providers.push(
373:       ...AI_CONFIG.providers
374:     );
375:   }
376: 
377:   let lastError:
378:     | unknown =
379:     undefined;
380: 
381:   for (
382:     const provider of
383:     providers
384:   ) {
385:     try {
386:       console.log(
387:         `🧠 Human OS AI provider: ${provider}`
388:       );
389: 
390:       const response =
391:         await callProvider(
392:           provider,
393:           messages
394:         );
395: 
396:       markProviderHealthy(
397:         provider
398:       );
399: 
400:       return response;
401:     } catch (
402:       error
403:     ) {
404:       lastError =
405:         error;
406: 
407:       markProviderFailed(
408:         provider
409:       );
410: 
411:       console.error(
412:         `AI provider failed: ${provider}`,
413:         error
414:       );
415: 
416:       if (
417:         !AI_CONFIG.retryFailedProvider
418:       ) {
419:         break;
420:       }
421:     }
422:   }
423: 
424:   throw new Error(
425:     `All configured AI providers failed. Last error: ${
426:       lastError instanceof Error
427:         ? lastError.message
428:         : String(lastError)
429:     }`
430:   );
431: }
</file>

