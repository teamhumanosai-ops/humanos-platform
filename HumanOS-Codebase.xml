15: 
16:     return name
17:       ? `Your name is ${name}.`
18:       : "I don't know your name yet.";
19:   }
20: 
21:   if (lower.includes("where do i live")) {
22:     const city = getValue("city");
23: 
24:     return city
25:       ? `You live in ${city}.`
26:       : "I don't know where you live yet.";
27:   }
28: 
29:   if (lower.includes("favorite color")) {
30:     const color = getValue("favorite_color");
31: 
32:     return color
33:       ? `Your favorite color is ${color}.`
34:       : "I don't know your favorite color yet.";
35:   }
36: 
37:   if (lower.includes("what am i building")) {
38:     const project = getValue("project");
39: 
40:     return project
41:       ? `You are building ${project}.`
