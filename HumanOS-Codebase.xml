541: /*
542: |--------------------------------------------------------------------------
543: | Query API
544: |--------------------------------------------------------------------------
545: */
546: 
547: export function getAllPlans(): Plan[] {
548:   return db
549:     .select()
550:     .from(plans)
551:     .all()
552:     .map(
553:       deserializePlan
554:     );
555: }
556: 
557: export function getPlan(
558:   id: string
559: ): Plan | undefined {
560:   const row =
561:     db
562:       .select()
563:       .from(plans)
564:       .where(
565:         eq(
566:           plans.id,
567:           id
568:         )
569:       )
570:       .get();
571: 
572:   if (!row) {
573:     return undefined;
574:   }
575: 
576:   return deserializePlan(
577:     row
578:   );
579: }
580: 
581: export function findRelevantActivePlan(
582:   message: string
583: ): Plan | undefined {
584:   const terms =
585:     goalTerms(
586:       message
587:     );
588: 
589:   if (
590:     terms.length === 0
591:   ) {
592:     return undefined;
593:   }
594: 
595:   const activePlans =
596:     getAllPlans().filter(
597:       (plan) =>
598:         plan.status ===
599:         "active"
600:     );
601: 
602:   let bestPlan:
603:     Plan | undefined;
604: 
605:   let bestScore = 0;
606: 
607:   for (
608:     const plan of activePlans
609:   ) {
610:     const planText =
611:       normalize(
612:         [
613:           plan.title,
614:           plan.goal,
615:           plan.description,
616:           plan.nextAction,
617:           ...plan.milestones,
618:         ].join(" ")
619:       );
620: 
621:     const score =
622:       terms.filter(
623:         (term) =>
624:           planText.includes(
625:             term
626:           )
627:       ).length;
628: 
629:     if (
630:       score > bestScore
631:     ) {
632:       bestScore =
633:         score;
634: 
635:       bestPlan =
636:         plan;
637:     }
638:   }
639: 
640:   return bestPlan;
641: }
642: 
643: /*
644: |--------------------------------------------------------------------------
645: | Mutation API
646: |--------------------------------------------------------------------------
647: */
648: 
649: export function createPlanFromMessage(
650:   message: string
651: ): Plan | null {
652:   return createPlanFromMessageWithContext(
653:     message
654:   );
655: }
656: 
657: export function createPlanFromMessageWithContext(
658:   message: string,
659:   context: PlanningContext = {}
660: ): Plan | null {
661:   const goal =
662:     extractGoal(
663:       message
664:     );
665: 
666:   if (!goal) {
667:     return null;
668:   }
669: 
670:   const plan =
671:     generatePlan(
672:       goal
673:     );
674: 
675:   const graphObservations =
676:     context.graphObservations
677:       ?.filter(
678:         (observation) =>
679:           observation.trim().length > 0
680:       )
681:       .slice(
682:         0,
683:         3
684:       ) ?? [];
685: 
686:   if (
687:     graphObservations.length > 0
688:   ) {
689:     const graphMilestone =
690:       "Use relevant knowledge graph relationships to guide execution.";
691: 
692:     if (
693:       !plan.milestones.includes(
694:         graphMilestone
695:       )
696:     ) {
697:       plan.milestones = [
698:         graphMilestone,
699:         ...plan.milestones,
700:       ];
701:     }
702: 
703:     plan.description =
704:       [
705:         plan.description,
706: 
707:         "Graph context:",
708: 
709:         ...graphObservations.map(
710:           (observation) =>
711:             `- ${observation}`
712:         ),
713:       ].join(
714:         "\n"
715:       );
716: 
717:     plan.nextAction =
718:       graphMilestone;
719:   }
720: 
721:   savePlan(
722:     plan
723:   );
724: 
725:   return plan;
726: }
727: 
728: export function savePlan(
729:   plan: Plan
730: ): void {
731:   const updatedPlan: Plan = {
732:     ...plan,
733: 
734:     updatedAt:
735:       new Date(),
736:   };
737: 
738:   const row =
739:     serializePlan(
740:       updatedPlan
741:     );
742: 
743:   db
744:     .insert(plans)
745:     .values(row)
746:     .onConflictDoUpdate({
747:       target:
748:         plans.id,
749: 
750:       set: {
751:         title:
752:           row.title,
753: 
754:         goal:
755:           row.goal,
756: 
757:         description:
758:           row.description,
759: 
760:         status:
761:           row.status,
762: 
763:         milestones:
764:           row.milestones,
765: 
766:         completedMilestones:
767:           row.completedMilestones,
768: 
769:         nextAction:
770:           row.nextAction,
771: 
772:         priority:
773:           row.priority,
774: 
775:         confidence:
776:           row.confidence,
777: 
778:         updatedAt:
779:           row.updatedAt,
780:       },
781:     })
782:     .run();
783: }
784: 
785: export function updatePlan(
786:   plan: Plan
787: ): void {
788:   savePlan(
789:     plan
790:   );
791: }
792: 
793: export function deletePlan(
794:   id: string
795: ): void {
796:   db
797:     .delete(
798:       plans
799:     )
800:     .where(
801:       eq(
802:         plans.id,
803:         id
804:       )
805:     )
806:     .run();
807: }
808: 
809: export function clearPlans(): void {
810:   db
811:     .delete(
812:       plans
813:     )
814:     .run();
815: }
816: 
817: /*
818: |--------------------------------------------------------------------------
819: | Planning Operations
820: |--------------------------------------------------------------------------
821: */
822: 
823: export function completePlanMilestone(
824:   planId: string,
825:   milestone: string
826: ): Plan | null {
827:   const plan =
828:     getPlan(
829:       planId
830:     );
831: 
832:   if (!plan) {
833:     return null;
834:   }
835: 
836:   const updated =
837:     completeMilestone(
838:       plan,
839:       milestone
840:     );
841: 
842:   savePlan(
843:     updated
844:   );
845: 
846:   return updated;
847: }
</file>

<file path="frontend/brain/intent/detector.ts">
  1: import { Intent } from "./types";
  2: 
