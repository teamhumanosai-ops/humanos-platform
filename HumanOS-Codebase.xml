 1: import { ArtifactType } from "../models";
 2: 
 3: const EXTENSIONS: Record<string, ArtifactType> = {
 4:     pdf: ArtifactType.PDF,
 5: 
 6:     docx: ArtifactType.DOCX,
 7: 
 8:     txt: ArtifactType.TXT,
 9: 
10:     md: ArtifactType.MARKDOWN,
11: 
12:     png: ArtifactType.PNG,
13: 
14:     jpg: ArtifactType.JPG,
