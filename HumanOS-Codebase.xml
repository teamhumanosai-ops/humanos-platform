320: export function detectIntent(
321:   message: string
322: ): Intent {
323:   const text =
324:     message
325:       .trim()
326:       .toLowerCase()
327:       .replace(
328:         /\s+/g,
329:         " "
330:       );
331: 
332:   if (!text) {
333:     return Intent.GENERAL_CHAT;
334:   }
335: 
336:   /*
337:   |--------------------------------------------------------------------------
338:   | Notes
339:   |--------------------------------------------------------------------------
340:   |
341:   | Notes always win over task language inside the note content.
342:   |
343:   | Example:
344:   |
345:   | "Save note: Finish the planner today"
346:   |
347:   | must remain NOTE_TAKING.
348:   |
349:   */
350: 
351:   if (
352:     includesAny(
353:       text,
354:       NOTE_TERMS
355:     ) ||
356:     text.includes("note")
357:   ) {
358:     return Intent.NOTE_TAKING;
359:   }
360: 
361:   /*
362:   |--------------------------------------------------------------------------
363:   | Calendar
364:   |--------------------------------------------------------------------------
365:   */
366: 
367:   if (
368:     includesAny(
369:       text,
370:       CALENDAR_TERMS
371:     )
372:   ) {
373:     return Intent.CALENDAR;
374:   }
375: 
376:   /*
377:   |--------------------------------------------------------------------------
378:   | Startup Planning
379:   |--------------------------------------------------------------------------
380:   */
381: 
382:   if (
383:     text.includes(
384:       "plan my startup"
385:     ) ||
386:     text.includes(
387:       "startup"
388:     ) ||
389:     text.includes(
390:       "start a business"
391:     ) ||
392:     text.includes(
393:       "business idea"
394:     ) ||
395:     text.includes(
396:       "business plan"
397:     )
398:   ) {
399:     return Intent.STARTUP_PLANNING;
400:   }
401: 
402:   /*
403:   |--------------------------------------------------------------------------
404:   | Explicit planning requests
405:   |--------------------------------------------------------------------------
406:   |
407:   | Planning intent is evaluated before broad live-information
408:   | words such as "today" or "current".
409:   |
410:   */
411: 
412:   if (
413:     isExplicitPlanningRequest(
414:       text
415:     )
416:   ) {
417:     return Intent.PLANNING;
418:   }
419: 
420:   /*
421:   |--------------------------------------------------------------------------
422:   | Actionable task requests
423:   |--------------------------------------------------------------------------
424:   |
425:   | This is deliberately before broad live-information context.
426:   |
427:   | Therefore:
428:   |
429:   | "Review my finances today"
430:   |
431:   | becomes TASK_MANAGEMENT rather than LIVE_SEARCH.
432:   |
433:   */
434: 
435:   if (
436:     isActionableTaskRequest(
437:       text
438:     )
439:   ) {
440:     return Intent.TASK_MANAGEMENT;
441:   }
442: 
443:   /*
444:   |--------------------------------------------------------------------------
445:   | Explicit live-information questions
446:   |--------------------------------------------------------------------------
447:   |
448:   | Strong live questions still become LIVE_SEARCH even when
449:   | they contain action-like words elsewhere in the sentence.
450:   |
451:   */
452: 
453:   if (
454:     isExplicitLiveQuestion(
455:       text
456:     )
457:   ) {
458:     return Intent.LIVE_SEARCH;
459:   }
460: 
461:   /*
462:   |--------------------------------------------------------------------------
463:   | Broad live-information context
464:   |--------------------------------------------------------------------------
465:   |
466:   | Only reach this layer when no stronger action/planning intent
467:   | has already been detected.
468:   |
469:   */
470: 
471:   if (
472:     containsLiveContext(
473:       text
474:     )
475:   ) {
476:     return Intent.LIVE_SEARCH;
477:   }
478: 
479:   /*
480:   |--------------------------------------------------------------------------
481:   | Documents
482:   |--------------------------------------------------------------------------
483:   */
484: 
485:   if (
486:     includesAny(
487:       text,
488:       DOCUMENT_TERMS
489:     )
490:   ) {
491:     return Intent.DOCUMENT;
492:   }
493: 
494:   /*
495:   |--------------------------------------------------------------------------
496:   | Learning
497:   |--------------------------------------------------------------------------
498:   */
499: 
500:   if (
501:     includesAny(
502:       text,
503:       LEARNING_TERMS
504:     )
505:   ) {
506:     return Intent.LEARNING;
507:   }
508: 
509:   return Intent.GENERAL_CHAT;
510: }
