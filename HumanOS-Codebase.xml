<file path="frontend/brain/prediction/engine.ts">
  1: import type {
  2:   BrainState,
  3: } from "../brainState";
  4: 
  5: import type {
  6:   Prediction,
  7:   PredictionEvidence,
  8:   PredictionKind,
  9: } from "./types";
 10: 
 11: function normalize(
 12:   value: string
 13: ): string {
 14:   return value
 15:     .trim()
 16:     .toLowerCase();
 17: }
 18: 
 19: function createPredictionId(
 20:   statement: string
 21: ): string {
 22:   return `prediction-${normalize(
 23:     statement
 24:   )
 25:     .replace(
 26:       /[^a-z0-9]+/g,
 27:       "-"
 28:     )
 29:     .replace(
 30:       /^-|-$/g,
 31:       ""
 32:     )}`;
 33: }
 34: 
 35: function buildEvidence(
 36:   state: BrainState
 37: ): PredictionEvidence[] {
 38:   const evidence:
 39:     PredictionEvidence[] =
 40:     [];
 41: 
 42:   for (
 43:     const event of
 44:     state.timeline
 45:   ) {
 46:     if (
 47:       event.trim()
 48:     ) {
 49:       evidence.push({
 50:         source:
 51:           "timeline",
 52: 
 53:         statement:
 54:           event,
 55: 
 56:         confidence:
 57:           0.8,
 58:       });
 59:     }
 60:   }
 61: 
 62:   for (
 63:     const memory of
 64:     state.memories
 65:   ) {
 66:     if (
 67:       memory.value.trim()
 68:     ) {
 69:       evidence.push({
 70:         source:
 71:           "memory",
 72: 
 73:         statement:
 74:           memory.value,
 75: 
 76:         confidence:
 77:           0.75,
 78:       });
 79:     }
 80:   }
 81: 
 82:   for (
 83:     const node of
 84:     state.graph
 85:   ) {
 86:     evidence.push({
 87:       source:
 88:         "graph",
 89: 
 90:       statement:
 91:         `Graph entity: ${node.label}.`,
 92: 
 93:       confidence:
 94:         0.7,
 95:     });
 96:   }
 97: 
 98:   for (
 99:     const reflection of
100:     state.reflections
101:   ) {
102:     if (
103:       reflection.trim()
104:     ) {
105:       evidence.push({
106:         source:
107:           "reflection",
108: 
109:         statement:
110:           reflection,
111: 
112:         confidence:
113:           0.8,
114:       });
115:     }
116:   }
117: 
118:   return evidence;
119: }
120: 
121: function classifyPrediction(
122:   statement: string
123: ): PredictionKind {
124:   const text =
125:     normalize(
126:       statement
127:     );
128: 
129:   if (
130:     text.includes(
131:       "deadline"
132:     ) ||
133:     text.includes(
134:       "due"
135:     ) ||
136:     text.includes(
137:       "renew"
138:     )
139:   ) {
140:     return "likely_deadline";
141:   }
142: 
143:   if (
144:     text.includes(
145:       "every"
146:     ) ||
147:     text.includes(
148:       "usually"
149:     ) ||
150:     text.includes(
151:       "often"
152:     ) ||
153:     text.includes(
154:       "recurring"
155:     )
156:   ) {
157:     return "recurring_behavior";
158:   }
159: 
160:   if (
161:     text.includes(
162:       "need"
163:     ) ||
164:     text.includes(
165:       "requires"
166:     ) ||
167:     text.includes(
168:       "missing"
169:     )
170:   ) {
171:     return "likely_need";
172:   }
173: 
174:   return "upcoming_task";
175: }
176: 
177: function createCandidatePredictions(
178:   state: BrainState
179: ): Prediction[] {
180:   const evidence =
181:     buildEvidence(
182:       state
183:     );
184: 
185:   if (
186:     evidence.length === 0
187:   ) {
188:     return [];
189:   }
190: 
191:   const predictions:
192:     Prediction[] =
193:     [];
194: 
195:   const timelineEvidence =
196:     evidence.filter(
197:       (
198:         item
199:       ) =>
200:         item.source ===
201:         "timeline"
202:     );
203: 
204:   for (
205:     const item of
206:     timelineEvidence.slice(
207:       0,
208:       3
209:     )
210:   ) {
211:     const statement =
212:       `A future action or event may be associated with: ${item.statement}`;
213: 
214:     predictions.push({
215:       id:
216:         createPredictionId(
217:           statement
218:         ),
219: 
220:       kind:
221:         classifyPrediction(
222:           statement
223:         ),
224: 
225:       statement,
226: 
227:       confidence:
228:         item.confidence,
229: 
230:       evidence: [
231:         item,
232:       ],
233: 
234:       createdAt:
235:         new Date(),
236:     });
237:   }
238: 
239:   const reflectionEvidence =
240:     evidence.filter(
241:       (
242:         item
243:       ) =>
244:         item.source ===
245:         "reflection"
246:     );
247: 
248:   for (
249:     const item of
250:     reflectionEvidence.slice(
251:       0,
252:       2
253:     )
254:   ) {
255:     const statement =
256:       `A previously observed pattern may continue: ${item.statement}`;
257: 
258:     predictions.push({
259:       id:
260:         createPredictionId(
261:           statement
262:         ),
263: 
264:       kind:
265:         "recurring_behavior",
266: 
267:       statement,
268: 
269:       confidence:
270:         item.confidence,
271: 
272:       evidence: [
273:         item,
274:       ],
275: 
276:       createdAt:
277:         new Date(),
278:     });
279:   }
280: 
281:   return predictions;
282: }
