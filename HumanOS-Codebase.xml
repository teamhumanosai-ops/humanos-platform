<file path="frontend/brain/intent/detector.ts">
import { Intent } from "./types";

function containsAny(
  text: string,
  phrases: string[]
): boolean {
  return phrases.some(
    (phrase) =>
      text.includes(phrase)
  );
}

function containsYear(
  text: string
): boolean {
  return /\b20\d{2}\b/.test(text);
}

function asksForCurrentRole(
  text: string
): boolean {
  const rolePhrases = [
    "ceo",
    "chief executive officer",
    "president",
    "prime minister",
    "chancellor",
    "chairman",
    "chairwoman",
    "chairperson",
    "founder",
    "governor",
    "mayor",
    "director",
    "head of",
  ];

  const questionPhrases = [
    "who is",
    "who's",
    "who currently",
    "who is currently",
    "who was appointed",
    "who became",
    "who took over",
  ];

  return (
    containsAny(
      text,
      questionPhrases
    ) &&
    containsAny(
      text,
      rolePhrases
    )
  );
}

function asksForCurrentState(
  text: string
): boolean {
  const currentStatePhrases = [
    "as of",
    "currently",
    "at the moment",
    "right now",
    "as of now",
    "what is the current",
    "what's the current",
    "what are the current",
    "what's currently",
    "what is currently",
    "how much is",
    "how many are",
  ];

  return containsAny(
    text,
    currentStatePhrases
  );
}

export function detectIntent(
  message: string
): Intent {
  const text =
    message
      .toLowerCase()
      .trim();

  if (
    text.includes(
      "plan my startup"
    ) ||
    text.includes(
      "startup"
    )
  ) {
    return Intent.STARTUP_PLANNING;
  }

  /*
   * Live information indicators.
   *
   * These intentionally include event/result
   * questions such as:
   *
   * - Who won FIFA 2026?
   * - Who won IPL 2026?
   * - What is today's score?
   * - What are the latest OpenAI updates?
   */

  const liveIndicators = [
    "today",
    "latest",
    "current",
    "right now",
    "just now",
    "recent",
    "recently",
    "this week",
    "this month",
    "this year",
    "yesterday",
    "news",
    "update",
    "updates",
    "breaking",
    "live",
    "who won",
    "who is the winner",
    "winner of",
    "champion of",
    "champions of",
    "final result",
    "results",
    "result",
    "score",
    "scores",
    "standings",
    "table",
    "fixture",
    "fixtures",
    "schedule",
    "released",
    "release date",
    "launched",
    "price",
    "pricing",
    "stock price",
    "share price",
    "market",
    "weather",
    "forecast",
    "election",
    "elections",
  ];

  const liveEntities = [
    "fifa",
    "world cup",
    "ipl",
    "indian premier league",
    "cricket",
    "nfl",
    "nba",
    "nhl",
    "premier league",
    "uefa",
    "formula 1",
    "f1",
    "openai",
    "anthropic",
    "google ai",
    "gemini",
    "nvidia",
    "bitcoin",
    "ethereum",
    "crypto",
  ];

  const asksForLiveInformation =
    containsAny(
      text,
      liveIndicators
    );

  const containsLiveEntity =
    containsAny(
      text,
      liveEntities
    );

  /*
   * Explicit temporal language always has
   * priority over general conversation.
   */

  if (
    asksForLiveInformation ||
    asksForCurrentRole(text) ||
    asksForCurrentState(text) ||
    (
      containsLiveEntity &&
      containsYear(text)
    )
  ) {
    return Intent.LIVE_SEARCH;
  }

  if (
    text.includes("task")
  ) {
    return Intent.TASK_MANAGEMENT;
  }

  if (
    text.includes("note")
  ) {
    return Intent.NOTE_TAKING;
  }

  if (
    text.includes("calendar") ||
    text.includes("meeting")
  ) {
    return Intent.CALENDAR;
  }

  if (
    text.includes("pdf") ||
    text.includes("document")
  ) {
    return Intent.DOCUMENT;
  }

  if (
    text.includes("explain") ||
    text.includes("learn")
  ) {
    return Intent.LEARNING;
  }

  return Intent.GENERAL_CHAT;
}
</file>

