<file path="frontend/brain/progressTracker.ts">
 1: import { Plan } from "./planning";
 2: 
 3: export function completeMilestone(
 4:   plan: Plan,
 5:   milestone: string
 6: ): Plan {
 7:   if (
 8:     !plan.milestones.includes(milestone) ||
 9:     plan.completedMilestones.includes(milestone)
10:   ) {
11:     return plan;
12:   }
13: 
14:   const completedMilestones = [
15:     ...plan.completedMilestones,
16:     milestone,
17:   ];
18: 
19:   const remaining = plan.milestones.filter(
20:     (m) => !completedMilestones.includes(m)
21:   );
22: 
23:   return {
24:     ...plan,
25: 
26:     completedMilestones,
27: 
28:     nextAction:
29:       remaining[0] ?? "Plan Complete",
30: 
31:     status:
32:       remaining.length === 0
33:         ? "completed"
34:         : "active",
35: 
36:     updatedAt: new Date(),
37:   };
38: }
39: 
40: export function getProgress(
41:   plan: Plan
42: ): number {
43:   if (plan.milestones.length === 0) {
44:     return 100;
45:   }
46: 
47:   return Math.round(
48:     (plan.completedMilestones.length /
49:       plan.milestones.length) *
50:       100
51:   );
52: }
</file>

