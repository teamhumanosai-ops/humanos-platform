 49: export class GraphBuilder {
 50:   addMemory(
 51:     id: string,
 52:     label: string,
 53:     properties: Record<string, unknown> = {}
 54:   ): GraphNode {
 55:     const node = createNode(
 56:       id,
 57:       "memory",
 58:       label,
 59:       properties
 60:     );
 61: 
 62:     if (!graphStore.hasNode(id)) {
 63:       graphStore.addNode(node);
 64:     }
 65: 
 66:     return node;
 67:   }
 68: 
 69:   addTimelineEvent(
 70:     id: string,
 71:     label: string,
 72:     properties: Record<string, unknown> = {}
 73:   ): GraphNode {
 74:     const node = createNode(
 75:       id,
 76:       "timeline",
