 62:       {
 63:         source:
 64:           "timeline",
 65: 
 66:         category:
 67:           event.category,
 68:       }
 69:     );
 70: 
 71:     graphBuilder.connect(
 72:       timelineId,
 73:       categoryId,
 74:       "belongs_to",
 75:       event.confidence,
 76:       {
 77:         source:
 78:           "timeline",
 79: 
 80:         relationship:
 81:           "category",
 82:       }
 83:     );
 84:   }
 85: }
