<file path="frontend/brain/router/intent.ts">
 1: export enum Intent {
 2:   CHAT = "chat",
 3: 
 4:   MEMORY = "memory",
 5: 
 6:   TASK = "task",
 7: 
 8:   CALENDAR = "calendar",
 9: 
10:   NOTE = "note",
11: 
12:   SETTINGS = "settings",
13: 
14:   UNKNOWN = "unknown",
15: }
16: 
17: export function detectIntent(message: string): Intent {
18:   const text = message.toLowerCase();
19: 
20:   // Memory
21: 
22:   if (
23:     text.includes("remember") ||
24:     text.includes("my name") ||
25:     text.includes("i live") ||
26:     text.includes("my favorite") ||
27:     text.includes("my favourite") ||
28:     text.includes("birthday")
29:   ) {
30:     return Intent.MEMORY;
31:   }
32: 
33:   // Calendar
34: 
35:   if (
36:     text.includes("meeting") ||
37:     text.includes("calendar") ||
38:     text.includes("schedule") ||
39:     text.includes("appointment") ||
40:     text.includes("tomorrow") ||
41:     text.includes("next week")
42:   ) {
43:     return Intent.CALENDAR;
44:   }
45: 
46:   // Tasks
47: 
48:   if (
49:     text.includes("task") ||
50:     text.includes("todo") ||
51:     text.includes("buy") ||
52:     text.includes("remind") ||
53:     text.includes("finish")
54:   ) {
55:     return Intent.TASK;
56:   }
57: 
58:   // Notes
59: 
60:   if (
61:     text.includes("note") ||
62:     text.includes("write this down") ||
63:     text.includes("save this")
64:   ) {
65:     return Intent.NOTE;
66:   }
67: 
68:   // Settings
69: 
70:   if (
71:     text.includes("theme") ||
72:     text.includes("settings")
73:   ) {
74:     return Intent.SETTINGS;
75:   }
76: 
77:   return Intent.CHAT;
78: }
</file>

