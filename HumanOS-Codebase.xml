66:                   </span>
67:                 </div>
68: 
69:                 <p className="mt-2 text-zinc-300">
70:                   {memory.value}
71:                 </p>
72: 
73:                 <p className="mt-2 text-xs text-zinc-500">
74:                   Updated:{" "}
75:                   {new Date(
76:                     memory.updatedAt
77:                   ).toLocaleString()}
78:                 </p>
79:               </div>
80:             ))}
81:           </div>
82:         )}
83:       </div>
84:     </AppPage>
85:   );
86: }
