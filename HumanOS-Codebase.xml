export type CitationSource = {
  index: number;
  title: string;
  url: string;
  domain: string;
  publishedDate?: string;
};

function extractDomain(
  url: string
): string {
  try {
    return new URL(url)
      .hostname
      .replace(/^www\./, "");
  } catch {
    return url;
  }
}

export function buildCitationSources(
  results: Array<{
    title: string;
    url: string;
    publishedDate?: string;
  }>
): CitationSource[] {
  return results.map(
    (result, index) => ({
      index: index + 1,
      title: result.title,
      url: result.url,
      domain:
        extractDomain(result.url),
      publishedDate:
        result.publishedDate,
    })
  );
}
</file>

<file path="frontend/brain/actionEvaluator.ts">
import {
  Plan,
} from "./planning";

import {
  calculateConfidence,
} from "./confidenceScorer";

export type ActionEvaluation = {
  action: string;

  score: number;

  reason: string;
};

function hasGraphContext(
  plan: Plan
): boolean {
  return (
    plan.description
      .toLowerCase()
      .includes(
        "graph context:"
      ) ||
    plan.description
      .toLowerCase()
      .includes(
        "knowledge graph context"
      )
  );
}

function calculateGraphBonus(
  plan: Plan,
  action: string
): number {
  if (
    !hasGraphContext(
      plan
    )
  ) {
    return 0;
  }

  /*
  |--------------------------------------------------------------------------
  | The graph context currently reaches the
  | Decision Engine through the Plan produced
  | by PlanningStage.
  |
  | The immediate next action is the action
  | most directly associated with the current
  | graph-aware plan.
  |--------------------------------------------------------------------------
  */

  if (
    action ===
    plan.nextAction
  ) {
    return 10;
  }

  return 0;
}

export function evaluateActions(
  plan: Plan
): ActionEvaluation[] {
  const graphAware =
    hasGraphContext(
      plan
    );

  return plan.milestones.map(
    (
      milestone
    ) => {
      const completed =
        plan.completedMilestones.includes(
          milestone
        );

      if (
        completed
      ) {
        return {
          action:
            milestone,

          score:
            0,

          reason:
            "Already completed",
        };
      }

      const baseScore =
        calculateConfidence(
          plan,
          milestone
        );

      const graphBonus =
        calculateGraphBonus(
          plan,
          milestone
        );

      const score =
        Math.min(
          baseScore +
            graphBonus,
          100
        );

      const reasons =
        [
          milestone ===
          plan.nextAction
            ? "Highest confidence based on current plan progress"
            : "Valid future milestone",

          graphAware &&
          graphBonus > 0
            ? "Supported by available knowledge graph context"
            : null,
        ].filter(
          (
            value
          ): value is string =>
            Boolean(value)
        );

      return {
        action:
          milestone,

        score,

        reason:
          reasons.join(
            "; "
          ),
      };
    }
  );
}
</file>

