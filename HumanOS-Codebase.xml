  1: import { BaseStage } from "./baseStage";
  2: 
  3: import {
  4:   BrainState,
  5: } from "../../brainState";
  6: 
  7: import {
  8:   graphQuery,
  9: } from "../../graph";
 10: 
 11: import {
 12:   retrieveKnowledgeResults,
 13: } from "../../knowledge";
 14: 
 15: import {
 16:   profileEngine,
 17: } from "../../profile/profileEngine";
 18: 
 19: import {
 20:   buildTimelinePrompt,
 21: } from "../../timeline";
 22: 
 23: import {
 24:   buildReflectionPrompt,
 25: } from "../../reflection";
 26: 
 27: import {
 28:   enrichmentEngine,
 29: } from "../../enrichment";
 30: 
 31: const MAX_GRAPH_NODES = 20;
 32: 
 33: const MIN_QUERY_TOKEN_LENGTH = 3;
 34: 
 35: const DIRECT_MATCH_SCORE = 3;
 36: 
 37: const PARTIAL_MATCH_SCORE = 1;
 38: 
 39: const RELATED_NODE_SCORE_FACTOR = 0.5;
 40: 
 41: const FALLBACK_NODE_SCORE_FACTOR = 0.1;
 42: 
 43: function getQueryTokens(
 44:   message: string
 45: ): string[] {
 46:   return [
 47:     ...new Set(
 48:       message
 49:         .toLowerCase()
 50:         .replace(
 51:           /[^a-z0-9\s-_]/g,
 52:           " "
 53:         )
 54:         .split(/\s+/)
 55:         .map(
 56:           (token) =>
 57:             token.trim()
 58:         )
 59:         .filter(
 60:           (token) =>
 61:             token.length >=
 62:             MIN_QUERY_TOKEN_LENGTH
 63:         )
 64:     ),
 65:   ];
 66: }
 67: 
 68: function getNodeMatchScore(
 69:   node: BrainState["graph"][number],
 70:   tokens: string[]
 71: ): number {
 72:   const id =
 73:     node.id.toLowerCase();
 74: 
 75:   const label =
 76:     node.label.toLowerCase();
 77: 
 78:   return tokens.reduce(
 79:     (
 80:       score,
 81:       token
 82:     ) => {
 83:       if (
 84:         id === token ||
 85:         label === token
 86:       ) {
 87:         return (
 88:           score +
 89:           DIRECT_MATCH_SCORE
 90:         );
 91:       }
 92: 
 93:       if (
 94:         id.includes(token) ||
 95:         label.includes(token)
 96:       ) {
 97:         return (
 98:           score +
 99:           PARTIAL_MATCH_SCORE
100:         );
101:       }
102: 
103:       return score;
104:     },
105:     0
106:   );
107: }
108: 
109: function hydrateRelevantGraph(
110:   userMessage: string
111: ): {
112:   nodes: BrainState["graph"];
113:   edges: BrainState["graphEdges"];
114: } {
115:   const matchedNodes =
116:     new Map<
117:       string,
118:       BrainState["graph"][number]
119:     >();
120: 
121:   const nodeScores =
122:     new Map<
123:       string,
124:       number
125:     >();
126: 
127:   const tokens =
128:     getQueryTokens(
129:       userMessage
130:     );
131: 
132:   /*
133:   |--------------------------------------------------------------------------
134:   | Direct graph matches
135:   |--------------------------------------------------------------------------
136:   |
137:   | Direct matches receive the strongest relevance
138:   | score because the node itself matches terminology
139:   | from the current request.
140:   |
141:   */
142: 
143:   for (
144:     const token of tokens
145:   ) {
146:     for (
147:       const node of
148:       graphQuery.search(token)
149:     ) {
150:       matchedNodes.set(
151:         node.id,
152:         node
153:       );
154: 
155:       const score =
156:         getNodeMatchScore(
157:           node,
158:           tokens
159:         );
160: 
161:       nodeScores.set(
162:         node.id,
163:         Math.max(
164:           nodeScores.get(
165:             node.id
166:           ) ?? 0,
167:           score
168:         )
169:       );
170:     }
171:   }
172: 
173:   /*
174:   |--------------------------------------------------------------------------
175:   | Relationship expansion
176:   |--------------------------------------------------------------------------
177:   |
178:   | Related nodes inherit relevance from their matched
179:   | seed nodes. Existing relationship weights strengthen
180:   | or weaken that inherited relevance.
181:   |
182:   */
183: 
184:   const seedNodes = [
185:     ...matchedNodes.values(),
186:   ];
187: 
188:   for (
189:     const node of seedNodes
190:   ) {
191:     const seedScore =
192:       nodeScores.get(
193:         node.id
194:       ) ?? 0;
195: 
196:     const relationships =
197:       graphQuery.getRelationships(
198:         node.id
199:       );
200: 
201:     for (
202:       const edge of
203:       relationships
204:     ) {
205:       const relatedId =
206:         edge.from === node.id
207:           ? edge.to
208:           : edge.from;
209: 
210:       const relatedNode =
211:         graphQuery.getNode(
212:           relatedId
213:         );
214: 
215:       if (
216:         !relatedNode
217:       ) {
218:         continue;
219:       }
220: 
221:       matchedNodes.set(
222:         relatedNode.id,
223:         relatedNode
224:       );
225: 
226:       const relationshipWeight =
227:         Math.max(
228:           0,
229:           edge.weight
230:         );
231: 
232:       const inheritedScore =
233:         seedScore *
234:         relationshipWeight *
235:         RELATED_NODE_SCORE_FACTOR;
236: 
237:       nodeScores.set(
238:         relatedNode.id,
239:         Math.max(
240:           nodeScores.get(
241:             relatedNode.id
242:           ) ?? 0,
243:           inheritedScore
244:         )
245:       );
246:     }
247:   }
248: 
249:   /*
250:   |--------------------------------------------------------------------------
251:   | Empty-match fallback
252:   |--------------------------------------------------------------------------
253:   |
254:   | General conversation should still have access
255:   | to graph context when no direct entity match
256:   | exists.
257:   |
258:   | Instead of taking arbitrary insertion-order nodes,
259:   | rank fallback nodes by their weighted graph
260:   | connectivity so highly connected knowledge has
261:   | a better chance of entering BrainState.
262:   |
263:   */
264: 
265:   if (
266:     matchedNodes.size === 0
267:   ) {
268:     const fallbackScores =
269:       new Map<
270:         string,
271:         number
272:       >();
273: 
274:     for (
275:       const edge of
276:       graphQuery.getEdges()
277:     ) {
278:       const weight =
279:         Math.max(
280:           0,
281:           edge.weight
282:         );
283: 
284:       fallbackScores.set(
285:         edge.from,
286:         (
287:           fallbackScores.get(
288:             edge.from
289:           ) ?? 0
290:         ) +
291:           weight
292:       );
293: 
294:       fallbackScores.set(
295:         edge.to,
296:         (
297:           fallbackScores.get(
298:             edge.to
299:           ) ?? 0
300:         ) +
301:           weight
302:       );
303:     }
304: 
305:     const fallbackNodes =
306:       graphQuery
307:         .getNodes()
308:         .sort(
309:           (
310:             left,
311:             right
312:           ) => {
313:             const rightScore =
314:               fallbackScores.get(
315:                 right.id
316:               ) ?? 0;
317: 
318:             const leftScore =
319:               fallbackScores.get(
320:                 left.id
321:               ) ?? 0;
322: 
323:             return (
324:               rightScore -
325:               leftScore
326:             );
327:           }
328:         )
329:         .slice(
330:           0,
331:           MAX_GRAPH_NODES
332:         );
333: 
334:     for (
335:       const node of
336:       fallbackNodes
337:     ) {
338:       matchedNodes.set(
339:         node.id,
340:         node
341:       );
342: 
343:       nodeScores.set(
344:         node.id,
345:         (
346:           fallbackScores.get(
347:             node.id
348:           ) ?? 0
349:         ) *
350:           FALLBACK_NODE_SCORE_FACTOR
351:       );
352:     }
353:   }
354: 
355:   /*
356:   |--------------------------------------------------------------------------
357:   | Relevance ranking
358:   |--------------------------------------------------------------------------
359:   |
360:   | Direct matches and strongly connected related nodes
361:   | are now ordered before weaker graph context.
362:   |
363:   */
364: 
365:   const nodes =
366:     [
367:       ...matchedNodes.values(),
368:     ]
369:       .sort(
370:         (
371:           left,
372:           right
373:         ) => {
374:           const rightScore =
375:             nodeScores.get(
376:               right.id
377:             ) ?? 0;
378: 
379:           const leftScore =
380:             nodeScores.get(
381:               left.id
382:             ) ?? 0;
383: 
384:           if (
385:             rightScore !==
386:             leftScore
387:           ) {
388:             return (
389:               rightScore -
390:               leftScore
391:             );
392:           }
393: 
394:           return left.id.localeCompare(
395:             right.id
396:           );
397:         }
398:       )
399:       .slice(
400:         0,
401:         MAX_GRAPH_NODES
402:       );
403: 
404:   const nodeIds =
405:     new Set(
406:       nodes.map(
407:         (node) =>
408:           node.id
409:       )
410:     );
411: 
412:   /*
413:   |--------------------------------------------------------------------------
414:   | Relevant relationships
415:   |--------------------------------------------------------------------------
416:   |
417:   | Only relationships between retained nodes enter
418:   | BrainState. Stronger weighted relationships are
419:   | ordered first.
420:   |
421:   */
422: 
423:   const edges =
424:     graphQuery
425:       .getEdges()
426:       .filter(
427:         (edge) =>
428:           nodeIds.has(
429:             edge.from
430:           ) &&
431:           nodeIds.has(
432:             edge.to
433:           )
434:       )
435:       .sort(
436:         (
437:           left,
438:           right
439:         ) => {
440:           const rightWeight =
441:             Math.max(
442:               0,
443:               right.weight
444:             );
445: 
446:           const leftWeight =
447:             Math.max(
448:               0,
449:               left.weight
450:             );
451: 
452:           if (
453:             rightWeight !==
454:             leftWeight
455:           ) {
456:             return (
457:               rightWeight -
458:               leftWeight
459:             );
460:           }
461: 
462:           return left.id.localeCompare(
463:             right.id
464:           );
465:         }
466:       );
467: 
468:   return {
469:     nodes,
470:     edges,
471:   };
472: }
473: 
474: export class BrainStateStage
475:   extends BaseStage {
476:   readonly name =
477:     "BrainState";
478: 
479:   protected async process(
480:     state: BrainState
481:   ): Promise<BrainState> {
482:     /*
483:     |--------------------------------------------------------------------------
484:     | Knowledge Retrieval
485:     |--------------------------------------------------------------------------
486:     |
487:     | Knowledge retrieval remains responsible for
488:     | searching the knowledge base. BrainState stores
489:     | the structured retrieval results for downstream
490:     | cognitive stages.
491:     |
492:     */
493: 
494:     const knowledge =
495:       await retrieveKnowledgeResults(
496:         state.userMessage
497:       );
498: 
499:     state.knowledge =
500:       knowledge.map(
501:         (result) => ({
502:           source:
503:             result.source,
504: 
505:           text:
506:             result.text,
507: 
508:           score:
509:             result.score,
510:         })
511:       );
512: 
513:     /*
514:     |--------------------------------------------------------------------------
515:     | Reasoning Graph
516:     |--------------------------------------------------------------------------
517:     |
518:     | Hydrate graph information relevant to the current
519:     | request, rank it using direct matches and weighted
520:     | relationships, then retain the strongest context.
521:     |
522:     */
523: 
524:     const graphContext =
525:       hydrateRelevantGraph(
526:         state.userMessage
527:       );
528: 
529:     state.graph =
530:       graphContext.nodes;
531: 
532:     state.graphEdges =
533:       graphContext.edges;
534: 
535:     /*
536:     |--------------------------------------------------------------------------
537:     | Human Profile
538:     |--------------------------------------------------------------------------
539:     */
540: 
541:     state.profile =
542:       profileEngine.get();
543: 
544:     if (
545:       state.profile
546:     ) {
547:       const enrichmentSuggestion =
548:         enrichmentEngine.getNextQuestion(
549:           state.profile
550:         );
551: 
552:       console.debug(
553:         "[Human OS] Next enrichment:",
554:         enrichmentSuggestion
555:       );
556:     }
557: 
558:     /*
559:     |--------------------------------------------------------------------------
560:     | Timeline
561:     |--------------------------------------------------------------------------
562:     */
563: 
564:     const timeline =
565:       await buildTimelinePrompt();
566: 
567:     state.timeline =
568:       timeline
569:         .split("\n")
570:         .map(
571:           (line) =>
572:             line.trim()
573:         )
574:         .filter(Boolean);
575: 
576:     /*
577:     |--------------------------------------------------------------------------
578:     | Reflections
579:     |--------------------------------------------------------------------------
580:     */
581: 
582:     const reflections =
583:       await buildReflectionPrompt();
584: 
585:     state.reflections =
586:       reflections
587:         .split("\n")
588:         .map(
589:           (line) =>
590:             line.trim()
591:         )
592:         .filter(Boolean);
593: 
594:     return state;
595:   }
596: }
</file>

<file path="frontend/brain/runtime/steps/planningStage.ts">
  1: import {
  2:   BrainState,
  3: } from "../../brainState";
  4: 
  5: import {
  6:   Intent,
  7: } from "../../intent";
  8: 
  9: import {
 10:   createPlanFromMessage,
 11:   getAllPlans,
 12: } from "../../planning";
 13: 
 14: import {
 15:   BaseStage,
 16: } from "./baseStage";
 17: 
 18: /**
 19:  * PlanningStage
 20:  *
 21:  * Integrates the existing Planning Engine
 22:  * into the Cognitive Runtime.
 23:  *
 24:  * Responsibilities:
 25:  *
 26:  * - Handle explicit planning requests
 27:  * - Handle startup planning
 28:  * - Handle actionable task-management requests
 29:  * - Return persisted planning results for task queries
 30:  * - Prevent informational task queries from
 31:  *   falling through to an LLM-generated/fabricated
 32:  *   task list
 33:  *
 34:  * The Planning Engine remains responsible for:
 35:  *
 36:  * - Goal extraction
 37:  * - Plan generation
 38:  * - Plan storage
 39:  * - Plan retrieval
 40:  * - Plan updates
 41:  * - Plan deletion
 42:  * - Milestone completion
 43:  *
 44:  * BrainState remains the shared cognitive state.
 45:  */
 46: export class PlanningStage
 47:   extends BaseStage {
 48:   readonly name =
 49:     "Planning";
 50: 
 51:   protected async process(
 52:     state: BrainState
 53:   ): Promise<BrainState> {
 54:     if (
 55:       state.response
 56:     ) {
 57:       return state;
 58:     }
 59: 
 60:     const isPlanningRequest =
 61:       state.intent ===
 62:         Intent.STARTUP_PLANNING ||
 63:       state.intent ===
 64:         Intent.PLANNING;
 65: 
 66:     const isTaskRequest =
 67:       state.intent ===
 68:       Intent.TASK_MANAGEMENT;
 69: 
 70:     if (
 71:       !isPlanningRequest &&
 72:       !isTaskRequest
 73:     ) {
 74:       return state;
 75:     }
 76: 
 77:     /*
 78:     |--------------------------------------------------------------------------
 79:     | Informational task request
 80:     |--------------------------------------------------------------------------
 81:     |
 82:     | Examples:
 83:     |
 84:     | "Show me my tasks"
 85:     | "List my tasks"
 86:     | "What tasks do I have?"
 87:     |
 88:     | These requests must use the real Planning Engine
 89:     | instead of allowing the language model to invent
 90:     | a task list.
 91:     |
 92:     */
 93: 
 94:     if (
 95:       isTaskRequest &&
 96:       !this.hasActionableGoal(
 97:         state.userMessage
 98:       )
 99:     ) {
100:       return this.populateTaskListResponse(
101:         state
102:       );
103:     }
104: 
105:     /*
106:     |--------------------------------------------------------------------------
107:     | Create actual plan
108:     |--------------------------------------------------------------------------
109:     |
110:     | Planning and actionable task requests both use
111:     | exactly the same Planning Engine.
112:     |
113:     */
114: 
115:     const plan =
116:       createPlanFromMessage(
117:         state.userMessage
118:       );
119: 
120:     if (
121:       !plan
122:     ) {
123:       return state;
124:     }
125: 
126:     /*
127:     |--------------------------------------------------------------------------
128:     | BrainState synchronization
129:     |--------------------------------------------------------------------------
130:     */
131: 
132:     state.currentGoal =
133:       plan.goal;
134: 
135:     state.currentPlanId =
136:       plan.id;
137: 
138:     state.plan =
139:       this.formatPlan(
140:         plan
141:       );
142: 
143:     /*
144:     |--------------------------------------------------------------------------
145:     | Task-management response
146:     |--------------------------------------------------------------------------
147:     |
148:     | For actionable TASK_MANAGEMENT requests we
149:     | return the actual generated Plan instead of
150:     | allowing ResponseStage to replace it with
151:     | generic LLM conversation.
152:     |
153:     */
154: 
155:     if (
156:       isTaskRequest
157:     ) {
158:       state.response =
159:         [
160:           "Task added to your planner.",
161: 
162:           "",
163: 
164:           this.formatPlan(
165:             plan
166:           ),
167:         ].join(
168:           "\n"
169:         );
170:     }
171: 
172:     return state;
173:   }
174: 
175:   /*
176:   |--------------------------------------------------------------------------
177:   | Actionable goal detection
178:   |--------------------------------------------------------------------------
179:   |
180:   | This is intentionally broad because the Planning
181:   | Engine is generic and must support goals across
182:   | different life domains.
183:   |
184:   */
185: 
186:   private hasActionableGoal(
187:     message: string
188:   ): boolean {
189:     const text =
190:       message
191:         .trim()
192:         .toLowerCase();
193: 
194:     if (
195:       !text
196:     ) {
197:       return false;
198:     }
199: 
200:     const informationalPatterns = [
201:       /^show me\b/,
202:       /^show my\b/,
203:       /^list\b/,
204:       /^what are my\b/,
205:       /^what tasks do i have\b/,
206:       /^what do i need to do\b/,
207:       /^what should i do\b/,
208:     ];
209: 
210:     if (
211:       informationalPatterns.some(
212:         (
213:           pattern
214:         ) =>
215:           pattern.test(
216:             text
217:           )
218:       )
219:     ) {
220:       return false;
221:     }
222: 
223:     const actionablePatterns = [
224:       /\bi want to\b/,
225:       /\bi need to\b/,
226:       /\bhelp me\b/,
227:       /\bi'm trying to\b/,
228:       /\bim trying to\b/,
229:       /\bmy goal is\b/,
230:       /\bi would like to\b/,
231:       /\bi'd like to\b/,
232:       /\bi plan to\b/,
233:       /\bfinish\b/,
234:       /\bcomplete\b/,
235:       /\bbuy\b/,
236:       /\bprepare\b/,
237:       /\borganize\b/,
238:       /\borganise\b/,
239:       /\bhandle\b/,
240:       /\breview\b/,
241:       /\bupdate\b/,
242:       /\bfix\b/,
243:       /\bclean\b/,
244:       /\bcall\b/,
245:       /\bsend\b/,
246:       /\bpay\b/,
247:       /\bstudy\b/,
248:       /\blearn\b/,
249:       /\bpractice\b/,
250:       /\bresearch\b/,
251:       /\bwrite\b/,
252:       /\bread\b/,
253:       /\bimplement\b/,
254:       /\bbuild\b/,
255:       /\bcreate\b/,
256:       /\bdevelop\b/,
257:       /\blaunch\b/,
258:       /\binstall\b/,
259:       /\bset up\b/,
260:       /\bsetup\b/,
261:       /\bwork on\b/,
262:       /\bget\b/,
263:       /\bdo\b/,
264:     ];
265: 
266:     return actionablePatterns.some(
267:       (
268:         pattern
269:       ) =>
270:         pattern.test(
271:           text
272:         )
273:     );
274:   }
275: 
276:   /*
277:   |--------------------------------------------------------------------------
278:   | Real task list
279:   |--------------------------------------------------------------------------
280:   */
281: 
282:   private populateTaskListResponse(
283:     state: BrainState
284:   ): BrainState {
285:     const plans =
286:       getAllPlans();
287: 
288:     if (
289:       plans.length ===
290:       0
291:     ) {
292:       state.response =
293:         "You don't have any tasks in your planner yet.";
294: 
295:       return state;
296:     }
297: 
298:     const activePlans =
299:       plans.filter(
300:         (
301:           plan
302:         ) =>
303:           plan.status ===
304:           "active"
305:       );
306: 
307:     const visiblePlans =
308:       activePlans.length > 0
309:         ? activePlans
310:         : plans;
311: 
312:     state.response =
313:       [
314:         "Here are the tasks currently stored in your planner:",
315: 
316:         "",
317: 
318:         ...visiblePlans.map(
319:           (
320:             plan,
321:             index
322:           ) =>
323:             `${index + 1}. ${plan.goal} — Next action: ${plan.nextAction}`
324:         ),
325:       ].join(
326:         "\n"
327:       );
328: 
329:     return state;
330:   }
331: 
332:   /*
333:   |--------------------------------------------------------------------------
334:   | Plan formatting
335:   |--------------------------------------------------------------------------
336:   */
337: 
338:   private formatPlan(
339:     plan: {
340:       title: string;
341:       goal: string;
342:       description: string;
343:       nextAction: string;
344:       priority: number;
345:       confidence: number;
346:       milestones: string[];
347:     }
348:   ): string {
349:     return [
350:       `Plan: ${plan.title}`,
351: 
352:       `Goal: ${plan.goal}`,
353: 
354:       `Description: ${plan.description}`,
355: 
356:       `Next Action: ${plan.nextAction}`,
357: 
358:       `Priority: ${plan.priority}`,
359: 
360:       `Confidence: ${plan.confidence}`,
361: 
362:       "Milestones:",
363: 
364:       ...plan.milestones.map(
365:         (
366:           milestone,
367:           index
368:         ) =>
369:           `${index + 1}. ${milestone}`
370:       ),
371:     ].join(
372:       "\n"
373:     );
374:   }
375: }
</file>

