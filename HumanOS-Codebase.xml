477:       relevantNodes
478:     );
479: 
480:   const contextualNodes =
481:     getConnectedGraphNodes(
482:       state,
483:       relevantNodes,
484:       relevantEdges
485:     );
486: 
487:   const nodesById =
488:     new Map(
489:       contextualNodes.map(
490:         (node) => [
491:           node.id,
492:           node,
493:         ]
494:       )
495:     );
496: 
497:   const sections =
498:     relevantNodes.map(
499:       (node) => {
500:         const relationships =
501:           relevantEdges
502:             .filter(
503:               (edge) =>
504:                 edge.from ===
505:                   node.id ||
506:                 edge.to ===
507:                   node.id
508:             )
509:             .map(
510:               (edge) => {
511:                 const relatedId =
512:                   edge.from ===
513:                   node.id
514:                     ? edge.to
515:                     : edge.from;
516: 
517:                 const relatedNode =
518:                   nodesById.get(
519:                     relatedId
520:                   );
521: 
522:                 if (
523:                   !relatedNode
524:                 ) {
525:                   return null;
526:                 }
527: 
528:                 return [
529:                   `  • ${edge.type}:`,
530:                   `${relatedNode.label}`,
531:                   `(${relatedNode.type})`,
532:                   `[weight ${edge.weight.toFixed(
533:                     2
534:                   )}]`,
535:                 ].join(" ");
536:               }
537:             )
538:             .filter(
539:               (
540:                 value
541:               ): value is string =>
542:                 Boolean(
543:                   value
544:                 )
545:             );
546: 
547:         return [
548:           `${node.label} (${node.type})`,
549:           ...relationships,
550:         ].join("\n");
551:       }
552:     );
553: 
554:   if (
555:     sections.length === 0
556:   ) {
557:     return "";
558:   }
559: 
560:   return `
561: Relevant Knowledge Graph Context:
562: 
563: ${sections.join("\n\n")}
564: 
565: The graph context above was selected
566: using the user's current request,
567: entity relevance, relationship relevance,
568: and graph relationship weight.
569: 
570: Only the most relevant graph entities
571: and relationships are included.
572: 
573: Use graph information when it helps
574: answer the request.
575: 
576: Treat relationships as observations,
577: not assumptions.
578: 
579: Do not invent relationships that are not
580: present in the graph.
581: `;
582: }
