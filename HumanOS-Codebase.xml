<file path="frontend/brain/knowledge/search.ts">
 1: import { getDocuments } from "./store";
 2: import { SearchResult } from "./types";
 3: 
 4: export function searchKnowledge(
 5:   query: string
 6: ): SearchResult[] {
 7:   const normalizedQuery = query.toLowerCase().trim();
 8: 
 9:   const words = normalizedQuery
10:     .split(/\s+/)
11:     .filter(Boolean);
12: 
13:   const results: SearchResult[] = [];
14: 
15:   for (const document of getDocuments()) {
16:     const metadata = [
17:       document.id,
18:       document.title,
19:       document.source,
20:     ]
21:       .join(" ")
22:       .toLowerCase();
23: 
24:     const metadataMatched = words.some(
25:       (word) =>
26:         metadata.includes(word) ||
27:         normalizedQuery.includes(metadata)
28:     );
29: 
30:     for (const chunk of document.chunks) {
31:       let score = 0;
32: 
33:       const text = chunk.text.toLowerCase();
34: 
35:       // Existing keyword search
36:       for (const word of words) {
37:         if (text.includes(word)) {
38:           score += 1;
39:         }
40:       }
41: 
42:       // Metadata-aware search
43:       if (metadataMatched) {
44:         score += 10;
45:       }
46: 
47:       // Chunk source match
48:       if (
49:         chunk.source
50:           .toLowerCase()
51:           .includes(normalizedQuery)
52:       ) {
53:         score += 10;
54:       }
55: 
56:       if (score > 0) {
57:         results.push({
58:           chunk,
59:           score,
60:         });
61:       }
62:     }
63:   }
64: 
65:   results.sort((a, b) => b.score - a.score);
66: 
67:   return results;
68: }
</file>

