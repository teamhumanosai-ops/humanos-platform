 51:   |
 52:   | The immediate next action is the action
 53:   | most directly associated with the current
 54:   | graph-aware plan.
 55:   |--------------------------------------------------------------------------
 56:   */
 57: 
 58:   if (
 59:     action ===
 60:     plan.nextAction
 61:   ) {
 62:     return 10;
 63:   }
 64: 
 65:   return 0;
 66: }
 67: 
 68: export function evaluateActions(
 69:   plan: Plan
 70: ): ActionEvaluation[] {
 71:   const graphAware =
 72:     hasGraphContext(
 73:       plan
 74:     );
 75: 
 76:   return plan.milestones.map(
 77:     (
 78:       milestone
 79:     ) => {
 80:       const completed =
 81:         plan.completedMilestones.includes(
 82:           milestone
 83:         );
 84: 
 85:       if (
 86:         completed
 87:       ) {
 88:         return {
 89:           action:
 90:             milestone,
 91: 
 92:           score:
 93:             0,
 94: 
 95:           reason:
 96:             "Already completed",
 97:         };
 98:       }
 99: 
100:       const baseScore =
101:         calculateConfidence(
102:           plan,
103:           milestone
104:         );
105: 
106:       const graphBonus =
107:         calculateGraphBonus(
108:           plan,
109:           milestone
110:         );
111: 
112:       const score =
113:         Math.min(
114:           baseScore +
115:             graphBonus,
116:           100
117:         );
118: 
119:       const reasons =
120:         [
121:           milestone ===
122:           plan.nextAction
123:             ? "Highest confidence based on current plan progress"
124:             : "Valid future milestone",
125: 
126:           graphAware &&
127:           graphBonus > 0
128:             ? "Supported by available knowledge graph context"
129:             : null,
130:         ].filter(
131:           (
132:             value
133:           ): value is string =>
134:             Boolean(value)
135:         );
136: 
137:       return {
138:         action:
139:           milestone,
140: 
141:         score,
142: 
143:         reason:
144:           reasons.join(
145:             "; "
146:           ),
147:       };
148:     }
149:   );
150: }
</file>

<file path="frontend/brain/goalExtractor.ts">
  1: const DIRECT_GOAL_PATTERNS = [
  2:   /i want to (.+)/i,
  3:   /i need to (.+)/i,
  4:   /my goal is (.+)/i,
  5:   /help me (.+)/i,
  6:   /i'm trying to (.+)/i,
  7:   /im trying to (.+)/i,
  8:   /i would like to (.+)/i,
  9:   /i'd like to (.+)/i,
 10:   /i plan to (.+)/i,
 11:   /i am planning to (.+)/i,
 12: ];
 13: 
 14: const ACTION_PATTERNS = [
 15:   /^(finish|complete|do|buy|prepare|organize|organise|handle|review|update|fix|clean|call|send|pay|book|schedule|build|create|develop|launch|write|read|study|learn|practice|research|design|implement|install|set up|setup)\b\s+(.+)/i,
 16: ];
 17: 
 18: const INFORMATION_PATTERNS = [
 19:   /^show me\b/i,
 20:   /^list\b/i,
 21:   /^what are\b/i,
 22:   /^what is\b/i,
 23:   /^what's\b/i,
 24:   /^tell me\b/i,
 25:   /^where are\b/i,
 26:   /^which\b/i,
 27:   /^do i have\b/i,
 28:   /^how many\b/i,
 29: ];
 30: 
 31: export function extractGoal(
 32:   message: string
 33: ): string | null {
 34:   const text =
 35:     message
 36:       .trim()
 37:       .replace(
 38:         /\s+/g,
 39:         " "
 40:       );
 41: 
 42:   if (!text) {
 43:     return null;
 44:   }
 45: 
 46:   /*
 47:   |--------------------------------------------------------------------------
 48:   | Explicit informational requests are never goals.
 49:   |--------------------------------------------------------------------------
 50:   */
 51: 
 52:   if (
 53:     INFORMATION_PATTERNS.some(
 54:       (pattern) =>
 55:         pattern.test(text)
 56:     )
 57:   ) {
 58:     return null;
 59:   }
 60: 
 61:   /*
 62:   |--------------------------------------------------------------------------
 63:   | Explicit goal language
 64:   |--------------------------------------------------------------------------
 65:   */
 66: 
 67:   for (
 68:     const pattern of
 69:     DIRECT_GOAL_PATTERNS
 70:   ) {
 71:     const match =
 72:       text.match(
 73:         pattern
 74:       );
 75: 
 76:     if (
 77:       match?.[1]
 78:     ) {
 79:       const goal =
 80:         match[1].trim();
 81: 
 82:       if (
 83:         goal.length > 0
 84:       ) {
 85:         return goal;
 86:       }
 87:     }
 88:   }
 89: 
 90:   /*
 91:   |--------------------------------------------------------------------------
 92:   | Generic actionable requests
 93:   |--------------------------------------------------------------------------
 94:   |
 95:   | This allows task-style language to become goals
 96:   | without requiring the user to say "I want to".
 97:   |
 98:   | Examples:
 99:   |
100:   | "Finish the Human OS planner"
101:   | "Buy groceries"
102:   | "Review my finances"
103:   | "Study machine learning"
104:   | "Book a dentist appointment"
105:   |
106:   */
107: 
108:   for (
109:     const pattern of
110:     ACTION_PATTERNS
111:   ) {
112:     const match =
113:       text.match(
114:         pattern
115:       );
116: 
117:     if (
118:       match?.[2]
119:     ) {
120:       const action =
121:         match[1].trim();
122: 
123:       const target =
124:         match[2].trim();
125: 
126:       if (
127:         target.length > 0
128:       ) {
129:         return `${action} ${target}`;
130:       }
131:     }
132:   }
133: 
134:   return null;
135: }
</file>

