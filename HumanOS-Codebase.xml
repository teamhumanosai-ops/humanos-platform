25: export class FileDetector {
26:     static detect(filename?: string): ArtifactType | null {
27:         if (!filename) {
28:             return null;
29:         }
30: 
31:         const extension = filename
32:             .split(".")
33:             .pop()
34:             ?.toLowerCase();
35: 
36:         if (!extension) {
37:             return null;
38:         }
39: 
40:         return EXTENSIONS[extension] ?? null;
41:     }
