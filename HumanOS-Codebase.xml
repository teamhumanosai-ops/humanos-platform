<file path="frontend/brain/runtime/outcome.ts">
import type {
  ExecutionStatus,
} from "../execution";

export type RuntimeOutcomeStatus =
  | "in_progress"
  | "completed"
  | "failed"
  | "blocked";

export type RuntimeOutcome = {
  status:
    RuntimeOutcomeStatus;

  result:
    string | null;

  errors:
    string[];

  metadata: {
    executionId:
      string | null;

    executionStatus:
      ExecutionStatus | null;

    planId:
      string | null;

    decisionId:
      string | null;

    stagesExecuted:
      string[];

    createdAt:
      Date;

    completedAt:
      Date;
  };
};

export function createRuntimeOutcome(
  input: {
    result:
      string | null;

    errors:
      string[];

    executionId:
      string | null;

    executionStatus:
      ExecutionStatus | null;

    planId:
      string | null;

    decisionId:
      string | null;

    stagesExecuted:
      string[];
  }
): RuntimeOutcome {
  const completedAt =
    new Date();

  const status:
    RuntimeOutcomeStatus =
    determineOutcomeStatus(
      input
    );

  return {
    status,

    result:
      input.result,

    errors:
      [...input.errors],

    metadata: {
      executionId:
        input.executionId,

      executionStatus:
        input.executionStatus,

      planId:
        input.planId,

      decisionId:
        input.decisionId,

      stagesExecuted:
        [...input.stagesExecuted],

      createdAt:
        completedAt,

      completedAt,
    },
  };
}

function determineOutcomeStatus(
  input: {
    result:
      string | null;

    errors:
      string[];

    executionStatus:
      ExecutionStatus | null;
  }
): RuntimeOutcomeStatus {
  /*
  |--------------------------------------------------------------------------
  | Runtime failures take precedence.
  |--------------------------------------------------------------------------
  */

  if (
    input.errors.length > 0
  ) {
    return "failed";
  }

  /*
  |--------------------------------------------------------------------------
  | Blocked execution.
  |--------------------------------------------------------------------------
  */

  if (
    input.executionStatus ===
    "blocked"
  ) {
    return "blocked";
  }

  /*
  |--------------------------------------------------------------------------
  | Active execution.
  |--------------------------------------------------------------------------
  */

  if (
    input.executionStatus ===
      "pending" ||
    input.executionStatus ===
      "in_progress"
  ) {
    return "in_progress";
  }

  /*
  |--------------------------------------------------------------------------
  | Completed cognitive response.
  |--------------------------------------------------------------------------
  */

  if (
    input.result?.trim()
  ) {
    return "completed";
  }

  /*
  |--------------------------------------------------------------------------
  | No response and no active execution.
  |--------------------------------------------------------------------------
  |
  | The runtime cannot claim completion when there
  | is no actual result. Keep the outcome conservative.
  |
  */

  return "in_progress";
}
</file>

<file path="frontend/brain/planning.ts">
import { extractGoal } from "./goalExtractor";
import { generatePlan } from "./planGenerator";
import { completeMilestone } from "./progressTracker";

export type PlanStatus =
  | "active"
  | "completed"
  | "paused";

export type GoalStatus =
  | "active"
  | "completed"
  | "paused"
  | "blocked";

export type PlanningContext = {
  graphObservations?: string[];

  graphNodes?: Array<{
    id: string;
    label: string;
    type: string;
  }>;

  graphEdges?: Array<{
    from: string;
    to: string;
    type: string;
  }>;

  reasoningObservations?: Array<{
    statement: string;
    confidence: number;
    kind?: string;
  }>;

  timeline?: string[];

  reflections?: string[];

  memories?: string[];
};

export type Goal = {
  id: string;

  statement: string;

  status: GoalStatus;

  progress: number;

  priority: number;

  confidence: number;

  nextAction: string;

  obstacles: string[];

  dependencies: string[];

  createdAt: Date;

  updatedAt: Date;
};

export type Plan = {
  id: string;

  title: string;

  goal: string;

  description: string;

  status: PlanStatus;

  milestones: string[];

  completedMilestones: string[];

  nextAction: string;

  priority: number;

  confidence: number;

  createdAt: Date;

  updatedAt: Date;
};

const planStore =
  new Map<string, Plan>();

/*
|--------------------------------------------------------------------------
| Goal Intelligence
|--------------------------------------------------------------------------
*/

function normalize(
  value: string
): string {
  return value
    .trim()
    .toLowerCase();
}

function goalTerms(
  statement: string
): string[] {
  return normalize(
    statement
  )
    .split(/\s+/)
    .map(
      (term) =>
        term.replace(
          /^[^\p{L}\p{N}]+|[^\p{L}\p{N}]+$/gu,
          ""
        )
    )
    .filter(
      (term) =>
        term.length >= 3
    );
}

function calculateProgress(
  plan: Plan
): number {
  if (
    plan.milestones.length === 0
  ) {
    return 100;
  }

  return Math.round(
    (
      plan.completedMilestones.length /
      plan.milestones.length
    ) * 100
  );
}

function findRelevantGraphNodes(
  goal: Goal,
  context: PlanningContext
) {
  const terms =
    goalTerms(
      goal.statement
    );

  return (
    context.graphNodes ?? []
  ).filter(
    (node) => {
      const text =
        normalize(
          `${node.id} ${node.label}`
        );

      return terms.some(
        (term) =>
          text.includes(term)
      );
    }
  );
}

function buildDependencies(
  goal: Goal,
  context: PlanningContext
): string[] {
  const relevantNodes =
    findRelevantGraphNodes(
      goal,
      context
    );

  if (
    relevantNodes.length === 0
  ) {
    return [];
  }

  const relevantIds =
    new Set(
      relevantNodes.map(
        (node) =>
          node.id
      )
    );

  const nodesById =
    new Map(
      (
        context.graphNodes ??
        []
      ).map(
        (node) => [
          node.id,
          node,
        ]
      )
    );

  const dependencies =
    new Set<string>();

  for (
    const edge of
    context.graphEdges ?? []
  ) {
    if (
      edge.type !==
      "depends_on"
    ) {
      continue;
    }

    if (
      !relevantIds.has(
        edge.from
      )
    ) {
      continue;
    }

    const dependency =
      nodesById.get(
        edge.to
      );

    if (
      dependency
    ) {
      dependencies.add(
        dependency.label
      );
    }
  }

  return [
    ...dependencies,
  ].slice(
    0,
    5
  );
}

function containsObstacleSignal(
  value: string
): boolean {
  const text =
    normalize(
      value
    );

  const signals = [
    "blocked",
    "blocker",
    "delay",
    "delayed",
    "cannot",
    "can't",
    "unable",
    "issue",
    "problem",
    "risk",
    "uncertain",
    "uncertainty",
    "waiting",
  ];

  return signals.some(
    (signal) =>
      text.includes(
        signal
      )
  );
}

function buildObstacles(
  context: PlanningContext
): string[] {
  const candidates = [
    ...(context.reasoningObservations ??
      [])
      .filter(
        (observation) =>
          observation.kind ===
            "uncertainty" ||
          observation.confidence <
            0.7
      )
      .map(
        (observation) =>
          observation.statement
      ),

    ...(context.timeline ??
      [])
      .filter(
        containsObstacleSignal
      ),

    ...(context.reflections ??
      [])
      .filter(
        containsObstacleSignal
      ),

    ...(context.memories ??
      [])
      .filter(
        containsObstacleSignal
      ),
  ];

  return [
    ...new Set(
      candidates
        .map(
          (value) =>
            value.trim()
        )
        .filter(Boolean)
    ),
  ].slice(
    0,
    5
  );
}

export function createGoalFromPlan(
  plan: Plan
): Goal {
  return {
    id:
      plan.id,

    statement:
      plan.goal,

    status:
      plan.status ===
      "completed"
        ? "completed"
        : "active",

    progress:
      calculateProgress(
        plan
      ),

    priority:
      plan.priority,

    confidence:
      plan.confidence,

    nextAction:
      plan.nextAction,

    obstacles: [],

    dependencies: [],

    createdAt:
      plan.createdAt,

    updatedAt:
      plan.updatedAt,
  };
}

export function enrichGoalFromContext(
  goal: Goal,
  context: PlanningContext
): Goal {
  const obstacles =
    buildObstacles(
      context
    );

  const dependencies =
    buildDependencies(
      goal,
      context
    );

  const progress =
    goal.progress;

  let status:
    GoalStatus =
    "active";

  if (
    progress >= 100
  ) {
    status =
      "completed";
  } else if (
    obstacles.length > 0
  ) {
    status =
      "blocked";
  }

  return {
    ...goal,

    status,

    progress,

    obstacles,

    dependencies,

    updatedAt:
      new Date(),
  };
}

/*
|--------------------------------------------------------------------------
| Query API
|--------------------------------------------------------------------------
*/

export function getAllPlans(): Plan[] {
  return Array.from(
    planStore.values()
  );
}

export function getPlan(
  id: string
): Plan | undefined {
  return planStore.get(
    id
  );
}

/*
|--------------------------------------------------------------------------
| Mutation API
|--------------------------------------------------------------------------
*/

export function createPlanFromMessage(
  message: string
): Plan | null {
  return createPlanFromMessageWithContext(
    message
  );
}

export function createPlanFromMessageWithContext(
  message: string,
  context: PlanningContext = {}
): Plan | null {
  const goal =
    extractGoal(
      message
    );

  if (!goal) {
    return null;
  }

  const plan =
    generatePlan(
      goal
    );

  const graphObservations =
    context.graphObservations
      ?.filter(
        (observation) =>
          observation.trim().length > 0
      )
      .slice(
        0,
        3
      ) ?? [];

  if (
    graphObservations.length > 0
  ) {
    const graphMilestone =
      "Use relevant knowledge graph relationships to guide execution.";

    if (
      !plan.milestones.includes(
        graphMilestone
      )
    ) {
      plan.milestones = [
        graphMilestone,
        ...plan.milestones,
      ];
    }

    plan.description =
      [
        plan.description,

        "Graph context:",

        ...graphObservations.map(
          (observation) =>
            `- ${observation}`
        ),
      ].join("\n");

    plan.nextAction =
      graphMilestone;
  }

  savePlan(
    plan
  );

  return plan;
}

export function savePlan(
  plan: Plan
): void {
  plan.updatedAt =
    new Date();

  planStore.set(
    plan.id,
    plan
  );
}

export function updatePlan(
  plan: Plan
): void {
  savePlan(
    plan
  );
}

export function deletePlan(
  id: string
): void {
  planStore.delete(
    id
  );
}

export function clearPlans(): void {
  planStore.clear();
}

/*
|--------------------------------------------------------------------------
| Planning Operations
|--------------------------------------------------------------------------
*/

export function completePlanMilestone(
  planId: string,
  milestone: string
): Plan | null {
  const plan =
    getPlan(
      planId
    );

  if (!plan) {
    return null;
  }

  const updated =
    completeMilestone(
      plan,
      milestone
    );

  savePlan(
    updated
  );

  return updated;
}
</file>

