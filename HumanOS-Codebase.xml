<file path="frontend/brain/enrichment/engine.ts">
 1: import { HumanProfile } from "../profile/types";
 2: import {
 3:   enrichmentRules,
 4:   EnrichmentField,
 5: } from "./rules";
 6: import { enrichmentPrompts } from "./prompts";
 7: 
 8: export interface EnrichmentSuggestion {
 9:   field: EnrichmentField;
10:   prompt: string;
11:   priority: number;
12: }
13: 
14: export class EnrichmentEngine {
15:   getNextQuestion(
16:     profile: HumanProfile
17:   ): EnrichmentSuggestion | null {
18:     const sortedRules = [...enrichmentRules].sort(
19:       (a, b) => a.priority - b.priority
20:     );
21: 
22:     for (const rule of sortedRules) {
23:       if (this.isMissing(profile, rule.field)) {
24:         return {
25:           field: rule.field,
26:           prompt:
27:             enrichmentPrompts[rule.field],
28:           priority: rule.priority,
29:         };
30:       }
31:     }
32: 
33:     return null;
34:   }
35: 
36:   private isMissing(
37:     profile: HumanProfile,
38:     field: EnrichmentField
39:   ): boolean {
40:     const path = field.split(".");
41: 
42:     let current: unknown = profile;
43: 
44:     for (const key of path) {
45:       if (
46:         current === null ||
47:         current === undefined ||
48:         typeof current !== "object"
49:       ) {
50:         return true;
51:       }
52: 
53:       current = (
54:         current as Record<
55:           string,
56:           unknown
57:         >
58:       )[key];
59:     }
60: 
61:     if (Array.isArray(current)) {
62:       return current.length === 0;
63:     }
64: 
65:     return (
66:       current === undefined ||
67:       current === null ||
68:       current === ""
69:     );
70:   }
71: }
72: 
73: export const enrichmentEngine =
74:   new EnrichmentEngine();
</file>

