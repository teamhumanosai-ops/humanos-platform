  6: type ChatMessage = {
  7:   role:
  8:     | "system"
  9:     | "user"
 10:     | "assistant";
 11: 
 12:   content:
 13:     string;
 14: };
 15: 
 16: type OpenRouterResponse = {
 17:   choices?: Array<{
 18:     message?: {
 19:       content?: string;
 20:     };
 21:   }>;
 22: 
 23:   error?: {
 24:     message?: string;
 25:   };
 26: };
 27: 
 28: type GeminiResponse = {
 29:   candidates?: Array<{
 30:     content?: {
 31:       parts?: Array<{
 32:         text?: string;
 33:       }>;
 34:     };
 35:   }>;
 36: 
 37:   error?: {
 38:     message?: string;
 39:   };
 40: };
 41: 
 42: const providerFailures =
 43:   new Map<
 44:     AIProvider,
 45:     number
 46:   >();
 47: 
 48: function isProviderAvailable(
 49:   provider: AIProvider
 50: ): boolean {
 51:   const failedAt =
 52:     providerFailures.get(
 53:       provider
 54:     );
 55: 
 56:   if (
 57:     failedAt === undefined
 58:   ) {
 59:     return true;
 60:   }
 61: 
 62:   const cooldownExpired =
 63:     Date.now() -
 64:       failedAt >=
 65:     AI_CONFIG.providerFailureCooldownMs;
 66: 
 67:   if (
 68:     cooldownExpired
 69:   ) {
 70:     providerFailures.delete(
 71:       provider
 72:     );
 73: 
 74:     return true;
 75:   }
 76: 
 77:   return false;
 78: }
 79: 
 80: function markProviderHealthy(
 81:   provider: AIProvider
 82: ): void {
 83:   providerFailures.delete(
 84:     provider
 85:   );
 86: }
 87: 
 88: function markProviderFailed(
 89:   provider: AIProvider
 90: ): void {
 91:   providerFailures.set(
 92:     provider,
 93:     Date.now()
 94:   );
 95: }
 96: 
 97: function getProviderOrder(): AIProvider[] {
 98:   return AI_CONFIG.providers.filter(
 99:     (
100:       provider
101:     ) =>
102:       isProviderAvailable(
103:         provider
104:       )
105:   );
106: }
