 55: function normalize(
 56:   value: string
 57: ): string {
 58:   return value
 59:     .toLowerCase()
 60:     .replace(
 61:       /[^a-z0-9]+/g,
 62:       " "
 63:     )
 64:     .replace(
 65:       /\s+/g,
 66:       " "
 67:     )
 68:     .trim();
 69: }
 70: 
 71: function tokenize(
 72:   value: string
 73: ): string[] {
 74:   const normalized =
 75:     normalize(
 76:       value
 77:     );
 78: 
 79:   if (
 80:     !normalized
 81:   ) {
 82:     return [];
 83:   }
 84: 
 85:   return [
 86:     ...new Set(
 87:       normalized
 88:         .split(" ")
 89:         .filter(
 90:           (token) =>
 91:             token.length >= 3
 92:         )
 93:     ),
 94:   ];
 95: }
 96: 
 97: function scoreGraphNode(
 98:   node:
 99:     BrainState["graph"][number],
100:   queryTokens:
101:     string[]
102: ): number {
103:   if (
104:     queryTokens.length === 0
105:   ) {
106:     return 0;
107:   }
108: 
109:   const label =
110:     normalize(
111:       node.label
112:     );
113: 
114:   const id =
115:     normalize(
116:       node.id
117:     );
118: 
119:   const propertyText =
120:     normalize(
121:       Object.values(
122:         node.properties
123:       )
124:         .filter(
125:           (
126:             value
127:           ): value is
128:             | string
129:             | number
130:             | boolean =>
131:             typeof value ===
132:               "string" ||
133:             typeof value ===
134:               "number" ||
135:             typeof value ===
136:               "boolean"
137:         )
138:         .join(" ")
139:     );
140: 
141:   let score = 0;
142: 
143:   for (
144:     const token of
145:     queryTokens
146:   ) {
147:     if (
148:       label === token
149:     ) {
150:       score += 10;
151:       continue;
152:     }
153: 
154:     if (
155:       label.includes(
156:         token
157:       )
158:     ) {
159:       score += 5;
160:       continue;
161:     }
162: 
163:     if (
164:       id.includes(
165:         token
166:       )
167:     ) {
168:       score += 3;
169:       continue;
170:     }
171: 
172:     if (
173:       propertyText.includes(
174:         token
175:       )
176:     ) {
177:       score += 2;
178:     }
179:   }
180: 
181:   return score;
182: }
183: 
184: function scoreGraphEdge(
185:   edge:
186:     BrainState["graphEdges"][number],
187:   nodesById:
188:     Map<
189:       string,
190:       BrainState["graph"][number]
191:     >,
192:   queryTokens:
193:     string[]
194: ): number {
195:   const from =
196:     nodesById.get(
197:       edge.from
198:     );
199: 
200:   const to =
201:     nodesById.get(
202:       edge.to
203:     );
204: 
205:   if (
206:     !from ||
207:     !to
208:   ) {
209:     return 0;
210:   }
211: 
212:   const relationship =
213:     normalize(
214:       edge.type
215:     );
216: 
217:   const fromLabel =
218:     normalize(
219:       from.label
220:     );
221: 
222:   const toLabel =
223:     normalize(
224:       to.label
225:     );
226: 
227:   let score =
228:     Math.max(
229:       0,
230:       edge.weight
231:     );
232: 
233:   for (
234:     const token of
235:     queryTokens
236:   ) {
237:     if (
238:       relationship.includes(
239:         token
240:       )
241:     ) {
242:       score += 5;
243:     }
244: 
245:     if (
246:       fromLabel.includes(
247:         token
248:       )
249:     ) {
250:       score += 3;
251:     }
252: 
253:     if (
254:       toLabel.includes(
255:         token
256:       )
257:     ) {
258:       score += 3;
259:     }
260:   }
261: 
262:   return score;
263: }
