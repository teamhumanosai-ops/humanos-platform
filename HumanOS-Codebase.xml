14:   prompt: string;
15: 
16:   results: RetrievalResult[];
17: 
18:   graphPrompt: string;
19: };
20: 
21: export async function buildKnowledgeContext(
22:   userMessage: string
23: ): Promise<KnowledgeContext> {
24:   const results =
25:     await retrieveKnowledgeResults(
26:       userMessage
27:     );
28: 
29:   const graphNodes =
30:     graphQuery.search(
31:       userMessage
32:     );
33: 
34:   const graphSections: string[] =
35:     [];
36: 
37:   for (
38:     const node of graphNodes
39:   ) {
40:     const subgraph =
41:       graphQuery.getConnectedSubgraph(
42:         node.id
43:       );
44: 
45:     graphSections.push(
46:       [
47:         `${node.label} (${node.type})`,
48: 
49:         ...subgraph.neighbors.map(
50:           (neighbor) =>
51:             `  • ${neighbor.label} (${neighbor.type})`
52:         ),
53:       ].join("\n")
54:     );
55:   }
56: 
57:   const graphPrompt =
58:     graphSections.length > 0
59:       ? `Relevant Knowledge Graph Information:
60: 
61: ${graphSections.join(
62:   "\n\n"
63: )}`
64:       : "";
65: 
66:   const knowledgePrompt =
67:     results.length > 0
68:       ? `Relevant Knowledge Base Information:
69: 
70: ${results
71:   .map(
72:     (result) => `
73: Source: ${result.source}
74: Score: ${result.score.toFixed(6)}
75: 
76: ${result.text}
77: `
78:   )
79:   .join("\n")}`
80:       : "";
81: 
82:   const prompt = [
83:     knowledgePrompt,
84:     graphPrompt,
85:   ]
86:     .filter(
87:       (section) =>
88:         section.trim().length > 0
89:     )
90:     .join("\n\n");
91: 
92:   return {
93:     prompt,
94: 
95:     results,
96: 
97:     graphPrompt,
98:   };
99: }
