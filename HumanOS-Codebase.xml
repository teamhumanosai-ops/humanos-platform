  1: import {
  2:   Decision,
  3: } from "./decision";
  4: 
  5: import {
  6:   generateExecution,
  7: } from "./executionGenerator";
  8: 
  9: import {
 10:   completePlanMilestone,
 11: } from "./planning";
 12: 
 13: export type ExecutionStatus =
 14:   | "pending"
 15:   | "in_progress"
 16:   | "completed"
 17:   | "blocked";
 18: 
 19: export type Execution = {
 20:   id: string;
 21: 
 22:   planId: string;
 23: 
 24:   title: string;
 25: 
 26:   action: string;
 27: 
 28:   status: ExecutionStatus;
 29: 
 30:   startedAt: Date | null;
 31: 
 32:   completedAt: Date | null;
 33: 
 34:   createdAt: Date;
 35: };
 36: 
 37: const executionStore =
 38:   new Map<
 39:     string,
 40:     Execution
 41:   >();
 42: 
 43: /*
 44: |--------------------------------------------------------------------------
 45: | Query API
 46: |--------------------------------------------------------------------------
 47: */
 48: 
 49: export function getAllExecutions():
 50:   Execution[] {
 51:   return Array.from(
 52:     executionStore.values()
 53:   );
 54: }
 55: 
 56: export function getExecution(
 57:   id: string
 58: ):
 59:   Execution | undefined {
 60:   return executionStore.get(
 61:     id
 62:   );
 63: }
 64: 
 65: /*
 66: |--------------------------------------------------------------------------
 67: | Mutation API
 68: |--------------------------------------------------------------------------
 69: */
 70: 
 71: export function saveExecution(
 72:   execution: Execution
 73: ): void {
 74:   executionStore.set(
 75:     execution.id,
 76:     execution
 77:   );
 78: }
 79: 
 80: export function updateExecution(
 81:   execution: Execution
 82: ): void {
 83:   saveExecution(
 84:     execution
 85:   );
 86: }
 87: 
 88: export function deleteExecution(
 89:   id: string
 90: ): void {
 91:   executionStore.delete(
 92:     id
 93:   );
 94: }
 95: 
 96: export function clearExecutions():
 97:   void {
 98:   executionStore.clear();
 99: }
100: 
101: /*
102: |--------------------------------------------------------------------------
103: | Execution Creation
104: |--------------------------------------------------------------------------
105: */
106: 
107: export function createExecutionFromDecision(
108:   decision: Decision,
109:   planId: string
110: ): Execution {
111:   const execution =
112:     generateExecution(
113:       decision,
114:       planId
115:     );
116: 
117:   saveExecution(
118:     execution
119:   );
120: 
121:   return execution;
122: }
123: 
124: /*
125: |--------------------------------------------------------------------------
126: | Execution Lifecycle
127: |--------------------------------------------------------------------------
128: */
129: 
130: export function startExecution(
131:   id: string
132: ):
133:   Execution | null {
134:   const execution =
135:     getExecution(id);
136: 
137:   if (!execution) {
138:     return null;
139:   }
140: 
141:   /*
142:   |--------------------------------------------------------------------------
143:   | Only pending executions can start.
144:   |--------------------------------------------------------------------------
145:   */
146: 
147:   if (
148:     execution.status !==
149:     "pending"
150:   ) {
151:     return null;
152:   }
153: 
154:   const updated:
155:     Execution = {
156:     ...execution,
157: 
158:     status:
159:       "in_progress",
160: 
161:     startedAt:
162:       new Date(),
163:   };
164: 
165:   saveExecution(
166:     updated
167:   );
168: 
169:   return updated;
170: }
171: 
172: export function completeExecution(
173:   id: string
174: ):
175:   Execution | null {
176:   const execution =
177:     getExecution(id);
178: 
179:   if (!execution) {
180:     return null;
181:   }
182: 
183:   /*
184:   |--------------------------------------------------------------------------
185:   | Only active executions can complete.
186:   |--------------------------------------------------------------------------
187:   */
188: 
189:   if (
190:     execution.status !==
191:     "in_progress"
192:   ) {
193:     return null;
194:   }
195: 
196:   const updated:
197:     Execution = {
198:     ...execution,
199: 
200:     status:
201:       "completed",
202: 
203:     completedAt:
204:       new Date(),
205:   };
206: 
207:   saveExecution(
208:     updated
209:   );
210: 
211:   /*
212:   |--------------------------------------------------------------------------
213:   | Completing execution advances the
214:   | corresponding planning milestone.
215:   |--------------------------------------------------------------------------
216:   */
217: 
218:   completePlanMilestone(
219:     updated.planId,
220:     updated.action
221:   );
222: 
223:   return updated;
224: }
225: 
226: export function blockExecution(
227:   id: string
228: ):
229:   Execution | null {
230:   const execution =
231:     getExecution(id);
232: 
233:   if (!execution) {
234:     return null;
235:   }
236: 
237:   /*
238:   |--------------------------------------------------------------------------
239:   | Only pending or active executions
240:   | may become blocked.
241:   |--------------------------------------------------------------------------
242:   */
243: 
244:   if (
245:     execution.status !==
246:       "pending" &&
247:     execution.status !==
248:       "in_progress"
249:   ) {
250:     return null;
251:   }
252: 
253:   const updated:
254:     Execution = {
255:     ...execution,
256: 
257:     status:
258:       "blocked",
259:   };
260: 
261:   saveExecution(
262:     updated
263:   );
264: 
265:   return updated;
266: }
</file>

