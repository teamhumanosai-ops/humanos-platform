<file path="frontend/brain/decisionGenerator.ts">
 1: import { Plan } from "./planning";
 2: import { Decision } from "./decision";
 3: import {
 4:   evaluateActions,
 5: } from "./actionEvaluator";
 6: 
 7: export function generateDecision(
 8:   plan: Plan
 9: ): Decision {
10:   const evaluations =
11:     evaluateActions(plan);
12: 
13:   const best =
14:     evaluations.sort(
15:       (a, b) => b.score - a.score
16:     )[0];
17: 
18:   return {
19:     id: crypto.randomUUID(),
20: 
21:     title: `Decision for ${plan.title}`,
22: 
23:     description:
24:       `Recommended action for "${plan.goal}"`,
25: 
26:     selectedAction: best.action,
27: 
28:     alternatives: evaluations
29:       .filter(
30:         (item) =>
31:           item.action !== best.action
32:       )
33:       .map((item) => item.action),
34: 
35:     reason: best.reason,
36: 
37:     confidence: plan.confidence,
38: 
39:     createdAt: new Date(),
40:   };
41: }
