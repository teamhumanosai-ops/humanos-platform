<file path="frontend/brain/content/pipeline/ProcessingPipeline.ts">
 1: import {
 2:     ProcessingResult,
 3:     ProcessingStatus,
 4: } from "../processing";
 5: 
 6: import { ProcessorRegistry } from "../processors";
 7: 
 8: import { HookRegistry } from "../hooks";
 9: 
10: import { ProcessingContext } from "./ProcessingContext";
11: 
12: export class ProcessingPipeline {
13:     static async execute(
14:         context: ProcessingContext
15:     ): Promise<ProcessingResult> {
16:         const startedAt = new Date();
17: 
18:         try {
19:             await HookRegistry.beforeProcess(context);
20: 
21:             const processor =
22:                 ProcessorRegistry.resolve(
23:                     context.artifact
24:                 );
25: 
26:             const artifact =
27:                 await processor.process(
28:                     context.artifact
29:                 );
30: 
31:             context.artifact = artifact;
32: 
33:             await HookRegistry.afterProcess(
34:                 context
35:             );
36: 
37:             const completedAt = new Date();
38: 
39:             return {
40:                 artifact,
41: 
42:                 status:
43:                     ProcessingStatus.COMPLETED,
44: 
45:                 startedAt,
46: 
47:                 completedAt,
48: 
49:                 durationMs:
50:                     completedAt.getTime() -
51:                     startedAt.getTime(),
52:             };
53:         } catch (error) {
54:             await HookRegistry.onError(
55:                 context,
56:                 error
57:             );
58: 
59:             const completedAt = new Date();
60: 
61:             return {
62:                 artifact: context.artifact,
63: 
64:                 status:
65:                     ProcessingStatus.FAILED,
66: 
67:                 startedAt,
68: 
69:                 completedAt,
70: 
71:                 durationMs:
72:                     completedAt.getTime() -
73:                     startedAt.getTime(),
74: 
75:                 error: {
76:                     code: "PROCESSING_ERROR",
77: 
78:                     message:
79:                         error instanceof Error
80:                             ? error.message
81:                             : "Unknown processing error",
82: 
83:                     cause: error,
84:                 },
85:             };
86:         }
87:     }
88: }
</file>

