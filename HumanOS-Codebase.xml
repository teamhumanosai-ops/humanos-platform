  1: type Citation = {
  2:   index: number;
  3:   title: string;
  4:   url: string;
  5:   domain: string;
  6:   publishedDate?: string;
  7: };
  8: 
  9: type ChatMessageProps = {
 10:   role: "user" | "assistant";
 11: 
 12:   message: string;
 13: 
 14:   citations?: Citation[];
 15: };
 16: 
 17: function parseCitationMarkers(
 18:   text: string,
 19:   citations: Citation[]
 20: ) {
 21:   const parts =
 22:     text.split(
 23:       /(\[\d+\])/
 24:     );
 25: 
 26:   return parts.map(
 27:     (part, index) => {
 28:       const match =
 29:         part.match(
 30:           /^\[(\d+)\]$/
 31:         );
 32: 
 33:       if (!match) {
 34:         return (
 35:           <span
 36:             key={index}
 37:           >
 38:             {part}
 39:           </span>
 40:         );
 41:       }
 42: 
 43:       const citationIndex =
 44:         Number(match[1]);
 45: 
 46:       const citation =
 47:         citations.find(
 48:           (item) =>
 49:             item.index ===
 50:             citationIndex
 51:         );
 52: 
 53:       if (!citation) {
 54:         return (
 55:           <span
 56:             key={index}
 57:           >
 58:             {part}
 59:           </span>
 60:         );
 61:       }
 62: 
 63:       return (
 64:         <a
 65:           key={index}
 66:           href={citation.url}
 67:           target="_blank"
 68:           rel="noopener noreferrer"
 69:           title={
 70:             citation.title
 71:           }
 72:           className="
 73:             mx-0.5
 74:             inline-flex
 75:             items-center
 76:             justify-center
 77:             rounded-md
 78:             border
 79:             border-white/20
 80:             bg-white/10
 81:             px-1.5
 82:             py-0.5
 83:             text-xs
 84:             font-semibold
 85:             text-(--primary)
 86:             transition
 87:             hover:bg-white/20
 88:           "
 89:         >
 90:           {citationIndex}
 91:         </a>
 92:       );
 93:     }
 94:   );
 95: }
 96: 
 97: function renderMessage(
 98:   message: string,
 99:   citations: Citation[]
100: ) {
101:   return message
102:     .split("\n")
103:     .map(
104:       (line, index) => (
105:         <p
106:           key={index}
107:           className={
108:             line.trim()
109:               ? "mb-2 last:mb-0"
110:               : "h-3"
111:           }
112:         >
113:           {parseCitationMarkers(
114:             line,
115:             citations
116:           )}
117:         </p>
118:       )
119:     );
120: }
121: 
122: export default function ChatMessage({
123:   role,
124:   message,
125:   citations = [],
126: }: ChatMessageProps) {
127:   const isUser =
128:     role === "user";
129: 
130:   return (
131:     <div
132:       className={`flex ${
133:         isUser
134:           ? "justify-end"
135:           : "justify-start"
136:       }`}
137:     >
138:       <div
139:         className={`
140:           max-w-[75%]
141:           rounded-3xl
142:           px-5
143:           py-4
144:           text-base
145:           leading-7
146:           transition-all
147:           duration-300
148: 
149:           ${
150:             isUser
151:               ? "bg-(--primary) text-white"
152:               : "bg-white/5 border border-white/10 text-white"
153:           }
154:         `}
155:       >
156:         {renderMessage(
157:           message,
158:           citations
159:         )}
160: 
161:         {!isUser &&
162:           citations.length >
163:             0 && (
164:             <div
165:               className="
166:                 mt-4
167:                 border-t
168:                 border-white/10
169:                 pt-3
170:               "
171:             >
172:               <div
173:                 className="
174:                   mb-2
175:                   text-xs
176:                   font-semibold
177:                   uppercase
178:                   tracking-wide
179:                   text-zinc-400
180:                 "
181:               >
182:                 Sources
183:               </div>
184: 
185:               <div
186:                 className="
187:                   space-y-1.5
188:                 "
189:               >
190:                 {citations.map(
191:                   (
192:                     citation
193:                   ) => (
194:                     <a
195:                       key={
196:                         citation.index
197:                       }
198:                       href={
199:                         citation.url
200:                       }
201:                       target="_blank"
202:                       rel="noopener noreferrer"
203:                       className="
204:                         block
205:                         text-sm
206:                         text-zinc-300
207:                         transition
208:                         hover:text-(--primary)
209:                       "
210:                     >
211:                       [{citation.index}]{" "}
212:                       {
213:                         citation.title
214:                       }{" "}
215:                       <span className="text-zinc-500">
216:                         —{" "}
217:                         {
218:                           citation.domain
219:                         }
220:                       </span>
221:                     </a>
222:                   )
223:                 )}
224:               </div>
225:             </div>
226:           )}
227:       </div>
228:     </div>
229:   );
230: }
