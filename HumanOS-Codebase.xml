390: function getConnectedGraphNodes(
391:   state: BrainState,
392:   relevantNodes:
393:     BrainState["graph"],
394:   relevantEdges:
395:     BrainState["graphEdges"]
396: ): BrainState["graph"] {
397:   if (
398:     relevantNodes.length === 0
399:   ) {
400:     return [];
401:   }
402: 
403:   const relevantIds =
404:     new Set(
405:       relevantNodes.map(
406:         (node) =>
407:           node.id
408:       )
409:     );
410: 
411:   const connectedIds =
412:     new Set(
413:       relevantIds
414:     );
415: 
416:   for (
417:     const edge of
418:     relevantEdges
419:   ) {
420:     if (
421:       relevantIds.has(
422:         edge.from
423:       )
424:     ) {
425:       connectedIds.add(
426:         edge.to
427:       );
428:     }
429: 
430:     if (
431:       relevantIds.has(
432:         edge.to
433:       )
434:     ) {
435:       connectedIds.add(
436:         edge.from
437:       );
438:     }
439:   }
440: 
441:   return state.graph
442:     .filter(
443:       (node) =>
444:         connectedIds.has(
445:           node.id
446:         )
447:     )
448:     .slice(
449:       0,
450:       12
451:     );
452: }
