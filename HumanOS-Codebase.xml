<file path="frontend/brain/content/processors/BaseProcessor.ts">
import { Artifact } from "../models";

import {
    AnalyzerRegistry,
} from "../analyzers";

import {
    KnowledgeEngine,
} from "../../knowledge/engine";

import { ContentProcessor } from "./ContentProcessor";

export abstract class BaseProcessor
    implements ContentProcessor
{
    abstract readonly name: string;

    abstract canProcess(
        artifact: Artifact
    ): boolean;

    protected abstract extract(
        artifact: Artifact
    ): Promise<string>;

    async process(
        artifact: Artifact
    ): Promise<Artifact> {
        const extractedContent =
            await this.extract(artifact);

        const analysis =
            await AnalyzerRegistry.analyze({
                text: extractedContent,

                sections: [],
            });

        const knowledge =
            await KnowledgeEngine.generate(
                analysis
            );

        return {
            ...artifact,

            extractedContent,

            knowledge,
        };
    }
}
</file>

<file path="frontend/brain/context/knowledge.ts">
import {
  retrieveKnowledgeResults,
} from "../knowledge";

import type {
  RetrievalResult,
} from "../knowledge/retrievalPipeline";

import {
  graphQuery,
} from "../graph";

export type KnowledgeContext = {
  prompt: string;

  results: RetrievalResult[];

  graphPrompt: string;
};

export async function buildKnowledgeContext(
  userMessage: string
): Promise<KnowledgeContext> {
  const results =
    await retrieveKnowledgeResults(
      userMessage
    );

  const graphNodes =
    graphQuery.search(
      userMessage
    );

  const graphSections: string[] =
    [];

  for (
    const node of graphNodes
  ) {
    const subgraph =
      graphQuery.getConnectedSubgraph(
        node.id
      );

    graphSections.push(
      [
        `${node.label} (${node.type})`,

        ...subgraph.neighbors.map(
          (neighbor) =>
            `  • ${neighbor.label} (${neighbor.type})`
        ),
      ].join("\n")
    );
  }

  const graphPrompt =
    graphSections.length > 0
      ? `Relevant Knowledge Graph Information:

${graphSections.join(
  "\n\n"
)}`
      : "";

  const knowledgePrompt =
    results.length > 0
      ? `Relevant Knowledge Base Information:

${results
  .map(
    (result) => `
Source: ${result.source}
Score: ${result.score.toFixed(6)}

${result.text}
`
  )
  .join("\n")}`
      : "";

  const prompt = [
    knowledgePrompt,
    graphPrompt,
  ]
    .filter(
      (section) =>
        section.trim().length > 0
    )
    .join("\n\n");

  return {
    prompt,

    results,

    graphPrompt,
  };
}
</file>

<file path="frontend/brain/graph/GraphStore.ts">
import {
  GraphEdge,
  GraphNode,
  KnowledgeGraph,
} from "./types";

class GraphStore {
  private graph: KnowledgeGraph = {
    nodes: new Map(),
    edges: new Map(),
  };

  getGraph(): KnowledgeGraph {
    return this.graph;
  }

  getNodes(): GraphNode[] {
    return [...this.graph.nodes.values()];
  }

  getEdges(): GraphEdge[] {
    return [...this.graph.edges.values()];
  }

  getNode(id: string): GraphNode | undefined {
    return this.graph.nodes.get(id);
  }

  getEdge(id: string): GraphEdge | undefined {
    return this.graph.edges.get(id);
  }

  addNode(node: GraphNode): void {
    this.graph.nodes.set(node.id, node);
  }

  addEdge(edge: GraphEdge): void {
    if (!this.graph.nodes.has(edge.from)) {
      throw new Error(
        `Graph node '${edge.from}' does not exist.`
      );
    }

    if (!this.graph.nodes.has(edge.to)) {
      throw new Error(
        `Graph node '${edge.to}' does not exist.`
      );
    }

    this.graph.edges.set(edge.id, edge);
  }

  hasNode(id: string): boolean {
    return this.graph.nodes.has(id);
  }

  hasEdge(id: string): boolean {
    return this.graph.edges.has(id);
  }

  removeNode(id: string): void {
    this.graph.nodes.delete(id);

    for (const [edgeId, edge] of this.graph.edges) {
      if (edge.from === id || edge.to === id) {
        this.graph.edges.delete(edgeId);
      }
    }
  }

  removeEdge(id: string): void {
    this.graph.edges.delete(id);
  }

  clear(): void {
    this.graph.nodes.clear();
    this.graph.edges.clear();
  }
}

export const graphStore = new GraphStore();
</file>

<file path="frontend/brain/graph/TimelineGraphAdapter.ts">
import {
  graphBuilder,
} from "./GraphBuilder";

import type {
  TimelineEvent,
} from "../timeline/types";

export class TimelineGraphAdapter {
  sync(
    event: TimelineEvent
  ): void {
    const timelineId =
      buildGraphId(event);

    graphBuilder.addTimelineEvent(
      timelineId,
      event.title,
      {
        timestamp:
          event.timestamp,

        description:
          event.description,

        category:
          event.category,

        confidence:
          event.confidence,

        source:
          event.source,

        createdAt:
          event.createdAt,

        timelineId:
          event.id,
      }
    );

    /*
    |--------------------------------------------------------------------------
    | Connect the Timeline event to its category.
    |--------------------------------------------------------------------------
    |
    | Categories are represented as entity nodes so the
    | existing GraphNode model can represent them without
    | introducing another node type.
    |
    */

    const categoryId =
      `entity:timeline-category:${event.category
        .toLowerCase()
        .replace(/\s+/g, "-")}`;

    graphBuilder.addEntity(
      categoryId,
      event.category,
      {
        source:
          "timeline",

        category:
          event.category,
      }
    );

    graphBuilder.connect(
      timelineId,
      categoryId,
      "belongs_to",
      event.confidence,
      {
        source:
          "timeline",

        relationship:
          "category",
      }
    );
  }
}

function buildGraphId(
  event: TimelineEvent
): string {
  if (
    event.id !== undefined
  ) {
    return `timeline:${event.id}`;
  }

  return [
    "timeline",
    event.createdAt,
    event.timestamp,
    event.category,
    event.title,
  ]
    .join(":")
    .replace(
      /\s+/g,
      "_"
    );
}

export const timelineGraphAdapter =
  new TimelineGraphAdapter();
</file>

<file path="frontend/brain/inference/engine.ts">
import type {
  BrainState,
} from "../brainState";

import type {
  ReasoningObservation,
} from "../reasoning";

import type {
  CognitiveInference,
  InferenceEvidence,
  InferenceKind,
} from "./types";

function createEvidence(
  observation: ReasoningObservation
): InferenceEvidence {
  return {
    source:
      observation.source,

    statement:
      observation.statement,

    confidence:
      observation.confidence,
  };
}

function calculateConfidence(
  evidence: InferenceEvidence[]
): number {
  if (
    evidence.length === 0
  ) {
    return 0;
  }

  const total =
    evidence.reduce(
      (
        sum,
        item
      ) =>
        sum +
        item.confidence,
      0
    );

  return total /
    evidence.length;
}

function classifyInference(
  observation: ReasoningObservation
): InferenceKind {
  if (
    observation.confidence <
    0.7
  ) {
    return "uncertainty";
  }

  if (
    observation.kind ===
    "known_fact"
  ) {
    return "known_fact";
  }

  if (
    observation.kind ===
    "observed_relationship"
  ) {
    return "observed_relationship";
  }

  if (
    observation.kind ===
    "derived_inference"
  ) {
    if (
      observation.source ===
      "prediction"
    ) {
      return "hypothesis";
    }

    return "derived_inference";
  }

  return "uncertainty";
}

function buildObservationInferences(
  observations: ReasoningObservation[]
): CognitiveInference[] {
  return observations.map(
    (
      observation
    ) => {
      const evidence =
        [
          createEvidence(
            observation
          ),
        ];

      return {
        id:
          crypto.randomUUID(),

        statement:
          observation.statement,

        kind:
          classifyInference(
            observation
          ),

        confidence:
          observation.confidence,

        evidence,

        createdAt:
          new Date(),
      };
    }
  );
}

function buildCrossSourceInference(
  observations: ReasoningObservation[]
): CognitiveInference | null {
  const independentSources =
    new Set(
      observations.map(
        (
          observation
        ) =>
          observation.source
      )
    );

  if (
    independentSources.size <
    2
  ) {
    return null;
  }

  const evidence =
    observations
      .slice(
        0,
        5
      )
      .map(
        createEvidence
      );

  const confidence =
    Math.min(
      0.9,
      calculateConfidence(
        evidence
      ) +
        0.05
    );

  return {
    id:
      crypto.randomUUID(),

    statement:
      "Multiple independent cognitive sources provide converging evidence relevant to the current request.",

    kind:
      confidence < 0.7
        ? "uncertainty"
        : "derived_inference",

    confidence,

    evidence,

    createdAt:
      new Date(),
  };
}

export function infer(
  state: BrainState
): CognitiveInference[] {
  const observations =
    state.reasoningObservations;

  if (
    observations.length === 0
  ) {
    return [];
  }

  const inferences =
    buildObservationInferences(
      observations
    );

  const crossSourceInference =
    buildCrossSourceInference(
      observations
    );

  if (
    crossSourceInference
  ) {
    inferences.push(
      crossSourceInference
    );
  }

  return inferences;
}
</file>

