<file path="frontend/brain/runtime/steps/validationStage.ts">
  1: import {
  2:   BrainState,
  3: } from "../../brainState";
  4: 
  5: import {
  6:   getDecision,
  7: } from "../../decision";
  8: 
  9: import {
 10:   getPlan,
 11: } from "../../planning";
 12: 
 13: import {
 14:   BaseStage,
 15: } from "./baseStage";
 16: 
 17: /**
 18:  * ValidationStage
 19:  *
 20:  * Validates the cognitive state immediately
 21:  * before execution.
 22:  *
 23:  * This stage does not execute actions.
 24:  * It only determines whether the current
 25:  * decision contains enough valid information
 26:  * to enter the Execution stage.
 27:  *
 28:  * Permissions and external authorization are
 29:  * intentionally not evaluated here because
 30:  * the current architecture does not yet expose
 31:  * a permission service.
 32:  */
 33: export class ValidationStage
 34:   extends BaseStage {
 35:   readonly name =
 36:     "Validation";
 37: 
 38:   protected async process(
 39:     state: BrainState
 40:   ): Promise<BrainState> {
 41:     /*
 42:     |--------------------------------------------------------------------------
 43:     | No decision means there is nothing to execute.
 44:     |--------------------------------------------------------------------------
 45:     */
 46: 
 47:     if (
 48:       !state.currentDecisionId
 49:     ) {
 50:       return state;
 51:     }
 52: 
 53:     /*
 54:     |--------------------------------------------------------------------------
 55:     | Decision must exist.
 56:     |--------------------------------------------------------------------------
 57:     */
 58: 
 59:     const decision =
 60:       getDecision(
 61:         state.currentDecisionId
 62:       );
 63: 
 64:     if (!decision) {
 65:       state.errors.push(
 66:         "Validation: active decision could not be found."
 67:       );
 68: 
 69:       return state;
 70:     }
 71: 
 72:     /*
 73:     |--------------------------------------------------------------------------
 74:     | A plan is required for execution.
 75:     |--------------------------------------------------------------------------
 76:     */
 77: 
 78:     if (
 79:       !state.currentPlanId
 80:     ) {
 81:       state.errors.push(
 82:         "Validation: execution requires an active plan."
 83:       );
 84: 
 85:       return state;
 86:     }
 87: 
 88:     /*
 89:     |--------------------------------------------------------------------------
 90:     | Plan must exist.
 91:     |--------------------------------------------------------------------------
 92:     */
 93: 
 94:     const plan =
 95:       getPlan(
 96:         state.currentPlanId
 97:       );
 98: 
 99:     if (!plan) {
100:       state.errors.push(
101:         "Validation: active plan could not be found."
102:       );
103: 
104:       return state;
105:     }
106: 
107:     /*
108:     |--------------------------------------------------------------------------
109:     | Plan identity must remain consistent.
110:     |--------------------------------------------------------------------------
111:     */
112: 
113:     if (
114:       plan.id !==
115:       state.currentPlanId
116:     ) {
117:       state.errors.push(
118:         "Validation: active plan identity is inconsistent."
119:       );
120: 
121:       return state;
122:     }
123: 
124:     /*
125:     |--------------------------------------------------------------------------
126:     | Decision must contain an executable action.
127:     |--------------------------------------------------------------------------
128:     */
129: 
130:     const action =
131:       decision.selectedAction
132:         ?.trim();
133: 
134:     if (!action) {
135:       state.errors.push(
136:         "Validation: decision does not contain an executable action."
137:       );
138: 
139:       return state;
140:     }
141: 
142:     /*
143:     |--------------------------------------------------------------------------
144:     | Validation passed.
145:     |--------------------------------------------------------------------------
146:     */
147: 
148:     return state;
149:   }
150: }
</file>

