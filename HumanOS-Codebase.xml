455:     }
456: 
457:     return graphStore
458:       .getNodes()
459:       .filter(
460:         (node) =>
461:           node.id
462:             .toLowerCase()
463:             .includes(
464:               normalized
465:             ) ||
466:           node.label
467:             .toLowerCase()
468:             .includes(
469:               normalized
470:             )
471:       );
472:   }
473: 
474:   hasRelationship(
475:     from: string,
476:     to: string,
477:     type?: GraphEdgeType
478:   ): boolean {
479:     return graphStore
480:       .getEdges()
481:       .some(
482:         (edge) =>
483:           edge.from === from &&
484:           edge.to === to &&
485:           (
486:             type === undefined ||
487:             edge.type === type
488:           )
489:       );
490:   }
491: 
492:   getConnectedSubgraph(
493:     nodeId: string
494:   ): {
495:     node:
496:       | GraphNode
497:       | undefined;
498: 
499:     neighbors:
500:       GraphNode[];
501: 
502:     relationships:
503:       GraphEdge[];
504:   } {
505:     return {
506:       node:
507:         this.getNode(
508:           nodeId
509:         ),
510: 
511:       neighbors:
512:         this.getNeighbors(
513:           nodeId
514:         ),
515: 
516:       relationships:
517:         this.getRelationships(
518:           nodeId
519:         ),
520:     };
521:   }
522: }
523: 
524: export const graphQuery =
525:   new GraphQuery();
</file>

<file path="frontend/brain/runtime/steps/contextStage.ts">
  1: import {
  2:   BrainState,
  3: } from "../../brainState";
  4: 
  5: import {
  6:   buildContext,
  7: } from "../../context";
  8: 
  9: import {
 10:   Intent,
 11: } from "../../intent";
 12: 
 13: import {
 14:   BaseStage,
 15: } from "./baseStage";
 16: 
 17: /**
 18:  * ContextStage
 19:  *
 20:  * Consumes the cognitive information already
 21:  * hydrated into BrainState and composes the
 22:  * context consumed by downstream reasoning
 23:  * and response stages.
 24:  *
 25:  * Live web evidence is explicitly included
 26:  * when LiveKnowledgeStage has executed.
 27:  */
 28: export class ContextStage
 29:   extends BaseStage {
 30:   readonly name =
 31:     "Context";
 32: 
 33:   protected async process(
 34:     state: BrainState
 35:   ): Promise<BrainState> {
 36:     if (
 37:       state.response
 38:     ) {
 39:       return state;
 40:     }
 41: 
 42:     const structuredContext =
 43:       await buildContext(
 44:         state
 45:       );
 46: 
 47:     let prompt =
 48:       structuredContext.prompt;
 49: 
 50:     switch (
 51:       state.intent
 52:     ) {
 53:       case Intent.STARTUP_PLANNING:
 54:         prompt +=
 55:           "\n\nThe user wants startup advice. Think like an experienced startup founder and advisor.";
 56:         break;
 57: 
 58:       case Intent.LIVE_SEARCH:
 59:         prompt +=
 60:           "\n\nThe user needs current information. Ground current factual claims in the live web evidence below.";
 61: 
 62:         if (
 63:           state.liveKnowledge.length >
 64:           0
 65:         ) {
 66:           prompt +=
 67:             `\n\nLIVE WEB EVIDENCE:\n\n${state.liveKnowledge.join(
 68:               "\n\n"
 69:             )}`;
 70:         } else {
 71:           prompt +=
 72:             "\n\nNo live web evidence was retrieved.";
 73:         }
 74: 
 75:         if (
 76:           state.citations.length >
 77:           0
 78:         ) {
 79:           prompt +=
 80:             "\n\nLIVE WEB SOURCES:\n\n" +
 81:             state.citations
 82:               .map(
 83:                 (
 84:                   citation
 85:                 ) =>
 86:                   `[${citation.index}] ${citation.title} — ${citation.url}`
 87:               )
 88:               .join(
 89:                 "\n"
 90:               );
 91:         }
 92: 
 93:         break;
 94: 
 95:       default:
 96:         break;
 97:     }
 98: 
 99:     state.context =
100:       prompt;
101: 
102:     state.knowledge =
103:       structuredContext.knowledge;
104: 
105:     return state;
106:   }
107: }
</file>

<file path="frontend/brain/runtime/steps/outcomeStage.ts">
  1: import {
  2:   BrainState,
  3:   BrainRuntimeStatus,
  4: } from "../../brainState";
  5: 
  6: import {
  7:   getDecision,
  8: } from "../../decision";
  9: 
 10: import {
 11:   getExecution,
 12:   ExecutionStatus,
 13: } from "../../execution";
 14: 
 15: import {
 16:   createGoalFromPlan,
 17:   enrichGoalFromContext,
 18:   getPlan,
 19: } from "../../planning";
 20: 
 21: import {
 22:   createRuntimeOutcome,
 23: } from "../outcome";
 24: 
 25: import {
 26:   BaseStage,
 27: } from "./baseStage";
 28: 
 29: /**
 30:  * OutcomeStage
 31:  *
 32:  * Finalizes the cognitive runtime by synchronizing:
 33:  *
 34:  * - Plan state
 35:  * - Goal state
 36:  * - Decision state
 37:  * - Execution state
 38:  * - Runtime outcome
 39:  * - Overall runtime status
 40:  *
 41:  * The stage also validates that the runtime identifiers
 42:  * resolve to a coherent cognitive artifact chain using
 43:  * relationships that actually exist in the current models.
 44:  */
 45: export class OutcomeStage
 46:   extends BaseStage {
 47:   readonly name =
 48:     "Outcome";
 49: 
 50:   protected async process(
 51:     state: BrainState
 52:   ): Promise<BrainState> {
 53:     const execution =
 54:       state.currentExecutionId
 55:         ? getExecution(
 56:             state.currentExecutionId
 57:           )
 58:         : undefined;
 59: 
 60:     const decision =
 61:       state.currentDecisionId
 62:         ? getDecision(
 63:             state.currentDecisionId
 64:           )
 65:         : undefined;
 66: 
 67:     const plan =
 68:       state.currentPlanId
 69:         ? getPlan(
 70:             state.currentPlanId
 71:           )
 72:         : undefined;
 73: 
 74:     /*
 75:     |--------------------------------------------------------------------------
 76:     | Validate cognitive artifact chain
 77:     |--------------------------------------------------------------------------
 78:     */
 79: 
 80:     const chainErrors =
 81:       validateArtifactChain(
 82:         state,
 83:         plan,
 84:         decision,
 85:         execution
 86:       );
 87: 
 88:     if (
 89:       chainErrors.length > 0
 90:     ) {
 91:       state.errors.push(
 92:         ...chainErrors
 93:       );
 94:     }
 95: 
 96:     /*
 97:     |--------------------------------------------------------------------------
 98:     | Synchronize plan and goal information
 99:     |--------------------------------------------------------------------------
100:     */
101: 
102:     if (plan) {
103:       const initialGoal =
104:         createGoalFromPlan(
105:           plan
106:         );
107: 
108:       const goal =
109:         enrichGoalFromContext(
110:           initialGoal,
111:           {
112:             graphNodes:
113:               state.graph,
114: 
115:             graphEdges:
116:               state.graphEdges,
117: 
118:             reasoningObservations:
119:               state.reasoningObservations,
120: 
121:             timeline:
122:               state.timeline,
123: 
124:             reflections:
125:               state.reflections,
126: 
127:             memories:
128:               state.memory,
129:           }
130:         );
131: 
132:       if (
133:         execution?.status ===
134:         "blocked"
135:       ) {
136:         goal.status =
137:           "blocked";
138:       }
139: 
140:       state.goal =
141:         goal;
142: 
143:       state.currentGoal =
144:         goal.statement;
145: 
146:       state.plan =
147:         [
148:           `Plan: ${plan.title}`,
149: 
150:           `Goal: ${goal.statement}`,
151: 
152:           `Goal Status: ${goal.status}`,
153: 
154:           `Progress: ${goal.progress}%`,
155: 
156:           `Description: ${plan.description}`,
157: 
158:           `Status: ${plan.status}`,
159: 
160:           `Next Action: ${goal.nextAction}`,
161: 
162:           `Priority: ${goal.priority}`,
163: 
164:           `Confidence: ${goal.confidence}`,
165: 
166:           `Obstacles: ${
167:             goal.obstacles.length > 0
168:               ? goal.obstacles.join(
169:                   "; "
170:                 )
171:               : "None identified"
172:           }`,
173: 
174:           `Dependencies: ${
175:             goal.dependencies.length > 0
176:               ? goal.dependencies.join(
177:                   "; "
178:                 )
179:               : "None identified"
180:           }`,
181: 
182:           `Completed Milestones: ${
183:             plan.completedMilestones.length
184:           }/${plan.milestones.length}`,
185: 
186:           "Milestones:",
187: 
188:           ...plan.milestones.map(
189:             (
190:               milestone,
191:               index
192:             ) => {
193:               const completed =
194:                 plan.completedMilestones.includes(
195:                   milestone
196:                 );
197: 
198:               return `${index + 1}. ${
199:                 completed
200:                   ? "[completed]"
201:                   : "[pending]"
202:               } ${milestone}`;
203:             }
204:           ),
205:         ].join(
206:           "\n"
207:         );
208:     }
209: 
210:     /*
211:     |--------------------------------------------------------------------------
212:     | Synchronize decision information
213:     |--------------------------------------------------------------------------
214:     */
215: 
216:     if (decision) {
217:       state.decision =
218:         [
219:           `Decision: ${decision.title}`,
220: 
221:           `Description: ${decision.description}`,
222: 
223:           `Selected Action: ${decision.selectedAction}`,
224: 
225:           "Alternatives:",
226: 
227:           ...decision.alternatives.map(
228:             (
229:               alternative,
230:               index
231:             ) =>
232:               `${index + 1}. ${alternative}`
233:           ),
234: 
235:           `Reason: ${decision.reason}`,
236: 
237:           `Confidence: ${decision.confidence}`,
238:         ].join(
239:           "\n"
240:         );
241:     }
242: 
243:     /*
244:     |--------------------------------------------------------------------------
245:     | Synchronize execution information
246:     |--------------------------------------------------------------------------
247:     */
248: 
249:     if (execution) {
250:       state.execution =
251:         [
252:           `Execution: ${execution.title}`,
253: 
254:           `Action: ${execution.action}`,
255: 
256:           `Status: ${execution.status}`,
257: 
258:           `Plan ID: ${execution.planId}`,
259: 
260:           `Execution ID: ${execution.id}`,
261: 
262:           `Started At: ${
263:             execution.startedAt
264:               ?.toISOString() ??
265:             "Not started"
266:           }`,
267: 
268:           `Completed At: ${
269:             execution.completedAt
270:               ?.toISOString() ??
271:             "Not completed"
272:           }`,
273:         ].join(
274:           "\n"
275:         );
276:     }
277: 
278:     /*
279:     |--------------------------------------------------------------------------
280:     | Create runtime outcome
281:     |--------------------------------------------------------------------------
282:     */
283: 
284:     state.outcome =
285:       createRuntimeOutcome({
286:         result:
287:           state.response,
288: 
289:         errors:
290:           state.errors,
291: 
292:         executionId:
293:           execution?.id ??
294:           state.currentExecutionId,
295: 
296:         executionStatus:
297:           execution?.status ??
298:           null,
299: 
300:         planId:
301:           execution?.planId ??
302:           state.currentPlanId,
303: 
304:         decisionId:
305:           state.currentDecisionId,
306: 
307:         stagesExecuted:
308:           state.executedStages,
309:       });
310: 
311:     /*
312:     |--------------------------------------------------------------------------
313:     | Determine overall runtime status
314:     |--------------------------------------------------------------------------
315:     */
316: 
317:     state.runtimeStatus =
318:       determineRuntimeStatus(
319:         state,
320:         execution?.status ??
321:           null
322:       );
323: 
324:     return state;
325:   }
326: }
327: 
328: /*
329: |--------------------------------------------------------------------------
330: | Cognitive artifact chain validation
331: |--------------------------------------------------------------------------
332: */
333: 
334: function validateArtifactChain(
335:   state: BrainState,
336:   plan:
337:     ReturnType<
338:       typeof getPlan
339:     >,
340:   decision:
341:     ReturnType<
342:       typeof getDecision
343:     >,
344:   execution:
345:     ReturnType<
346:       typeof getExecution
347:     >
348: ): string[] {
349:   const errors:
350:     string[] = [];
351: 
352:   /*
353:   |--------------------------------------------------------------------------
354:   | Plan resolution
355:   |--------------------------------------------------------------------------
356:   */
357: 
358:   if (
359:     state.currentPlanId &&
360:     !plan
361:   ) {
362:     errors.push(
363:       `Outcome: plan ${state.currentPlanId} could not be resolved.`
364:     );
365:   }
366: 
367:   /*
368:   |--------------------------------------------------------------------------
369:   | Decision resolution
370:   |--------------------------------------------------------------------------
371:   */
372: 
373:   if (
374:     state.currentDecisionId &&
375:     !decision
376:   ) {
377:     errors.push(
378:       `Outcome: decision ${state.currentDecisionId} could not be resolved.`
379:     );
380:   }
381: 
382:   /*
383:   |--------------------------------------------------------------------------
384:   | Execution resolution
385:   |--------------------------------------------------------------------------
386:   */
387: 
388:   if (
389:     state.currentExecutionId &&
390:     !execution
391:   ) {
392:     errors.push(
393:       `Outcome: execution ${state.currentExecutionId} could not be resolved.`
394:     );
395:   }
396: 
397:   /*
398:   |--------------------------------------------------------------------------
399:   | Execution → Plan relationship
400:   |--------------------------------------------------------------------------
401:   |
402:   | Execution is the existing artifact that explicitly owns planId.
403:   |
404:   */
405: 
406:   if (
407:     execution &&
408:     state.currentPlanId &&
409:     execution.planId !==
410:       state.currentPlanId
411:   ) {
412:     errors.push(
413:       `Outcome: execution ${execution.id} does not belong to plan ${state.currentPlanId}.`
414:     );
415:   }
416: 
417:   return [
418:     ...new Set(
419:       errors
420:     ),
421:   ];
422: }
423: 
424: /*
425: |--------------------------------------------------------------------------
426: | Runtime status
427: |--------------------------------------------------------------------------
428: */
429: 
430: function determineRuntimeStatus(
431:   state: BrainState,
432:   executionStatus:
433:     | ExecutionStatus
434:     | null
435: ): BrainRuntimeStatus {
436:   /*
437:   |--------------------------------------------------------------------------
438:   | Runtime errors take precedence.
439:   |--------------------------------------------------------------------------
440:   */
441: 
442:   if (
443:     state.errors.length > 0
444:   ) {
445:     return "failed";
446:   }
447: 
448:   /*
449:   |--------------------------------------------------------------------------
450:   | Blocked execution.
451:   |--------------------------------------------------------------------------
452:   */
453: 
454:   if (
455:     executionStatus ===
456:     "blocked"
457:   ) {
458:     return "blocked";
459:   }
460: 
461:   /*
462:   |--------------------------------------------------------------------------
463:   | Active execution.
464:   |--------------------------------------------------------------------------
465:   */
466: 
467:   if (
468:     executionStatus ===
469:       "pending" ||
470:     executionStatus ===
471:       "in_progress"
472:   ) {
473:     return "in_progress";
474:   }
475: 
476:   /*
477:   |--------------------------------------------------------------------------
478:   | Completed execution.
479:   |--------------------------------------------------------------------------
480:   */
481: 
482:   if (
483:     executionStatus ===
484:     "completed"
485:   ) {
486:     return "completed";
487:   }
488: 
489:   /*
490:   |--------------------------------------------------------------------------
491:   | Successful cognitive response.
492:   |--------------------------------------------------------------------------
493:   */
494: 
495:   if (
496:     state.response?.trim()
497:   ) {
498:     return "completed";
499:   }
500: 
501:   /*
502:   |--------------------------------------------------------------------------
503:   | Conservative fallback.
504:   |--------------------------------------------------------------------------
505:   */
506: 
507:   return "in_progress";
508: }
</file>

<file path="frontend/brain/reasoning/engine.ts">
  1: import type {
  2:   BrainState,
  3: } from "../brainState";
  4: 
  5: import type {
  6:   GraphEdge,
  7:   GraphNode,
  8: } from "../graph";
  9: 
 10: import type {
 11:   ReasoningObservation,
 12:   ReasoningObservationKind,
 13:   ReasoningResult,
 14:   ReasoningSource,
 15: } from "./types";
 16: 
 17: function normalize(
 18:   value: string
 19: ): string {
 20:   return value
 21:     .replace(
 22:       /\s+/g,
 23:       " "
 24:     )
 25:     .trim();
 26: }
 27: 
 28: function limitItems<T>(
 29:   items: T[],
 30:   limit = 5
 31: ): T[] {
 32:   return items.slice(
 33:     0,
 34:     limit
 35:   );
 36: }
 37: 
 38: function classifyObservation(
 39:   source: ReasoningSource,
 40:   confidence: number,
 41:   preferredKind?:
 42:     ReasoningObservationKind
 43: ): ReasoningObservationKind {
 44:   if (
 45:     confidence < 0.7
 46:   ) {
 47:     return "uncertainty";
 48:   }
 49: 
 50:   if (
 51:     preferredKind
 52:   ) {
 53:     return preferredKind;
 54:   }
 55: 
 56:   if (
 57:     source ===
 58:     "reflection"
 59:   ) {
 60:     return "derived_inference";
 61:   }
 62: 
 63:   if (
 64:     source ===
 65:     "knowledge_graph"
 66:   ) {
 67:     return "observed_relationship";
 68:   }
 69: 
 70:   if (
 71:     source ===
 72:     "prediction"
 73:   ) {
 74:     return "derived_inference";
 75:   }
 76: 
 77:   return "known_fact";
 78: }
 79: 
 80: function createObservation(
 81:   statement: string,
 82:   confidence: number,
 83:   source: ReasoningSource,
 84:   preferredKind?:
 85:     ReasoningObservationKind
 86: ): ReasoningObservation {
 87:   return {
 88:     statement:
 89:       normalize(
 90:         statement
 91:       ),
 92: 
 93:     confidence,
 94: 
 95:     source,
 96: 
 97:     kind:
 98:       classifyObservation(
 99:         source,
100:         confidence,
101:         preferredKind
102:       ),
103:   };
104: }
105: 
106: function buildMemoryObservations(
107:   state: BrainState
108: ): ReasoningObservation[] {
109:   return limitItems(
110:     state.memories
111:       .map(
112:         (memory) =>
113:           createObservation(
114:             `${memory.key}: ${memory.value}`,
115:             memory.confidence,
116:             "memory"
117:           )
118:       )
119:       .filter(
120:         (observation) =>
121:           observation.statement
122:             .length > 0
123:       )
124:   );
125: }
126: 
127: function buildKnowledgeObservations(
128:   state: BrainState
129: ): ReasoningObservation[] {
130:   return limitItems(
131:     state.knowledge
132:       .map(
133:         (knowledge) =>
134:           createObservation(
135:             knowledge.text,
136:             knowledge.score,
137:             "knowledge"
138:           )
139:       )
140:       .filter(
141:         (observation) =>
142:           observation.statement
143:             .length > 0
144:       )
145:   );
146: }
147: 
148: function buildGraphObservations(
149:   state: BrainState
150: ): ReasoningObservation[] {
151:   const nodesById =
152:     new Map<
153:       string,
154:       GraphNode
155:     >(
156:       state.graph.map(
157:         (node) => [
158:           node.id,
159:           node,
160:         ]
161:       )
162:     );
163: 
164:   const edges:
165:     GraphEdge[] =
166:     limitItems(
167:       state.graphEdges
168:     );
169: 
170:   return edges
171:     .map(
172:       (edge) => {
173:         const from =
174:           nodesById.get(
175:             edge.from
176:           );
177: 
178:         const to =
179:           nodesById.get(
180:             edge.to
181:           );
182: 
183:         if (
184:           !from ||
185:           !to
186:         ) {
187:           return null;
188:         }
189: 
190:         return createObservation(
191:           `${from.label} ${edge.type} ${to.label}.`,
192:           Math.max(
193:             0,
194:             Math.min(
195:               1,
196:               edge.weight
197:             )
198:           ),
199:           "knowledge_graph",
200:           "observed_relationship"
201:         );
202:       }
203:     )
204:     .filter(
205:       (
206:         observation
207:       ): observation is ReasoningObservation =>
208:         Boolean(
209:           observation
210:         )
211:     );
212: }
213: 
214: function buildTimelineObservations(
215:   state: BrainState
216: ): ReasoningObservation[] {
217:   return limitItems(
218:     state.timeline
219:       .filter(
220:         Boolean
221:       )
222:       .map(
223:         (event) =>
224:           createObservation(
225:             event,
226:             0.85,
227:             "timeline"
228:           )
229:       )
230:   );
231: }
232: 
233: function buildReflectionObservations(
234:   state: BrainState
235: ): ReasoningObservation[] {
236:   return limitItems(
237:     state.reflections
238:       .filter(
239:         Boolean
240:       )
241:       .map(
242:         (reflection) =>
243:           createObservation(
244:             reflection,
245:             0.8,
246:             "reflection",
247:             "derived_inference"
248:           )
249:       )
250:   );
251: }
252: 
253: function buildPredictionObservations(
254:   state: BrainState
255: ): ReasoningObservation[] {
256:   return limitItems(
257:     state.predictions
258:       .map(
259:         (prediction) =>
260:           createObservation(
261:             prediction.statement,
262:             prediction.confidence,
263:             "prediction",
264:             "derived_inference"
265:           )
266:       )
267:   );
268: }
269: 
270: function buildLiveKnowledgeObservations(
271:   state: BrainState
272: ): ReasoningObservation[] {
273:   return limitItems(
274:     state.liveKnowledge
275:       .filter(
276:         Boolean
277:       )
278:       .map(
279:         (knowledge) =>
280:           createObservation(
281:             knowledge,
282:             0.95,
283:             "live_knowledge"
284:           )
285:       )
286:   );
287: }
288: 
289: function buildObservations(
290:   state: BrainState
291: ): ReasoningObservation[] {
292:   return [
293:     ...buildMemoryObservations(
294:       state
295:     ),
296: 
297:     ...buildKnowledgeObservations(
298:       state
299:     ),
300: 
301:     ...buildGraphObservations(
302:       state
303:     ),
304: 
305:     ...buildTimelineObservations(
306:       state
307:     ),
308: 
309:     ...buildReflectionObservations(
310:       state
311:     ),
312: 
313:     ...buildPredictionObservations(
314:       state
315:     ),
316: 
317:     ...buildLiveKnowledgeObservations(
318:       state
319:     ),
320:   ];
321: }
322: 
323: export function reason(
324:   state: BrainState
325: ): ReasoningResult {
326:   const observations =
327:     buildObservations(
328:       state
329:     );
330: 
331:   const userRequest =
332:     normalize(
333:       state.userMessage
334:     );
335: 
336:   const summary =
337:     observations.length > 0
338:       ? `The request "${userRequest}" can be answered using the available cognitive context and ${observations.length} relevant observations.`
339:       : `The request "${userRequest}" does not currently have additional structured reasoning evidence.`;
340: 
341:   const confidence =
342:     observations.length === 0
343:       ? 0.5
344:       : observations.reduce(
345:           (
346:             total,
347:             observation
348:           ) =>
349:             total +
350:             observation.confidence,
351:           0
352:         ) /
353:         observations.length;
354: 
355:   return {
356:     summary,
357: 
358:     observations,
359: 
360:     confidence,
361:   };
362: }
</file>

