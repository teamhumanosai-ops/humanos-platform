<file path="frontend/features/onboarding/OnboardingFlow.tsx">
 1: "use client";
 2: 
 3: import { useMemo, useState } from "react";
 4: 
 5: import OnboardingStep from "./OnboardingStep";
 6: 
 7: export interface OnboardingAnswers {
 8:   name: string;
 9:   mission: string;
10:   goal: string;
11:   communicationStyle: string;
12: }
13: 
14: interface OnboardingFlowProps {
15:   onComplete: (answers: OnboardingAnswers) => void;
16: }
17: 
18: const STEPS = [
19:   {
20:     key: "name",
21:     title: "What's your name?",
22:     description: "I'd like to know what to call you.",
23:     placeholder: "Enter your name...",
24:   },
25:   {
26:     key: "mission",
27:     title: "What are you building?",
28:     description: "Tell me your current mission.",
29:     placeholder: "Human OS",
30:   },
31:   {
32:     key: "goal",
33:     title: "What's your biggest goal this year?",
34:     description: "Dream big.",
35:     placeholder: "Build the world's first AI Operating System",
36:   },
37:   {
38:     key: "communicationStyle",
39:     title: "How should I communicate with you?",
40:     description: "Examples: Direct, Friendly, Coach, Mentor",
41:     placeholder: "Direct",
42:   },
43: ] as const;
44: 
45: export default function OnboardingFlow({
46:   onComplete,
47: }: OnboardingFlowProps) {
48:   const [stepIndex, setStepIndex] = useState(0);
49: 
50:   const [answers, setAnswers] = useState<OnboardingAnswers>({
51:     name: "",
52:     mission: "",
53:     goal: "",
54:     communicationStyle: "",
55:   });
56: 
57:   const step = STEPS[stepIndex];
58: 
59:   const value = useMemo(() => {
60:     return answers[step.key];
61:   }, [answers, step]);
62: 
63:   function update(value: string) {
64:     setAnswers((previous) => ({
65:       ...previous,
66:       [step.key]: value,
67:     }));
68:   }
69: 
70:   function next() {
71:     if (stepIndex === STEPS.length - 1) {
72:       onComplete(answers);
73:       return;
74:     }
75: 
76:     setStepIndex((previous) => previous + 1);
77:   }
78: 
79:   return (
80:     <OnboardingStep
81:       title={step.title}
82:       description={step.description}
83:       placeholder={step.placeholder}
84:       value={value}
85:       onChange={update}
86:       onNext={next}
87:       canContinue={value.trim().length > 0}
88:     />
89:   );
90: }
</file>

