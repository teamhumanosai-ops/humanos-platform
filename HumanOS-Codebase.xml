  3: } from "@/brain/systemPrompt";
  4: 
  5: import {
  6:   buildMemoryPrompt,
  7: } from "@/brain/memory";
  8: 
  9: import {
 10:   generateAIResponse,
 11: } from "@/lib/aiService";
 12: 
 13: type ChatMessage = {
 14:   role:
 15:     | "user"
 16:     | "assistant";
 17: 
 18:   message:
 19:     string;
 20: };
 21: 
 22: function hasLiveEvidence(
 23:   systemContext: string
 24: ): boolean {
 25:   return (
 26:     systemContext.includes(
 27:       "LIVE WEB SEARCH EXECUTED."
 28:     ) ||
 29:     systemContext.includes(
 30:       "LIVE KNOWLEDGE POLICY:"
 31:     )
 32:   );
 33: }
 34: 
 35: function buildLiveKnowledgePolicy(
 36:   systemContext: string
 37: ): string {
 38:   if (
 39:     !hasLiveEvidence(
 40:       systemContext
 41:     )
 42:   ) {
 43:     return "";
 44:   }
 45: 
 46:   return `
 47: LIVE KNOWLEDGE POLICY
 48: 
 49: This request was explicitly routed through the Human OS Live Knowledge system.
 50: 
 51: The supplied web evidence is the primary source of truth for current facts.
 52: 
 53: Your pretrained knowledge can be outdated and MUST NOT override the supplied current evidence.
 54: 
 55: Do not say that you lack real-time access.
 56: 
 57: Do not invent current facts.
 58: 
 59: Do not invent sources.
 60: 
 61: When making a factual claim from the supplied evidence, associate it with the corresponding source number, such as [1] or [2].
 62: 
 63: Use only source numbers that actually exist in the supplied evidence.
 64: 
 65: If sources disagree, explain the disagreement instead of silently choosing one.
 66: 
 67: If the evidence is insufficient to answer confidently, say that the available evidence is insufficient.
 68: 
 69: Keep source references compact and factual.
 70: `;
 71: }
 72: 
 73: async function buildSystemMessage(
 74:   systemContext: string
 75: ): Promise<string> {
 76:   const memoryPrompt =
 77:     await buildMemoryPrompt();
 78: 
 79:   const liveKnowledgePolicy =
 80:     buildLiveKnowledgePolicy(
 81:       systemContext
 82:     );
 83: 
 84:   return [
 85:     SYSTEM_PROMPT,
 86:     memoryPrompt,
 87:     systemContext,
 88:     liveKnowledgePolicy,
 89:   ]
 90:     .filter(
 91:       (
 92:         value
 93:       ) =>
 94:         value.trim()
 95:           .length > 0
 96:     )
 97:     .join(
 98:       "\n\n"
 99:     );
100: }
101: 
102: export async function aiService(
