import type { MemoryAnalysis } from "./intelligence";

import { entityAnalyzer } from "./EntityAnalyzer";

import {
  relationshipAnalyzer,
} from "./RelationshipAnalyzer";

export interface MemoryAnalyzer {
  analyze(
    key: string,
    value: string,
    analysis: MemoryAnalysis
  ): MemoryAnalysis;
}

export class MemoryAnalysisPipeline {
  constructor(
    private readonly analyzers: MemoryAnalyzer[]
  ) {}

  run(
    key: string,
    value: string,
    initial: MemoryAnalysis
  ): MemoryAnalysis {
    return this.analyzers.reduce(
      (
        analysis,
        analyzer
      ) =>
        analyzer.analyze(
          key,
          value,
          analysis
        ),
      initial
    );
  }
}

export const memoryAnalysisPipeline =
  new MemoryAnalysisPipeline([
    entityAnalyzer,
    relationshipAnalyzer,
  ]);
</file>

<file path="frontend/brain/memory/retrieval.ts">
import { loadMemories } from "./store";
import type { Memory } from "./types";
import { semanticScore } from "./semantic";

export async function retrieveRelevantMemories(
  query = "",
  limit = 10
): Promise<Memory[]> {
  const memories = await loadMemories();

  return memories
    .map((memory) => ({
      memory,
      score:
        semanticScore(memory, query) +
        memory.importance,
    }))
    .sort((a, b) => {
      if (a.score !== b.score) {
        return b.score - a.score;
      }

      if (
        a.memory.kind === "long_term" &&
        b.memory.kind !== "long_term"
      ) {
        return -1;
      }

      if (
        a.memory.kind !== "long_term" &&
        b.memory.kind === "long_term"
      ) {
        return 1;
      }

      return a.memory.key.localeCompare(
        b.memory.key
      );
    })
    .slice(0, limit)
    .map((entry) => entry.memory);
}
</file>

<file path="frontend/brain/runtime/steps/decisionStage.ts">
import {
  BrainState,
} from "../../brainState";

import {
  getBestDecision,
} from "../../decision";

import {
  getPlan,
} from "../../planning";

import {
  BaseStage,
} from "./baseStage";

/**
 * DecisionStage
 *
 * Integrates the existing Decision Engine
 * into the Cognitive Runtime.
 *
 * The Decision Engine remains authoritative
 * for selecting the action.
 *
 * BrainState reasoning evidence is preserved
 * alongside the resulting decision so later
 * runtime stages can understand the cognitive
 * evidence that preceded the decision.
 */
export class DecisionStage
  extends BaseStage {
  readonly name =
    "Decision";

  protected async process(
    state: BrainState
  ): Promise<BrainState> {
    /*
    |--------------------------------------------------------------------------
    | A local skill response does not require
    | decision generation.
    |--------------------------------------------------------------------------
    */

    if (
      state.response
    ) {
      return state;
    }

    /*
    |--------------------------------------------------------------------------
    | Decision requires an active plan.
    |--------------------------------------------------------------------------
    */

    if (
      !state.currentPlanId
    ) {
      return state;
    }

    const plan =
      getPlan(
        state.currentPlanId
      );

    if (!plan) {
      return state;
    }

    /*
    |--------------------------------------------------------------------------
    | Existing Decision Engine
    |--------------------------------------------------------------------------
    |
    | The engine remains responsible for selecting
    | the best action from the current plan.
    |
    */

    const decision =
      getBestDecision(
        plan
      );

    state.currentDecisionId =
      decision.id;

    /*
    |--------------------------------------------------------------------------
    | Structured reasoning evidence
    |--------------------------------------------------------------------------
    |
    | Preserve the reasoning signals that were
    | available before the decision was created.
    |
    */

    const reasoningEvidence =
      state.reasoningObservations
        .map(
          (
            observation,
            index
          ) =>
            `${index + 1}. [${
              observation.source
            }] ${
              observation.statement
            } (confidence ${
              observation.confidence.toFixed(
                2
              )
            })`
        );

    /*
    |--------------------------------------------------------------------------
    | Decision artifact
    |--------------------------------------------------------------------------
    */

    state.decision =
      [
        `Decision: ${decision.title}`,

        `Description: ${decision.description}`,

        `Selected Action: ${decision.selectedAction}`,

        "Alternatives:",

        ...decision.alternatives.map(
          (
            alternative,
            index
          ) =>
            `${index + 1}. ${alternative}`
        ),

        `Reason: ${decision.reason}`,

        `Confidence: ${decision.confidence}`,

        ...(reasoningEvidence.length > 0
          ? [
              "",

              "Reasoning Evidence:",

              ...reasoningEvidence,
            ]
          : []),

        ...(state.reasoningConfidence > 0
          ? [
              "",

              `Overall Reasoning Confidence: ${state.reasoningConfidence.toFixed(
                2
              )}`,
            ]
          : []),
      ].join("\n");

    return state;
  }
}
</file>

<file path="frontend/brain/runtime/steps/liveKnowledgeStage.ts">
import { BrainState } from "../../brainState";
import { Intent } from "../../intent";

import {
  buildCitationSources,
} from "../../websearch/citations";

import type {
  RuntimeServices,
} from "../runtimeServices";

import { BaseStage } from "./baseStage";

export class LiveKnowledgeStage
  extends BaseStage {
  readonly name =
    "LiveKnowledge";

  constructor(
    private readonly services:
      RuntimeServices
  ) {
    super();
  }

  protected async process(
    state: BrainState
  ): Promise<BrainState> {
    if (
      state.intent !==
      Intent.LIVE_SEARCH
    ) {
      return state;
    }

    try {
      const search =
        await this.services.searchWeb(
          state.userMessage
        );

      state.citations =
        buildCitationSources(
          search.results
        );

      const evidence =
        search.results.map(
          (result, index) =>
            `[${index + 1}]
Title: ${result.title}
URL: ${result.url}
Published: ${
              result.publishedDate ??
              "unknown"
            }
Evidence: ${result.snippet}`
        );

      state.liveKnowledge = [
        [
          "LIVE WEB SEARCH EXECUTED.",

          `Search time: ${search.searchedAt}`,

          `Search query: ${search.query}`,

          search.answer
            ? `Search synthesis:\n${search.answer}`
            : "No search synthesis was returned.",

          evidence.length > 0
            ? `Evidence:\n\n${evidence.join(
                "\n\n"
              )}`
            : "No usable evidence was returned.",
        ].join("\n\n"),
      ];

      return state;
    } catch (error) {
      const message =
        error instanceof Error
          ? error.message
          : String(error);

      state.citations = [];

      state.liveKnowledge = [];

      state.errors.push(
        `LiveKnowledge: ${message}`
      );

      state.response =
        "I couldn't retrieve current web information for that request. Please try again in a moment.";

      return state;
    }
  }
}
</file>

<file path="frontend/brain/runtime/steps/responseValidationStage.ts">
import {
  BrainState,
} from "../../brainState";

import {
  BaseStage,
} from "./baseStage";

/**
 * ResponseValidationStage
 *
 * Performs deterministic validation of the generated
 * response before the runtime finalizes the outcome.
 *
 * This stage does not attempt to judge whether the
 * model's answer is factually correct.
 *
 * Its purpose is to detect structural response failures
 * that the runtime can identify deterministically,
 * including evidence-grounding failures.
 */
export class ResponseValidationStage
  extends BaseStage {
  readonly name =
    "ResponseValidation";

  protected async process(
    state: BrainState
  ): Promise<BrainState> {
    if (!state.response) {
      state.errors.push(
        "ResponseValidation: no response was generated."
      );

      return state;
    }

    const response =
      state.response.trim();

    if (response.length === 0) {
      state.errors.push(
        "ResponseValidation: generated response is empty."
      );

      return state;
    }

    /*
    |--------------------------------------------------------------------------
    | Current-information validation
    |--------------------------------------------------------------------------
    |
    | If live evidence was retrieved, the response should
    | not claim that no information was found.
    |
    */

    if (
      state.liveKnowledge.length > 0 &&
      this.isUnsupportedNoInformationResponse(
        response
      )
    ) {
      state.errors.push(
        "ResponseValidation: response contradicts available live evidence."
      );
    }

    /*
    |--------------------------------------------------------------------------
    | Citation validation
    |--------------------------------------------------------------------------
    |
    | When citation sources exist, every citation marker
    | used by the response must correspond to an actual
    | citation supplied by the runtime.
    |
    | This prevents the model from inventing citation
    | numbers such as [7] when only [1] and [2] exist.
    |
    */

    if (
      state.citations.length > 0
    ) {
      const citationMarkers =
        this.extractCitationMarkers(
          response
        );

      const validCitationIndexes =
        new Set(
          state.citations.map(
            (citation) =>
              citation.index
          )
        );

      const invalidMarkers =
        citationMarkers.filter(
          (index) =>
            !validCitationIndexes.has(
              index
            )
        );

      for (
        const index of
        new Set(invalidMarkers)
      ) {
        state.errors.push(
          `ResponseValidation: response contains unsupported citation marker [${index}].`
        );
      }

      /*
      |--------------------------------------------------------------------------
      | Evidence usage
      |--------------------------------------------------------------------------
      |
      | For live/current-information responses, the
      | presence of retrieved citation evidence should
      | normally result in at least one valid citation
      | marker in the generated response.
      |
      | We intentionally do not require citations for
      | every sentence because deterministic validation
      | cannot safely determine which individual claims
      | require which source.
      |
      */

      if (
        state.liveKnowledge.length > 0 &&
        citationMarkers.length === 0
      ) {
        state.errors.push(
          "ResponseValidation: live evidence is available but the response contains no citation markers."
        );
      }
    }

    return state;
  }

  private extractCitationMarkers(
    response: string
  ): number[] {
    const markers: number[] = [];

    const pattern =
      /\[(\d+)\]/g;

    let match =
      pattern.exec(
        response
      );

    while (
      match
    ) {
      markers.push(
        Number(
          match[1]
        )
      );

      match =
        pattern.exec(
          response
        );
    }

    return markers;
  }

  private isUnsupportedNoInformationResponse(
    response: string
  ): boolean {
    const normalized =
      response.toLowerCase();

    const indicators = [
      "i don't have access to current information",
      "i do not have access to current information",
      "i can't access the web",
      "i cannot access the web",
      "i don't have access to the web",
      "i do not have access to the web",
      "i cannot browse the web",
      "i can't browse the web",
    ];

    return indicators.some(
      (indicator) =>
        normalized.includes(
          indicator
        )
    );
  }
}
</file>

