import { desc } from "drizzle-orm";

import { db } from "@/database/db";
import { timelineEvents } from "@/database/schema";

import {
  timelineGraphAdapter,
} from "../graph/TimelineGraphAdapter";

import type {
  TimelineCategory,
  TimelineEvent,
} from "./types";

export async function saveTimelineEvent(
  event: TimelineEvent
): Promise<void> {
  await db.insert(
    timelineEvents
  ).values({
    timestamp:
      event.timestamp,

    title:
      event.title,

    description:
      event.description,

    category:
      event.category,

    confidence:
      event.confidence,

    source:
      event.source,

    createdAt:
      event.createdAt,
  });

  /*
  |--------------------------------------------------------------------------
  | Synchronize the persisted Timeline event
  | with the Knowledge Graph.
  |--------------------------------------------------------------------------
  |
  | The database remains the Timeline persistence
  | source of truth. The graph is a cognitive
  | representation of the same event.
  |
  */

  timelineGraphAdapter.sync(
    event
  );
}

export async function loadTimelineEvents():
  Promise<TimelineEvent[]> {
  const events =
    await db
      .select()
      .from(
        timelineEvents
      )
      .orderBy(
        desc(
          timelineEvents.timestamp
        )
      );

  return events.map(
    (event) => ({
      ...event,

      category:
        event.category as TimelineCategory,
    })
  );
}
</file>

<file path="frontend/brain/uce/ContentEngine.ts">
import {
    Artifact,
    ArtifactMetadata,
} from "../content/models";

import { ArtifactDetector } from "../content/detectors";

import {
    ProcessingContext,
    ProcessingPipeline,
} from "../content/pipeline";

import { ProcessingResult } from "../content/processing";

export interface ContentEngineRequest {
    input?: string;

    filename?: string;

    mimeType?: string;

    content?: Buffer | string;
}

export class ContentEngine {
    static async process(
        request: ContentEngineRequest
    ): Promise<ProcessingResult> {
        const artifactType = ArtifactDetector.detect(request);

        const now = new Date();

        const metadata: ArtifactMetadata = {
            id: crypto.randomUUID(),

            name: request.filename ?? "Untitled",

            type: artifactType,

            mimeType: request.mimeType ?? "",

            extension:
                request.filename
                    ?.split(".")
                    .pop()
                    ?.toLowerCase() ?? "",

            size: 0,

            createdAt: now,

            updatedAt: now,
        };

        const artifact: Artifact = {
            metadata,

            rawContent: request.content,

            tags: [],

            attributes: {},
        };

        const context: ProcessingContext = {
            artifact,

            startedAt: now,

            metadata: {},
        };

        return ProcessingPipeline.execute(context);
    }
}
</file>

