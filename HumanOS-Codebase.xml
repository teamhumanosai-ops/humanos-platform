<file path="frontend/brain/ai/embeddings/openrouter.ts">
 1: import { BaseEmbeddingProvider } from "./provider";
 2: import {
 3:   EmbeddingResult,
 4:   EmbeddingOptions,
 5: } from "./types";
 6: 
 7: export class OpenRouterEmbeddingProvider extends BaseEmbeddingProvider {
 8:   readonly id = "openrouter";
 9: 
10:   readonly type = "embedding" as const;
11: 
12:   readonly name = "OpenRouter";
13: 
14:   async embed(
15:     text: string,
16:     options?: EmbeddingOptions
17:   ): Promise<EmbeddingResult> {
18:     const apiKey = process.env.OPENROUTER_API_KEY;
19: 
20:     if (!apiKey) {
21:       throw new Error("OPENROUTER_API_KEY is missing.");
22:     }
23: 
24:     const response = await fetch(
25:       "https://openrouter.ai/api/v1/embeddings",
26:       {
27:         method: "POST",
28:         headers: {
29:           Authorization: `Bearer ${apiKey}`,
30:           "Content-Type": "application/json",
31:         },
32:         body: JSON.stringify({
33:           model:
34:             options?.model ??
35:             "openai/text-embedding-3-small",
36:           input: text,
37:         }),
38:       }
39:     );
40: 
41:     if (!response.ok) {
42:       const error = await response.text();
43: 
44:       throw new Error(
45:         `OpenRouter Embedding Error: ${error}`
46:       );
47:     }
48: 
49:     const json = await response.json();
50: 
51:     const vector = json.data?.[0]?.embedding;
52: 
53:     if (!Array.isArray(vector)) {
54:       throw new Error(
55:         "Invalid embedding response from OpenRouter."
56:       );
57:     }
58: 
59:     return {
60:       vector,
61:       dimensions: vector.length,
62:       model:
63:         options?.model ??
64:         "openai/text-embedding-3-small",
65:     };
66:   }
67: }
</file>

