<file path="frontend/brain/knowledge/retrievalPipeline.ts">
 1: import { searchKnowledge } from "./search";
 2: import { semanticSearch } from "./semanticSearch";
 3: 
 4: export interface RetrievalResult {
 5:   source: string;
 6:   text: string;
 7:   score: number;
 8: }
 9: 
10: export class RetrievalPipeline {
11:   async execute(
12:     query: string,
13:     topK: number = 5
14:   ): Promise<RetrievalResult[]> {
15:     console.log("");
16:     console.log("🧠 Human OS Hybrid Retrieval");
17:     console.log("----------------------------");
18: 
19:     const keyword = searchKnowledge(query);
20: 
21:     const semantic = await semanticSearch(query, topK);
22: 
23:     const fused = new Map<string, RetrievalResult>();
24: 
25:     const K = 60;
26: 
27:     keyword.forEach((item, index) => {
28:       const key = item.chunk.text;
29: 
30:       fused.set(key, {
31:         source: item.chunk.source,
32:         text: item.chunk.text,
33:         score: 1 / (K + index + 1),
34:       });
35:     });
36: 
37:     semantic.forEach((item, index) => {
38:       const key = item.chunk;
39: 
40:       const score = 1 / (K + index + 1);
41: 
42:       const existing = fused.get(key);
43: 
44:       if (existing) {
45:         existing.score += score;
46:       } else {
47:         fused.set(key, {
48:           source: item.source,
49:           text: item.chunk,
50:           score,
51:         });
52:       }
53:     });
54: 
55:     return [...fused.values()]
56:       .sort((a, b) => b.score - a.score)
57:       .slice(0, topK);
58:   }
59: }
60: 
61: export const retrievalPipeline =
62:   new RetrievalPipeline();
</file>

