<file path="frontend/brain/memory/RelationshipAnalyzer.ts">
  1: import type { MemoryAnalysis } from "./intelligence";
  2: import type { MemoryAnalyzer } from "./pipeline";
  3: 
  4: export type ExtractedRelationship = {
  5:   subject: string;
  6:   predicate: string;
  7:   object: string;
  8:   confidence: number;
  9: };
 10: 
 11: type RelationshipPattern = {
 12:   pattern: RegExp;
 13:   predicate: string;
 14: };
 15: 
 16: const RELATIONSHIP_PATTERNS: RelationshipPattern[] = [
 17:   {
 18:     pattern:
 19:       /^(.+?)\s+uses\s+(.+)$/i,
 20:     predicate: "uses",
 21:   },
 22:   {
 23:     pattern:
 24:       /^(.+?)\s+use\s+(.+)$/i,
 25:     predicate: "uses",
 26:   },
 27:   {
 28:     pattern:
 29:       /^(.+?)\s+built\s+with\s+(.+)$/i,
 30:     predicate: "built_with",
 31:   },
 32:   {
 33:     pattern:
 34:       /^(.+?)\s+builds?\s+with\s+(.+)$/i,
 35:     predicate: "built_with",
 36:   },
 37:   {
 38:     pattern:
 39:       /^(.+?)\s+depends\s+on\s+(.+)$/i,
 40:     predicate: "depends_on",
 41:   },
 42:   {
 43:     pattern:
 44:       /^(.+?)\s+is\s+based\s+on\s+(.+)$/i,
 45:     predicate: "based_on",
 46:   },
 47:   {
 48:     pattern:
 49:       /^(.+?)\s+created\s+by\s+(.+)$/i,
 50:     predicate: "created_by",
 51:   },
 52:   {
 53:     pattern:
 54:       /^(.+?)\s+was\s+created\s+by\s+(.+)$/i,
 55:     predicate: "created_by",
 56:   },
 57:   {
 58:     pattern:
 59:       /^(.+?)\s+works\s+with\s+(.+)$/i,
 60:     predicate: "works_with",
 61:   },
 62:   {
 63:     pattern:
 64:       /^(.+?)\s+integrates\s+with\s+(.+)$/i,
 65:     predicate: "integrates_with",
 66:   },
 67:   {
 68:     pattern:
 69:       /^(.+?)\s+is\s+part\s+of\s+(.+)$/i,
 70:     predicate: "part_of",
 71:   },
 72:   {
 73:     pattern:
 74:       /^(.+?)\s+belongs\s+to\s+(.+)$/i,
 75:     predicate: "belongs_to",
 76:   },
 77: ];
 78: 
 79: function clean(value: string): string {
 80:   return value
 81:     .trim()
 82:     .replace(/[.!?,;:]+$/g, "")
 83:     .trim();
 84: }
 85: 
 86: function normalizePredicate(
 87:   predicate: string
 88: ): string {
 89:   return predicate
 90:     .trim()
 91:     .toLowerCase()
 92:     .replace(/\s+/g, "_");
 93: }
 94: 
 95: export class RelationshipAnalyzer
 96:   implements MemoryAnalyzer
 97: {
 98:   analyze(
 99:     key: string,
100:     value: string,
101:     analysis: MemoryAnalysis
102:   ): MemoryAnalysis {
103:     const relationships: ExtractedRelationship[] =
104:       [];
105: 
106:     for (const relationshipPattern of RELATIONSHIP_PATTERNS) {
107:       const match =
108:         relationshipPattern.pattern.exec(
109:           clean(value)
110:         );
111: 
112:       if (!match) {
113:         continue;
114:       }
115: 
116:       const subject = clean(
117:         match[1]
118:       );
119: 
120:       const object = clean(
121:         match[2]
122:       );
123: 
124:       if (
125:         subject.length === 0 ||
126:         object.length === 0
127:       ) {
128:         continue;
129:       }
130: 
131:       relationships.push({
132:         subject,
133:         predicate:
134:           normalizePredicate(
135:             relationshipPattern.predicate
136:           ),
137:         object,
138:         confidence: 0.8,
139:       });
140: 
141:       break;
142:     }
143: 
144:     return {
145:       ...analysis,
146:       relationships:
147:         relationships.length > 0
148:           ? relationships
149:           : analysis.relationships,
150:     };
151:   }
152: }
153: 
154: export const relationshipAnalyzer =
155:   new RelationshipAnalyzer();
</file>

