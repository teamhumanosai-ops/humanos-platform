 30: 
 31: function createEdge(
 32:   from: string,
 33:   to: string,
 34:   type: GraphEdge["type"],
 35:   weight = 1,
 36:   properties: Record<string, unknown> = {}
 37: ): GraphEdge {
 38:   return {
 39:     id: `${from}:${type}:${to}`,
 40:     from,
 41:     to,
 42:     type,
 43:     weight,
 44:     properties,
 45:     createdAt: now(),
 46:   };
 47: }
