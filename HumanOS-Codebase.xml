101: /**
102:  * CognitiveRuntime
103:  *
104:  * Owns the canonical Human OS cognitive lifecycle.
105:  *
106:  * The runtime is responsible for:
107:  *
108:  * - Stage registration
109:  * - Deterministic stage ordering
110:  * - Stage execution
111:  * - Failure propagation
112:  * - Outcome finalization
113:  * - Reflection finalization
114:  *
115:  * BrainState remains the shared cognitive state.
116:  *
117:  * Domain engines remain responsible for
118:  * domain-specific behavior.
119:  */
120: export class CognitiveRuntime {
121:   private readonly stages:
122:     Stage[] = [];
123: 
124:   constructor(
125:     public readonly services:
126:       RuntimeServices
127:   ) {
128:     /*
129:     |--------------------------------------------------------------------------
130:     | Input
131:     |--------------------------------------------------------------------------
132:     */
133: 
134:     this.register(
135:       new InputStage()
136:     );
137: 
138:     /*
139:     |--------------------------------------------------------------------------
140:     | Intent
141:     |--------------------------------------------------------------------------
142:     */
143: 
144:     this.register(
145:       new IntentStage()
146:     );
147: 
148:     /*
149:     |--------------------------------------------------------------------------
150:     | Live Knowledge
151:     |--------------------------------------------------------------------------
152:     */
153: 
154:     this.register(
155:       new LiveKnowledgeStage(
156:         this.services
157:       )
158:     );
159: 
160:     /*
161:     |--------------------------------------------------------------------------
162:     | Memory Extraction
163:     |--------------------------------------------------------------------------
164:     */
165: 
166:     this.register(
167:       new MemoryExtractionStage()
168:     );
169: 
170:     /*
171:     |--------------------------------------------------------------------------
172:     | Timeline Extraction
173:     |--------------------------------------------------------------------------
174:     */
175: 
176:     this.register(
177:       new TimelineExtractionStage()
178:     );
179: 
180:     /*
181:     |--------------------------------------------------------------------------
182:     | Memory Retrieval
183:     |--------------------------------------------------------------------------
184:     */
185: 
186:     this.register(
187:       new MemoryStage()
188:     );
189: 
190:     /*
191:     |--------------------------------------------------------------------------
192:     | Unified BrainState
193:     |--------------------------------------------------------------------------
194:     */
195: 
196:     this.register(
197:       new BrainStateStage()
198:     );
199: 
200:     /*
201:     |--------------------------------------------------------------------------
202:     | Reasoning Graph
203:     |--------------------------------------------------------------------------
204:     */
205: 
206:     this.register(
207:       new ReasoningGraphStage()
208:     );
209: 
210:     /*
211:     |--------------------------------------------------------------------------
212:     | Prediction
213:     |--------------------------------------------------------------------------
214:     */
215: 
216:     this.register(
217:       new PredictionStage()
218:     );
219: 
220:     /*
221:     |--------------------------------------------------------------------------
222:     | Local Skills
223:     |--------------------------------------------------------------------------
224:     */
225: 
226:     this.register(
227:       new SkillStage()
228:     );
229: 
230:     /*
231:     |--------------------------------------------------------------------------
232:     | Context
233:     |--------------------------------------------------------------------------
234:     */
235: 
236:     this.register(
237:       new ContextStage()
238:     );
239: 
240:     /*
241:     |--------------------------------------------------------------------------
242:     | Reasoning
243:     |--------------------------------------------------------------------------
244:     */
245: 
246:     this.register(
247:       new ReasoningStage()
248:     );
249: 
250:     /*
251:     |--------------------------------------------------------------------------
252:     | Inference
253:     |--------------------------------------------------------------------------
254:     */
255: 
256:     this.register(
257:       new InferenceStage()
258:     );
259: 
260:     /*
261:     |--------------------------------------------------------------------------
262:     | Planning
263:     |--------------------------------------------------------------------------
264:     */
265: 
266:     this.register(
267:       new PlanningStage()
268:     );
269: 
270:     /*
271:     |--------------------------------------------------------------------------
272:     | Decision
273:     |--------------------------------------------------------------------------
274:     */
275: 
276:     this.register(
277:       new DecisionStage()
278:     );
279: 
280:     /*
281:     |--------------------------------------------------------------------------
282:     | Validation
283:     |--------------------------------------------------------------------------
284:     */
285: 
286:     this.register(
287:       new ValidationStage()
288:     );
289: 
290:     /*
291:     |--------------------------------------------------------------------------
292:     | Execution
293:     |--------------------------------------------------------------------------
294:     */
295: 
296:     this.register(
297:       new ExecutionStage()
298:     );
299: 
300:     /*
301:     |--------------------------------------------------------------------------
302:     | Response
303:     |--------------------------------------------------------------------------
304:     */
305: 
306:     this.register(
307:       new ResponseStage()
308:     );
309: 
310:     /*
311:     |--------------------------------------------------------------------------
312:     | Response Validation
313:     |--------------------------------------------------------------------------
314:     */
315: 
316:     this.register(
317:       new ResponseValidationStage()
318:     );
319: 
320:     /*
321:     |--------------------------------------------------------------------------
322:     | Outcome
323:     |--------------------------------------------------------------------------
324:     */
325: 
326:     this.register(
327:       new OutcomeStage()
328:     );
329: 
330:     /*
331:     |--------------------------------------------------------------------------
332:     | Reflection
333:     |--------------------------------------------------------------------------
334:     */
335: 
336:     this.register(
337:       new ReflectionStage()
338:     );
339:   }
340: 
341:   /**
342:    * Register a cognitive stage.
343:    *
344:    * Every stage must have one canonical runtime owner.
345:    */
346:   register(
347:     stage: Stage
348:   ): void {
349:     const stageName =
350:       stage.name.trim();
351: 
352:     if (
353:       !stageName
354:     ) {
355:       throw new Error(
356:         "CognitiveRuntime cannot register a stage without a name."
357:       );
358:     }
359: 
360:     const duplicate =
361:       this.stages.some(
362:         (
363:           registeredStage
364:         ) =>
365:           registeredStage.name ===
366:           stageName
367:       );
368: 
369:     if (
370:       duplicate
371:     ) {
372:       throw new Error(
373:         `CognitiveRuntime cannot register duplicate stage "${stageName}".`
374:       );
375:     }
376: 
377:     this.stages.push(
378:       stage
379:     );
380:   }
381: 
382:   /**
383:    * Execute the canonical cognitive lifecycle.
384:    */
385:   async execute(
386:     state: BrainState
387:   ): Promise<BrainState> {
388:     let current =
389:       state;
390: 
391:     for (
392:       const stage of
393:       this.stages
394:     ) {
395:       try {
396:         current =
397:           await stage.execute(
398:             current
399:           );
400:       } catch {
401:         /*
402:         |--------------------------------------------------------------------------
403:         | Stage failure
404:         |--------------------------------------------------------------------------
405:         |
406:         | BaseStage already records:
407:         |
408:         | - executed stage
409:         | - error
410:         | - diagnostic
411:         |
412:         | Stop downstream cognitive processing so later
413:         | stages cannot operate on invalid state.
414:         |
415:         */
416: 
417:         current.runtimeStatus =
418:           "failed";
419: 
420:         break;
421:       }
422: 
423:       current.updatedAt =
424:         new Date();
425:     }
426: 
427:     /*
428:     |--------------------------------------------------------------------------
429:     | Outcome finalization
430:     |--------------------------------------------------------------------------
431:     |
432:     | If a stage failed before Outcome, execute the canonical
433:     | OutcomeStage once so the cognitive cycle still receives
434:     | a durable outcome artifact.
435:     |
436:     */
437: 
438:     if (
439:       !current.outcome
440:     ) {
441:       const outcomeStage =
442:         this.stages.find(
443:           (
444:             stage
445:           ) =>
446:             stage.name ===
447:             "Outcome"
448:         );
449: 
450:       if (
451:         outcomeStage
452:       ) {
453:         try {
454:           current =
455:             await outcomeStage.execute(
456:               current
457:             );
458:         } catch (
459:           error
460:         ) {
461:           const message =
462:             error instanceof Error
463:               ? error.message
464:               : String(error);
465: 
466:           current.errors.push(
467:             `Outcome: ${message}`
468:           );
469: 
470:           current.runtimeStatus =
471:             "failed";
472:         }
473:       }
474:     }
475: 
476:     /*
477:     |--------------------------------------------------------------------------
478:     | Reflection finalization
479:     |--------------------------------------------------------------------------
480:     |
481:     | Reflection is a post-processing feedback operation.
482:     |
483:     | It must not run after a failed cognitive cycle.
484:     |
485:     */
486: 
487:     const reflectionStage =
488:       this.stages.find(
489:         (
490:           stage
491:         ) =>
492:           stage.name ===
493:           "Reflection"
494:       );
495: 
496:     const reflectionExecuted =
497:       current.executedStages.includes(
498:         "Reflection"
499:       );
500: 
501:     const runtimeFailed =
502:       current.errors.length >
503:       0;
504: 
505:     if (
506:       reflectionStage &&
507:       !reflectionExecuted &&
508:       !runtimeFailed
509:     ) {
510:       try {
511:         current =
512:           await reflectionStage.execute(
513:             current
514:           );
515:       } catch (
516:         error
517:       ) {
518:         const message =
519:           error instanceof Error
520:             ? error.message
521:             : String(error);
522: 
523:         current.errors.push(
524:           `Reflection: ${message}`
525:         );
526: 
527:         /*
528:         |--------------------------------------------------------------------------
529:         | Outcome synchronization
530:         |--------------------------------------------------------------------------
531:         |
532:         | Outcome was finalized before Reflection.
533:         | If Reflection fails, synchronize the outcome
534:         | with the final runtime failure.
535:         |
536:         */
537: 
538:         current.outcome =
539:           createRuntimeOutcome({
540:             result:
541:               current.response,
542: 
543:             errors:
544:               current.errors,
545: 
546:             executionId:
547:               current.currentExecutionId,
548: 
549:             executionStatus:
550:               current.outcome
551:                 ?.metadata
552:                 .executionStatus ??
553:               null,
554: 
555:             planId:
556:               current.currentPlanId,
557: 
558:             decisionId:
559:               current.currentDecisionId,
560: 
561:             stagesExecuted:
562:               current.executedStages,
563:           });
564: 
565:         current.runtimeStatus =
566:           "failed";
567:       }
568:     }
569: 
570:     /*
571:     |--------------------------------------------------------------------------
572:     | Runtime timestamp
573:     |--------------------------------------------------------------------------
574:     */
575: 
576:     current.updatedAt =
577:       new Date();
578: 
579:     return current;
580:   }
581: 
582:   /**
583:    * Return the canonical runtime stage list.
584:    */
585:   getStages():
586:     readonly Stage[] {
587:     return this.stages;
588:   }
589: }
