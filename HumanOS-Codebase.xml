 78:       properties
 79:     );
 80: 
 81:     if (!graphStore.hasNode(id)) {
 82:       graphStore.addNode(node);
 83:     }
 84: 
 85:     return node;
 86:   }
 87: 
 88:   addKnowledge(
 89:     id: string,
 90:     label: string,
 91:     properties: Record<string, unknown> = {}
 92:   ): GraphNode {
 93:     const node = createNode(
 94:       id,
 95:       "knowledge",
 96:       label,
 97:       properties
 98:     );
 99: 
100:     if (!graphStore.hasNode(id)) {
101:       graphStore.addNode(node);
102:     }
103: 
104:     return node;
105:   }
106: 
107:   addEntity(
108:     id: string,
109:     label: string,
110:     properties: Record<string, unknown> = {}
111:   ): GraphNode {
112:     const node = createNode(
113:       id,
114:       "entity",
115:       label,
116:       properties
117:     );
118: 
119:     if (!graphStore.hasNode(id)) {
120:       graphStore.addNode(node);
121:     }
122: 
123:     return node;
124:   }
125: 
126:   connect(
127:     from: string,
128:     to: string,
129:     type: GraphEdge["type"] = "related_to",
130:     weight = 1,
131:     properties: Record<string, unknown> = {}
132:   ): void {
133:     const edgeId =
134:       `${from}:${type}:${to}`;
135: 
136:     if (graphStore.hasEdge(edgeId)) {
137:       return;
138:     }
139: 
140:     graphStore.addEdge(
141:       createEdge(
142:         from,
143:         to,
144:         type,
145:         weight,
146:         properties
147:       )
148:     );
149:   }
150: }
151: 
152: export const graphBuilder =
153:   new GraphBuilder();
