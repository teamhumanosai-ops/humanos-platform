<file path="frontend/brain/knowledge/cosineSimilarity.ts">
 1: export function cosineSimilarity(
 2:   a: number[],
 3:   b: number[]
 4: ): number {
 5:   if (a.length !== b.length) {
 6:     throw new Error(
 7:       "Embedding dimensions do not match."
 8:     );
 9:   }
10: 
11:   let dotProduct = 0;
12:   let magnitudeA = 0;
13:   let magnitudeB = 0;
14: 
15:   for (let i = 0; i < a.length; i++) {
16:     dotProduct += a[i] * b[i];
17:     magnitudeA += a[i] * a[i];
18:     magnitudeB += b[i] * b[i];
19:   }
20: 
21:   magnitudeA = Math.sqrt(magnitudeA);
22:   magnitudeB = Math.sqrt(magnitudeB);
23: 
24:   if (magnitudeA === 0 || magnitudeB === 0) {
25:     return 0;
26:   }
27: 
28:   return dotProduct / (magnitudeA * magnitudeB);
29: }
</file>

