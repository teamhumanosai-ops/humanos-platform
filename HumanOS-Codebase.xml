<file path="frontend/brain/reflection/store.ts">
 1: import { and, desc, eq } from "drizzle-orm";
 2: 
 3: import { db } from "@/database/db";
 4: import { reflections } from "@/database/schema";
 5: 
 6: import type { Reflection } from "./types";
 7: 
 8: export async function saveReflection(
 9:   reflection: Reflection
10: ): Promise<void> {
11:   const existing = await db
12:     .select()
13:     .from(reflections)
14:     .where(
15:       and(
16:         eq(reflections.summary, reflection.summary),
17:         eq(reflections.evidence, reflection.evidence)
18:       )
19:     )
20:     .limit(1);
21: 
22:   if (existing.length > 0) {
23:     return;
24:   }
25: 
26:   await db.insert(reflections).values({
27:     summary: reflection.summary,
28:     evidence: reflection.evidence,
29:     confidence: reflection.confidence,
30:     createdAt: reflection.createdAt,
31:   });
32: }
33: 
34: export async function loadReflections(): Promise<Reflection[]> {
35:   return db
36:     .select()
37:     .from(reflections)
38:     .orderBy(desc(reflections.createdAt));
39: }
