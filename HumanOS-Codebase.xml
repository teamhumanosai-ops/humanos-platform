 1: import {
 2:   GraphEdge,
 3:   GraphNode,
 4:   KnowledgeGraph,
 5: } from "./types";
 6: 
 7: class GraphStore {
 8:   private graph: KnowledgeGraph = {
 9:     nodes: new Map(),
10:     edges: new Map(),
11:   };
12: 
13:   getGraph(): KnowledgeGraph {
14:     return this.graph;
15:   }
16: 
17:   getNodes(): GraphNode[] {
18:     return [...this.graph.nodes.values()];
19:   }
20: 
21:   getEdges(): GraphEdge[] {
22:     return [...this.graph.edges.values()];
23:   }
24: 
25:   getNode(id: string): GraphNode | undefined {
26:     return this.graph.nodes.get(id);
27:   }
28: 
29:   getEdge(id: string): GraphEdge | undefined {
30:     return this.graph.edges.get(id);
31:   }
32: 
33:   addNode(node: GraphNode): void {
34:     this.graph.nodes.set(node.id, node);
35:   }
36: 
37:   addEdge(edge: GraphEdge): void {
38:     if (!this.graph.nodes.has(edge.from)) {
39:       throw new Error(
40:         `Graph node '${edge.from}' does not exist.`
41:       );
42:     }
43: 
44:     if (!this.graph.nodes.has(edge.to)) {
45:       throw new Error(
46:         `Graph node '${edge.to}' does not exist.`
47:       );
48:     }
49: 
50:     this.graph.edges.set(edge.id, edge);
51:   }
52: 
53:   hasNode(id: string): boolean {
54:     return this.graph.nodes.has(id);
55:   }
56: 
57:   hasEdge(id: string): boolean {
58:     return this.graph.edges.has(id);
59:   }
60: 
61:   removeNode(id: string): void {
62:     this.graph.nodes.delete(id);
63: 
64:     for (const [edgeId, edge] of this.graph.edges) {
65:       if (edge.from === id || edge.to === id) {
66:         this.graph.edges.delete(edgeId);
67:       }
68:     }
69:   }
70: 
71:   removeEdge(id: string): void {
72:     this.graph.edges.delete(id);
73:   }
74: 
75:   clear(): void {
76:     this.graph.nodes.clear();
77:     this.graph.edges.clear();
78:   }
79: }
80: 
81: export const graphStore = new GraphStore();
</file>

