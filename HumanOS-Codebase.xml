import {
  graphStore,
} from "./GraphStore";

import type {
  GraphEdge,
  GraphEdgeType,
  GraphNode,
} from "./types";

export class GraphQuery {
  getNode(
    id: string
  ): GraphNode | undefined {
    return graphStore.getNode(
      id
    );
  }

  getNodes(): GraphNode[] {
    return graphStore.getNodes();
  }

  getEdges(): GraphEdge[] {
    return graphStore.getEdges();
  }

  getNeighbors(
    nodeId: string
  ): GraphNode[] {
    const neighbors =
      new Map<
        string,
        GraphNode
      >();

    for (
      const edge of
      graphStore.getEdges()
    ) {
      if (
        edge.from === nodeId
      ) {
        const node =
          graphStore.getNode(
            edge.to
          );

        if (node) {
          neighbors.set(
            node.id,
            node
          );
        }
      }

      if (
        edge.to === nodeId
      ) {
        const node =
          graphStore.getNode(
            edge.from
          );

        if (node) {
          neighbors.set(
            node.id,
            node
          );
        }
      }
    }

    return [
      ...neighbors.values(),
    ];
  }

  getRelationships(
    nodeId: string
  ): GraphEdge[] {
    return graphStore
      .getEdges()
      .filter(
        (edge) =>
          edge.from === nodeId ||
          edge.to === nodeId
      );
  }

  getRelationshipsByType(
    nodeId: string,
    type: GraphEdgeType
  ): GraphEdge[] {
    return this.getRelationships(
      nodeId
    ).filter(
      (edge) =>
        edge.type === type
    );
  }

  getOutgoingRelationships(
    nodeId: string,
    type?: GraphEdgeType
  ): GraphEdge[] {
    return graphStore
      .getEdges()
      .filter(
        (edge) =>
          edge.from === nodeId &&
          (
            type === undefined ||
            edge.type === type
          )
      );
  }

  getIncomingRelationships(
    nodeId: string,
    type?: GraphEdgeType
  ): GraphEdge[] {
    return graphStore
      .getEdges()
      .filter(
        (edge) =>
          edge.to === nodeId &&
          (
            type === undefined ||
            edge.type === type
          )
      );
  }

  getRelatedNodes(
    nodeId: string,
    type?: GraphEdgeType
  ): GraphNode[] {
    const relationships =
      type === undefined
        ? this.getRelationships(
            nodeId
          )
        : this.getRelationships(
            nodeId
          ).filter(
            (edge) =>
              edge.type === type
          );

    const related =
      new Map<
        string,
        GraphNode
      >();

    for (
      const edge of
      relationships
    ) {
      const relatedId =
        edge.from === nodeId
          ? edge.to
          : edge.from;

      const node =
        graphStore.getNode(
          relatedId
        );

      if (node) {
        related.set(
          node.id,
          node
        );
      }
    }

    return [
      ...related.values(),
    ];
  }

  getOutgoingNodes(
    nodeId: string,
    type?: GraphEdgeType
  ): GraphNode[] {
    const relationships =
      this.getOutgoingRelationships(
        nodeId
      ).filter(
        (edge) =>
          type === undefined ||
          edge.type === type
      );

    const nodes =
      new Map<
        string,
        GraphNode
      >();

    for (
      const edge of
      relationships
    ) {
      const node =
        graphStore.getNode(
          edge.to
        );

      if (node) {
        nodes.set(
          node.id,
          node
        );
      }
    }

    return [
      ...nodes.values(),
    ];
  }

  getIncomingNodes(
    nodeId: string,
    type?: GraphEdgeType
  ): GraphNode[] {
    const relationships =
      this.getIncomingRelationships(
        nodeId
      ).filter(
        (edge) =>
          type === undefined ||
          edge.type === type
      );

    const nodes =
      new Map<
        string,
        GraphNode
      >();

    for (
      const edge of
      relationships
    ) {
      const node =
        graphStore.getNode(
          edge.from
        );

      if (node) {
        nodes.set(
          node.id,
          node
        );
      }
    }

    return [
      ...nodes.values(),
    ];
  }

  getWeightedRelationships(
    nodeId: string
  ): GraphEdge[] {
    return this.getRelationships(
      nodeId
    ).sort(
      (a, b) =>
        b.weight -
        a.weight
    );
  }

  findByRelationship(
    from: string,
    type: GraphEdgeType,
    to?: string
  ): GraphEdge[] {
    return graphStore
      .getEdges()
      .filter(
        (edge) =>
          edge.from === from &&
          edge.type === type &&
          (
            to === undefined ||
            edge.to === to
          )
      );
  }

  findRelatedByLabel(
    label: string,
    type?: GraphEdgeType
  ): GraphNode[] {
    const normalized =
      label
        .trim()
        .toLowerCase();

    if (!normalized) {
      return [];
    }

    const nodes =
      this.search(
        normalized
      );

    const related =
      new Map<
        string,
        GraphNode
      >();

    for (
      const node of nodes
    ) {
      for (
        const relatedNode of
        this.getRelatedNodes(
          node.id,
          type
        )
      ) {
        related.set(
          relatedNode.id,
          relatedNode
        );
      }
    }

    return [
      ...related.values(),
    ];
  }

  findByType(
    type: GraphNode["type"]
  ): GraphNode[] {
    return graphStore
      .getNodes()
      .filter(
        (node) =>
          node.type === type
      );
  }

  findRelationshipsByType(
    type: GraphEdgeType
  ): GraphEdge[] {
    return graphStore
      .getEdges()
      .filter(
        (edge) =>
          edge.type === type
      );
  }

  /*
  |--------------------------------------------------------------------------
  | Timeline Queries
  |--------------------------------------------------------------------------
  */

  getTimelineEvents():
    GraphNode[] {
    return this.findByType(
      "timeline"
    );
  }

  getTimelineEventsByCategory(
    category: string
  ): GraphNode[] {
    const normalizedCategory =
      category
        .trim()
        .toLowerCase();

    if (
      !normalizedCategory
    ) {
      return [];
    }

    return this
      .getTimelineEvents()
      .filter(
        (node) =>
          String(
            node.properties
              .category ??
              ""
          )
            .trim()
            .toLowerCase() ===
          normalizedCategory
      );
  }

  getTimelineEventCategories(
    nodeId: string
  ): GraphNode[] {
    return this
      .getOutgoingNodes(
        nodeId,
        "belongs_to"
      )
      .filter(
        (node) =>
          node.type ===
            "entity" &&
          node.properties
            .source ===
            "timeline"
      );
  }

  getTimelineEventsForCategory(
    categoryId: string
  ): GraphNode[] {
    return this
      .getIncomingNodes(
        categoryId,
        "belongs_to"
      )
      .filter(
        (node) =>
          node.type ===
          "timeline"
      );
  }

  /*
  |--------------------------------------------------------------------------
  | Search
  |--------------------------------------------------------------------------
  */

  search(
    query: string
  ): GraphNode[] {
    const normalized =
      query
        .trim()
        .toLowerCase();

    if (!normalized) {
      return [];
    }

    return graphStore
      .getNodes()
      .filter(
        (node) =>
          node.id
            .toLowerCase()
            .includes(
              normalized
            ) ||
          node.label
            .toLowerCase()
            .includes(
              normalized
            )
      );
  }

  hasRelationship(
    from: string,
    to: string,
    type?: GraphEdgeType
  ): boolean {
    return graphStore
      .getEdges()
      .some(
        (edge) =>
          edge.from === from &&
          edge.to === to &&
          (
            type === undefined ||
            edge.type === type
          )
      );
  }

  getConnectedSubgraph(
    nodeId: string
  ): {
    node:
      | GraphNode
      | undefined;

    neighbors:
      GraphNode[];

    relationships:
      GraphEdge[];
  } {
    return {
      node:
        this.getNode(
          nodeId
        ),

      neighbors:
        this.getNeighbors(
          nodeId
        ),

      relationships:
        this.getRelationships(
          nodeId
        ),
    };
  }
}

export const graphQuery =
  new GraphQuery();
</file>

<file path="frontend/brain/runtime/steps/contextStage.ts">
import { BrainState } from "../../brainState";

import {
  buildContext,
} from "../../context";

import {
  Intent,
} from "../../intent";

import { BaseStage } from "./baseStage";

/**
 * ContextStage
 *
 * Consumes the cognitive information already
 * hydrated into BrainState and composes the
 * final context consumed by ResponseStage.
 */
export class ContextStage
  extends BaseStage {
  readonly name = "Context";

  protected async process(
    state: BrainState
  ): Promise<BrainState> {
    if (state.response) {
      return state;
    }

    const structuredContext =
      await buildContext(
        state
      );

    let prompt =
      structuredContext.prompt;

    switch (state.intent) {
      case Intent.STARTUP_PLANNING:
        prompt +=
          "\n\nThe user wants startup advice. Think like an experienced startup founder and advisor.";
        break;

      case Intent.LIVE_SEARCH:
        prompt +=
          "\n\nThe user needs current information. Use live search when appropriate.";
        break;

      default:
        break;
    }

    state.context =
      prompt;

    state.knowledge =
      structuredContext.knowledge;

    return state;
  }
}
</file>

<file path="frontend/brain/runtime/steps/planningStage.ts">
import {
  BrainState,
} from "../../brainState";

import {
  Intent,
} from "../../intent";

import {
  createPlanFromMessageWithContext,
  createGoalFromPlan,
  enrichGoalFromContext,
} from "../../planning";

import {
  BaseStage,
} from "./baseStage";

export class PlanningStage
  extends BaseStage {
  readonly name =
    "Planning";

  protected async process(
    state: BrainState
  ): Promise<BrainState> {
    if (
      state.response
    ) {
      return state;
    }

    if (
      state.intent !==
      Intent.STARTUP_PLANNING
    ) {
      return state;
    }

    const graphObservations:
      string[] = [];

    if (
      state.graph.length > 0
    ) {
      graphObservations.push(
        `The knowledge graph contains ${state.graph.length} relevant entities.`
      );
    }

    if (
      state.graphEdges.length > 0
    ) {
      graphObservations.push(
        `The knowledge graph contains ${state.graphEdges.length} relevant relationships.`
      );
    }

    for (
      const observation of
      state.reasoningObservations
    ) {
      graphObservations.push(
        `Reasoning evidence (${observation.source}, confidence ${observation.confidence.toFixed(
          2
        )}): ${observation.statement}`
      );
    }

    if (
      state.predictions.length > 0
    ) {
      for (
        const prediction of
        state.predictions
      ) {
        graphObservations.push(
          `Prediction (${prediction.kind}, confidence ${prediction.confidence.toFixed(
            2
          )}): ${prediction.statement}`
        );
      }
    }

    if (
      state.reasoningConfidence > 0
    ) {
      graphObservations.push(
        `Overall reasoning confidence: ${state.reasoningConfidence.toFixed(
          2
        )}.`
      );
    }

    const reasoning =
      state.reasoning?.trim();

    if (
      reasoning &&
      state.reasoningObservations.length ===
        0
    ) {
      graphObservations.push(
        `Reasoning context: ${reasoning}`
      );
    }

    const plan =
      createPlanFromMessageWithContext(
        state.userMessage,
        {
          graphObservations,

          graphNodes:
            state.graph.map(
              (node) => ({
                id:
                  node.id,

                label:
                  node.label,

                type:
                  node.type,
              })
            ),

          graphEdges:
            state.graphEdges.map(
              (edge) => ({
                from:
                  edge.from,

                to:
                  edge.to,

                type:
                  edge.type,
              })
            ),

          reasoningObservations:
            state.reasoningObservations,

          timeline:
            state.timeline,

          reflections:
            state.reflections,

          memories:
            state.memories.map(
              (memory) =>
                memory.value
            ),
        }
      );

    if (!plan) {
      return state;
    }

    const initialGoal =
      createGoalFromPlan(
        plan
      );

    const goal =
      enrichGoalFromContext(
        initialGoal,
        {
          graphObservations,

          graphNodes:
            state.graph.map(
              (node) => ({
                id:
                  node.id,

                label:
                  node.label,

                type:
                  node.type,
              })
            ),

          graphEdges:
            state.graphEdges.map(
              (edge) => ({
                from:
                  edge.from,

                to:
                  edge.to,

                type:
                  edge.type,
              })
            ),

          reasoningObservations:
            state.reasoningObservations,

          timeline:
            state.timeline,

          reflections:
            state.reflections,

          memories:
            state.memories.map(
              (memory) =>
                memory.value
            ),
        }
      );

    state.goal =
      goal;

    state.currentGoal =
      goal.statement;

    state.currentPlanId =
      plan.id;

    state.plan =
      [
        `Plan: ${plan.title}`,

        `Goal: ${goal.statement}`,

        `Goal Status: ${goal.status}`,

        `Progress: ${goal.progress}%`,

        `Description: ${plan.description}`,

        `Next Action: ${goal.nextAction}`,

        `Priority: ${goal.priority}`,

        `Confidence: ${goal.confidence}`,

        `Obstacles: ${
          goal.obstacles.length > 0
            ? goal.obstacles.join(
                "; "
              )
            : "None identified"
        }`,

        `Dependencies: ${
          goal.dependencies.length > 0
            ? goal.dependencies.join(
                "; "
              )
            : "None identified"
        }`,

        "Milestones:",

        ...plan.milestones.map(
          (
            milestone,
            index
          ) =>
            `${index + 1}. ${milestone}`
        ),
      ].join("\n");

    return state;
  }
}
