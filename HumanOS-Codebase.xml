 8:   messages: ConversationMessage[]
 9: ): BrainState {
10:   const conversation = messages
11:     .map(
12:       (m) =>
13:         `${m.role}: ${m.message}`
14:     )
15:     .join("\n");
16: 
17:   const lastUserMessage =
18:     [...messages]
19:       .reverse()
20:       .find(
21:         (m) => m.role === "user"
22:       )?.message ?? "";
23: 
24:   return createBrainState(
25:     conversation,
26:     messages,
27:     lastUserMessage
28:   );
29: }
</file>

