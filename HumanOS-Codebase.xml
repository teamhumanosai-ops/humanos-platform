  1: "use client";
  2: 
  3: import { useState } from "react";
  4: 
  5: import ChatInput from "./ChatInput";
  6: import ChatMessage from "./ChatMessage";
  7: import TypingIndicator from "./TypingIndicator";
  8: 
  9: type Citation = {
 10:   index: number;
 11:   title: string;
 12:   url: string;
 13:   domain: string;
 14:   publishedDate?: string;
 15: };
 16: 
 17: type Message = {
 18:   role: "user" | "assistant";
 19:   message: string;
 20:   citations?: Citation[];
 21: };
 22: 
 23: export default function ChatWindow() {
 24:   const [messages, setMessages] =
 25:     useState<Message[]>([
 26:       {
 27:         role: "assistant",
 28:         message:
 29:           "Hello! I'm Human OS. How can I help you today?",
 30:       },
 31:     ]);
 32: 
 33:   const [input, setInput] =
 34:     useState("");
 35: 
 36:   const [typing, setTyping] =
 37:     useState(false);
 38: 
 39:   async function sendMessage() {
 40:     if (!input.trim()) {
 41:       return;
 42:     }
 43: 
 44:     const userMessage =
 45:       input;
 46: 
 47:     const updatedMessages = [
 48:       ...messages.map(
 49:         ({
 50:           role,
 51:           message,
 52:         }) => ({
 53:           role,
 54:           message,
 55:         })
 56:       ),
 57: 
 58:       {
 59:         role: "user" as const,
 60:         message:
 61:           userMessage,
 62:       },
 63:     ];
 64: 
 65:     setMessages(
 66:       updatedMessages
 67:     );
 68: 
 69:     setInput("");
 70: 
 71:     setTyping(true);
 72: 
 73:     try {
 74:       const response =
 75:         await fetch(
 76:           "/api/chat",
 77:           {
 78:             method: "POST",
 79: 
 80:             headers: {
 81:               "Content-Type":
 82:                 "application/json",
 83:             },
 84: 
 85:             body: JSON.stringify({
 86:               messages:
 87:                 updatedMessages,
 88:             }),
 89:           }
 90:         );
 91: 
 92:       const data =
 93:         await response.json();
 94: 
 95:       setMessages([
 96:         ...updatedMessages,
 97: 
 98:         {
 99:           role: "assistant",
100: 
101:           message:
102:             data.message ??
103:             "Sorry, I couldn't generate a response.",
104: 
105:           citations:
106:             Array.isArray(
107:               data.citations
108:             )
109:               ? data.citations
110:               : [],
111:         },
112:       ]);
113:     } catch (error) {
114:       console.error(
115:         error
116:       );
117: 
118:       setMessages([
119:         ...updatedMessages,
120: 
121:         {
122:           role: "assistant",
123: 
124:           message:
125:             "Sorry, something went wrong while contacting Human OS.",
126: 
127:           citations: [],
128:         },
129:       ]);
130:     } finally {
131:       setTyping(false);
132:     }
133:   }
134: 
135:   return (
136:     <div
137:       className="
138:         h-[80vh]
139:         rounded-3xl
140:         border
141:         border-white/10
142:         bg-white/5
143:         backdrop-blur-xl
144:         flex
145:         flex-col
146:         p-6
147:       "
148:     >
149:       <div
150:         className="
151:           flex-1
152:           overflow-y-auto
153:           space-y-6
154:           pr-2
155:         "
156:       >
157:         {messages.map(
158:           (msg, index) => (
159:             <ChatMessage
160:               key={index}
161:               role={msg.role}
162:               message={
163:                 msg.message
164:               }
165:               citations={
166:                 msg.citations
167:               }
168:             />
169:           )
170:         )}
171: 
172:         {typing && (
173:           <TypingIndicator />
174:         )}
175:       </div>
176: 
177:       <div className="mt-6">
178:         <ChatInput
179:           value={input}
180:           onChange={
181:             setInput
182:           }
183:           onSend={
184:             sendMessage
185:           }
186:         />
187:       </div>
188:     </div>
189:   );
190: }
</file>

