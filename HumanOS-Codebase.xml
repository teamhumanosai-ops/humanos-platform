 11: export async function saveMemory(
 12:   key: string,
 13:   value: string,
 14:   confidence = 1
 15: ): Promise<void> {
 16:   const analysis =
 17:     analyzeMemory(
 18:       key,
 19:       value
 20:     );
 21: 
 22:   const timestamp =
 23:     new Date().toISOString();
 24: 
 25:   const graphRecord = {
 26:     id: key,
 27: 
 28:     label: value,
 29: 
 30:     entities:
 31:       analysis.entities,
 32: 
 33:     relationships:
 34:       analysis.relationships,
 35: 
 36:     properties: {
 37:       confidence,
 38:       kind: analysis.kind,
 39:       importance:
 40:         analysis.importance,
 41:       updatedAt:
 42:         timestamp,
 43:     },
 44:   };
 45: 
 46:   const existing =
 47:     await db
 48:       .select()
 49:       .from(memories)
 50:       .where(
 51:         eq(memories.key, key)
 52:       );
 53: 
 54:   if (existing.length > 0) {
 55:     await db
 56:       .update(memories)
 57:       .set({
 58:         value,
 59:         confidence,
 60:         kind: analysis.kind,
 61:         importance:
 62:           analysis.importance,
 63:         updatedAt:
 64:           timestamp,
 65:       })
 66:       .where(
 67:         eq(memories.key, key)
 68:       );
 69: 
 70:     memoryGraphAdapter.sync(
 71:       graphRecord
 72:     );
 73: 
 74:     return;
 75:   }
 76: 
 77:   await db
 78:     .insert(memories)
 79:     .values({
 80:       key,
 81:       value,
 82:       confidence,
 83:       kind: analysis.kind,
 84:       importance:
 85:         analysis.importance,
 86:       updatedAt:
 87:         timestamp,
 88:     });
 89: 
 90:   memoryGraphAdapter.sync(
 91:     graphRecord
 92:   );
 93: }
