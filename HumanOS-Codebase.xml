  9: export class TimelineGraphAdapter {
 10:   sync(
 11:     event: TimelineEvent
 12:   ): void {
 13:     const timelineId =
 14:       buildGraphId(event);
 15: 
 16:     graphBuilder.addTimelineEvent(
 17:       timelineId,
 18:       event.title,
 19:       {
 20:         timestamp:
 21:           event.timestamp,
 22: 
 23:         description:
 24:           event.description,
 25: 
 26:         category:
 27:           event.category,
 28: 
 29:         confidence:
 30:           event.confidence,
 31: 
 32:         source:
 33:           event.source,
 34: 
 35:         createdAt:
 36:           event.createdAt,
 37: 
 38:         timelineId:
 39:           event.id,
 40:       }
 41:     );
 42: 
 43:     /*
 44:     |--------------------------------------------------------------------------
 45:     | Connect the Timeline event to its category.
 46:     |--------------------------------------------------------------------------
 47:     |
 48:     | Categories are represented as entity nodes so the
 49:     | existing GraphNode model can represent them without
 50:     | introducing another node type.
 51:     |
 52:     */
 53: 
 54:     const categoryId =
 55:       `entity:timeline-category:${event.category
 56:         .toLowerCase()
 57:         .replace(/\s+/g, "-")}`;
 58: 
 59:     graphBuilder.addEntity(
 60:       categoryId,
