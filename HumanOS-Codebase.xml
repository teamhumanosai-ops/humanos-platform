265: function getRelevantGraphNodes(
266:   state: BrainState
267: ): BrainState["graph"] {
268:   if (
269:     state.graph.length === 0
270:   ) {
271:     return [];
272:   }
273: 
274:   const queryTokens =
275:     tokenize(
276:       state.userMessage
277:     );
278: 
279:   if (
280:     queryTokens.length === 0
281:   ) {
282:     return [];
283:   }
284: 
285:   const scored =
286:     state.graph
287:       .map(
288:         (node) => ({
289:           node,
290: 
291:           score:
292:             scoreGraphNode(
293:               node,
294:               queryTokens
295:             ),
296:         })
297:       )
298:       .filter(
299:         (item) =>
300:           item.score > 0
301:       )
302:       .sort(
303:         (a, b) =>
304:           b.score -
305:           a.score
306:       );
307: 
308:   return scored
309:     .slice(
310:       0,
311:       8
312:     )
313:     .map(
314:       (item) =>
315:         item.node
316:     );
317: }
