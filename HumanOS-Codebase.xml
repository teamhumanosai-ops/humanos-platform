<file path="frontend/brain/content/processors/json/JsonNormalizer.ts">
 1: export interface JsonNormalizationResult {
 2:     text: string;
 3: 
 4:     valid: boolean;
 5: 
 6:     keys: string[];
 7: }
 8: 
 9: export class JsonNormalizer {
10:     static normalize(
11:         input: string
12:     ): JsonNormalizationResult {
13:         try {
14:             const parsed = JSON.parse(input);
15: 
16:             return {
17:                 text: JSON.stringify(
18:                     parsed,
19:                     null,
20:                     2
21:                 ),
22: 
23:                 valid: true,
24: 
25:                 keys:
26:                     parsed &&
27:                     typeof parsed === "object"
28:                         ? Object.keys(parsed)
29:                         : [],
30:             };
31:         } catch {
32:             return {
33:                 text: input,
34: 
35:                 valid: false,
36: 
37:                 keys: [],
38:             };
39:         }
40:     }
41: }
</file>

