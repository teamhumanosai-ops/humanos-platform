<file path="frontend/brain/inference/engine.ts">
  1: import type {
  2:   BrainState,
  3: } from "../brainState";
  4: 
  5: import type {
  6:   ReasoningObservation,
  7: } from "../reasoning";
  8: 
  9: import type {
 10:   CognitiveInference,
 11:   InferenceEvidence,
 12:   InferenceKind,
 13: } from "./types";
 14: 
 15: function createEvidence(
 16:   observation: ReasoningObservation
 17: ): InferenceEvidence {
 18:   return {
 19:     source:
 20:       observation.source,
 21: 
 22:     statement:
 23:       observation.statement,
 24: 
 25:     confidence:
 26:       observation.confidence,
 27:   };
 28: }
 29: 
 30: function calculateConfidence(
 31:   evidence: InferenceEvidence[]
 32: ): number {
 33:   if (
 34:     evidence.length === 0
 35:   ) {
 36:     return 0;
 37:   }
 38: 
 39:   const total =
 40:     evidence.reduce(
 41:       (
 42:         sum,
 43:         item
 44:       ) =>
 45:         sum +
 46:         item.confidence,
 47:       0
 48:     );
 49: 
 50:   return total /
 51:     evidence.length;
 52: }
 53: 
 54: function classifyInference(
 55:   observation: ReasoningObservation
 56: ): InferenceKind {
 57:   if (
 58:     observation.confidence <
 59:     0.7
 60:   ) {
 61:     return "uncertainty";
 62:   }
 63: 
 64:   if (
 65:     observation.kind ===
 66:     "known_fact"
 67:   ) {
 68:     return "known_fact";
 69:   }
 70: 
 71:   if (
 72:     observation.kind ===
 73:     "observed_relationship"
 74:   ) {
 75:     return "observed_relationship";
 76:   }
 77: 
 78:   if (
 79:     observation.kind ===
 80:     "derived_inference"
 81:   ) {
 82:     if (
 83:       observation.source ===
 84:       "prediction"
 85:     ) {
 86:       return "hypothesis";
 87:     }
 88: 
 89:     return "derived_inference";
 90:   }
 91: 
 92:   return "uncertainty";
 93: }
 94: 
 95: function buildObservationInferences(
 96:   observations: ReasoningObservation[]
 97: ): CognitiveInference[] {
 98:   return observations.map(
 99:     (
100:       observation
101:     ) => {
102:       const evidence =
103:         [
104:           createEvidence(
105:             observation
106:           ),
107:         ];
108: 
109:       return {
110:         id:
111:           crypto.randomUUID(),
112: 
113:         statement:
114:           observation.statement,
115: 
116:         kind:
117:           classifyInference(
118:             observation
119:           ),
120: 
121:         confidence:
122:           observation.confidence,
123: 
124:         evidence,
125: 
126:         createdAt:
127:           new Date(),
128:       };
129:     }
130:   );
131: }
132: 
133: function buildCrossSourceInference(
134:   observations: ReasoningObservation[]
135: ): CognitiveInference | null {
136:   const independentSources =
137:     new Set(
138:       observations.map(
139:         (
140:           observation
141:         ) =>
142:           observation.source
143:       )
144:     );
145: 
146:   if (
147:     independentSources.size <
148:     2
149:   ) {
150:     return null;
151:   }
152: 
153:   const evidence =
154:     observations
155:       .slice(
156:         0,
157:         5
158:       )
159:       .map(
160:         createEvidence
161:       );
162: 
163:   const confidence =
164:     Math.min(
165:       0.9,
166:       calculateConfidence(
167:         evidence
168:       ) +
169:         0.05
170:     );
171: 
172:   return {
173:     id:
174:       crypto.randomUUID(),
175: 
176:     statement:
177:       "Multiple independent cognitive sources provide converging evidence relevant to the current request.",
178: 
179:     kind:
180:       confidence < 0.7
181:         ? "uncertainty"
182:         : "derived_inference",
183: 
184:     confidence,
185: 
186:     evidence,
187: 
188:     createdAt:
189:       new Date(),
190:   };
191: }
192: 
193: export function infer(
194:   state: BrainState
195: ): CognitiveInference[] {
196:   const observations =
197:     state.reasoningObservations;
198: 
199:   if (
200:     observations.length === 0
201:   ) {
202:     return [];
203:   }
204: 
205:   const inferences =
206:     buildObservationInferences(
207:       observations
208:     );
209: 
210:   const crossSourceInference =
211:     buildCrossSourceInference(
212:       observations
213:     );
214: 
215:   if (
216:     crossSourceInference
217:   ) {
218:     inferences.push(
219:       crossSourceInference
220:     );
221:   }
222: 
223:   return inferences;
224: }
</file>

