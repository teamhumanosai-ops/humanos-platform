<file path="frontend/brain/runtime/steps/executionStage.ts">
  1: import {
  2:   BrainState,
  3: } from "../../brainState";
  4: 
  5: import {
  6:   getDecision,
  7: } from "../../decision";
  8: 
  9: import {
 10:   createExecutionFromDecision,
 11: } from "../../execution";
 12: 
 13: import {
 14:   getPlan,
 15: } from "../../planning";
 16: 
 17: import {
 18:   BaseStage,
 19: } from "./baseStage";
 20: 
 21: /**
 22:  * ExecutionStage
 23:  *
 24:  * Integrates the existing Execution Engine
 25:  * into the Cognitive Runtime.
 26:  *
 27:  * The stage creates a pending execution from
 28:  * the active decision and stores the execution
 29:  * information in BrainState.
 30:  *
 31:  * It does not start or complete the execution.
 32:  * Actual execution lifecycle operations remain
 33:  * owned by the Execution Engine.
 34:  *
 35:  * Safety:
 36:  * Execution creation is blocked when an earlier
 37:  * runtime stage has already recorded an error.
 38:  */
 39: export class ExecutionStage
 40:   extends BaseStage {
 41:   readonly name =
 42:     "Execution";
 43: 
 44:   protected async process(
 45:     state: BrainState
 46:   ): Promise<BrainState> {
 47:     /*
 48:     |--------------------------------------------------------------------------
 49:     | Existing response
 50:     |--------------------------------------------------------------------------
 51:     |
 52:     | A local skill or earlier stage has already
 53:     | produced the final response. There is no
 54:     | additional execution work to create.
 55:     |
 56:     */
 57: 
 58:     if (
 59:       state.response
 60:     ) {
 61:       return state;
 62:     }
 63: 
 64:     /*
 65:     |--------------------------------------------------------------------------
 66:     | Runtime safety gate
 67:     |--------------------------------------------------------------------------
 68:     |
 69:     | ValidationStage and other upstream stages may
 70:     | have recorded errors. Never create an execution
 71:     | from an invalid cognitive state.
 72:     |
 73:     */
 74: 
 75:     if (
 76:       state.errors.length > 0
 77:     ) {
 78:       return state;
 79:     }
 80: 
 81:     /*
 82:     |--------------------------------------------------------------------------
 83:     | Required runtime identifiers
 84:     |--------------------------------------------------------------------------
 85:     */
 86: 
 87:     if (
 88:       !state.currentDecisionId ||
 89:       !state.currentPlanId
 90:     ) {
 91:       return state;
 92:     }
 93: 
 94:     /*
 95:     |--------------------------------------------------------------------------
 96:     | Resolve active decision
 97:     |--------------------------------------------------------------------------
 98:     */
 99: 
100:     const decision =
101:       getDecision(
102:         state.currentDecisionId
103:       );
104: 
105:     if (
106:       !decision
107:     ) {
108:       return state;
109:     }
110: 
111:     /*
112:     |--------------------------------------------------------------------------
113:     | Resolve active plan
114:     |--------------------------------------------------------------------------
115:     */
116: 
117:     const plan =
118:       getPlan(
119:         state.currentPlanId
120:       );
121: 
122:     if (
123:       !plan
124:     ) {
125:       return state;
126:     }
127: 
128:     /*
129:     |--------------------------------------------------------------------------
130:     | Create pending execution
131:     |--------------------------------------------------------------------------
132:     |
133:     | Execution lifecycle remains owned by the
134:     | Execution Engine.
135:     |
136:     */
137: 
138:     const execution =
139:       createExecutionFromDecision(
140:         decision,
141:         plan.id
142:       );
143: 
144:     /*
145:     |--------------------------------------------------------------------------
146:     | Store execution identity
147:     |--------------------------------------------------------------------------
148:     */
149: 
150:     state.currentExecutionId =
151:       execution.id;
152: 
153:     /*
154:     |--------------------------------------------------------------------------
155:     | Store human-readable execution state
156:     |--------------------------------------------------------------------------
157:     */
158: 
159:     state.execution =
160:       [
161:         `Execution: ${execution.title}`,
162: 
163:         `Action: ${execution.action}`,
164: 
165:         `Status: ${execution.status}`,
166: 
167:         `Plan ID: ${execution.planId}`,
168: 
169:         `Execution ID: ${execution.id}`,
170:       ].join("\n");
171: 
172:     return state;
173:   }
174: }
</file>

<file path="frontend/brain/runtime/steps/reasoningStage.ts">
 1: import {
 2:   BrainState,
 3: } from "../../brainState";
 4: 
 5: import {
 6:   reason,
 7: } from "../../reasoning";
 8: 
 9: import {
10:   BaseStage,
11: } from "./baseStage";
12: 
13: /**
14:  * ReasoningStage
15:  *
16:  * Converts the cognitive information already
17:  * assembled in BrainState into structured
18:  * reasoning signals.
19:  *
20:  * The reasoning engine remains responsible
21:  * for producing ReasoningResult.
22:  *
23:  * BrainState remains responsible for
24:  * retaining the structured runtime artifact.
25:  */
26: export class ReasoningStage
27:   extends BaseStage {
28:   readonly name =
29:     "Reasoning";
30: 
31:   protected async process(
32:     state: BrainState
33:   ): Promise<BrainState> {
34:     /*
35:     |--------------------------------------------------------------------------
36:     | If a previous stage has already produced
37:     | a final response, there is nothing left
38:     | to reason about for this execution.
39:     |--------------------------------------------------------------------------
40:     */
41: 
42:     if (
43:       state.response
44:     ) {
45:       return state;
46:     }
47: 
48:     /*
49:     |--------------------------------------------------------------------------
50:     | Evaluate the canonical BrainState.
51:     |--------------------------------------------------------------------------
52:     */
53: 
54:     const result =
55:       reason(state);
56: 
57:     /*
58:     |--------------------------------------------------------------------------
59:     | Preserve the structured reasoning artifact.
60:     |--------------------------------------------------------------------------
61:     */
62: 
63:     state.reasoningObservations =
64:       result.observations;
65: 
66:     state.reasoningConfidence =
67:       result.confidence;
68: 
69:     /*
70:     |--------------------------------------------------------------------------
71:     | Preserve the human-readable reasoning
72:     | representation for downstream response use.
73:     |--------------------------------------------------------------------------
74:     */
75: 
76:     state.reasoning =
77:       [
78:         result.summary,
79: 
80:         ...result.observations.map(
81:           (observation) =>
82:             `- ${observation.statement} [${observation.kind}] Source: ${observation.source} Confidence: ${observation.confidence.toFixed(
83:               2
84:             )}`
85:         ),
86: 
87:         `Overall reasoning confidence: ${result.confidence.toFixed(
88:           2
89:         )}`,
90:       ].join("\n");
91: 
92:     return state;
93:   }
94: }
</file>

<file path="frontend/brain/planning.ts">
  1: import {
  2:   eq,
  3: } from "drizzle-orm";
  4: 
  5: import {
  6:   db,
  7: } from "../database/db";
  8: 
  9: import {
 10:   plans,
 11: } from "../database/schema";
 12: 
 13: import {
 14:   extractGoal,
 15: } from "./goalExtractor";
 16: 
 17: import {
 18:   generatePlan,
 19: } from "./planGenerator";
 20: 
 21: import {
 22:   completeMilestone,
 23: } from "./progressTracker";
 24: 
 25: export type PlanStatus =
 26:   | "active"
 27:   | "completed"
 28:   | "paused";
 29: 
 30: export type GoalStatus =
 31:   | "active"
 32:   | "completed"
 33:   | "paused"
 34:   | "blocked";
 35: 
 36: export type PlanningContext = {
 37:   graphObservations?: string[];
 38: 
 39:   graphNodes?: Array<{
 40:     id: string;
 41:     label: string;
 42:     type: string;
 43:   }>;
 44: 
 45:   graphEdges?: Array<{
 46:     from: string;
 47:     to: string;
 48:     type: string;
 49:   }>;
 50: 
 51:   reasoningObservations?: Array<{
 52:     statement: string;
 53:     confidence: number;
 54:     kind?: string;
 55:   }>;
 56: 
 57:   timeline?: string[];
 58: 
 59:   reflections?: string[];
 60: 
 61:   memories?: string[];
 62: };
 63: 
 64: export type Goal = {
 65:   id: string;
 66: 
 67:   statement: string;
 68: 
 69:   status: GoalStatus;
 70: 
 71:   progress: number;
 72: 
 73:   priority: number;
 74: 
 75:   confidence: number;
 76: 
 77:   nextAction: string;
 78: 
 79:   obstacles: string[];
 80: 
 81:   dependencies: string[];
 82: 
 83:   createdAt: Date;
 84: 
 85:   updatedAt: Date;
 86: };
 87: 
 88: export type Plan = {
 89:   id: string;
 90: 
 91:   title: string;
 92: 
 93:   goal: string;
 94: 
 95:   description: string;
 96: 
 97:   status: PlanStatus;
 98: 
 99:   milestones: string[];
100: 
101:   completedMilestones: string[];
102: 
103:   nextAction: string;
104: 
105:   priority: number;
106: 
107:   confidence: number;
108: 
109:   createdAt: Date;
110: 
111:   updatedAt: Date;
112: };
113: 
114: /*
115: |--------------------------------------------------------------------------
116: | Goal Intelligence
117: |--------------------------------------------------------------------------
118: */
119: 
120: function normalize(
121:   value: string
122: ): string {
123:   return value
124:     .trim()
125:     .toLowerCase();
126: }
127: 
128: function goalTerms(
129:   statement: string
130: ): string[] {
131:   return normalize(
132:     statement
133:   )
134:     .split(/\s+/)
135:     .map(
136:       (term) =>
137:         term.replace(
138:           /^[^\p{L}\p{N}]+|[^\p{L}\p{N}]+$/gu,
139:           ""
140:         )
141:     )
142:     .filter(
143:       (term) =>
144:         term.length >= 3
145:     );
146: }
147: 
148: function calculateProgress(
149:   plan: Plan
150: ): number {
151:   if (
152:     plan.milestones.length === 0
153:   ) {
154:     return 100;
155:   }
156: 
157:   return Math.round(
158:     (
159:       plan.completedMilestones.length /
160:       plan.milestones.length
161:     ) * 100
162:   );
163: }
164: 
165: function findRelevantGraphNodes(
166:   goal: Goal,
167:   context: PlanningContext
168: ) {
169:   const terms =
170:     goalTerms(
171:       goal.statement
172:     );
173: 
174:   return (
175:     context.graphNodes ?? []
176:   ).filter(
177:     (node) => {
178:       const text =
179:         normalize(
180:           `${node.id} ${node.label}`
181:         );
182: 
183:       return terms.some(
184:         (term) =>
185:           text.includes(term)
186:       );
187:     }
188:   );
189: }
190: 
191: function buildDependencies(
192:   goal: Goal,
193:   context: PlanningContext
194: ): string[] {
195:   const relevantNodes =
196:     findRelevantGraphNodes(
197:       goal,
198:       context
199:     );
200: 
201:   if (
202:     relevantNodes.length === 0
203:   ) {
204:     return [];
205:   }
206: 
207:   const relevantIds =
208:     new Set(
209:       relevantNodes.map(
210:         (node) =>
211:           node.id
212:       )
213:     );
214: 
215:   const nodesById =
216:     new Map(
217:       (
218:         context.graphNodes ??
219:         []
220:       ).map(
221:         (node) => [
222:           node.id,
223:           node,
224:         ]
225:       )
226:     );
227: 
228:   const dependencies =
229:     new Set<string>();
230: 
231:   for (
232:     const edge of
233:     context.graphEdges ?? []
234:   ) {
235:     if (
236:       edge.type !==
237:       "depends_on"
238:     ) {
239:       continue;
240:     }
241: 
242:     if (
243:       !relevantIds.has(
244:         edge.from
245:       )
246:     ) {
247:       continue;
248:     }
249: 
250:     const dependency =
251:       nodesById.get(
252:         edge.to
253:       );
254: 
255:     if (
256:       dependency
257:     ) {
258:       dependencies.add(
259:         dependency.label
260:       );
261:     }
262:   }
263: 
264:   return [
265:     ...dependencies,
266:   ].slice(
267:     0,
268:     5
269:   );
270: }
271: 
272: function containsObstacleSignal(
273:   value: string
274: ): boolean {
275:   const text =
276:     normalize(
277:       value
278:     );
279: 
280:   const signals = [
281:     "blocked",
282:     "blocker",
283:     "delay",
284:     "delayed",
285:     "cannot",
286:     "can't",
287:     "unable",
288:     "issue",
289:     "problem",
290:     "risk",
291:     "uncertain",
292:     "uncertainty",
293:     "waiting",
294:   ];
295: 
296:   return signals.some(
297:     (signal) =>
298:       text.includes(
299:         signal
300:       )
301:   );
302: }
303: 
304: function buildObstacles(
305:   context: PlanningContext
306: ): string[] {
307:   const candidates = [
308:     ...(context.reasoningObservations ?? [])
309:       .filter(
310:         (observation) =>
311:           observation.kind ===
312:             "uncertainty" ||
313:           observation.confidence <
314:             0.7
315:       )
316:       .map(
317:         (observation) =>
318:           observation.statement
319:       ),
320: 
321:     ...(context.timeline ?? [])
322:       .filter(
323:         containsObstacleSignal
324:       ),
325: 
326:     ...(context.reflections ?? [])
327:       .filter(
328:         containsObstacleSignal
329:       ),
330: 
331:     ...(context.memories ?? [])
332:       .filter(
333:         containsObstacleSignal
334:       ),
335:   ];
336: 
337:   return [
338:     ...new Set(
339:       candidates
340:         .map(
341:           (value) =>
342:             value.trim()
343:         )
344:         .filter(Boolean)
345:     ),
346:   ].slice(
347:     0,
348:     5
349:   );
350: }
351: 
352: export function createGoalFromPlan(
353:   plan: Plan
354: ): Goal {
355:   return {
356:     id:
357:       plan.id,
358: 
359:     statement:
360:       plan.goal,
361: 
362:     status:
363:       plan.status ===
364:       "completed"
365:         ? "completed"
366:         : "active",
367: 
368:     progress:
369:       calculateProgress(
370:         plan
371:       ),
372: 
373:     priority:
374:       plan.priority,
375: 
376:     confidence:
377:       plan.confidence,
378: 
379:     nextAction:
380:       plan.nextAction,
381: 
382:     obstacles: [],
383: 
384:     dependencies: [],
385: 
386:     createdAt:
387:       plan.createdAt,
388: 
389:     updatedAt:
390:       plan.updatedAt,
391:   };
392: }
393: 
394: export function enrichGoalFromContext(
395:   goal: Goal,
396:   context: PlanningContext
397: ): Goal {
398:   const obstacles =
399:     buildObstacles(
400:       context
401:     );
402: 
403:   const dependencies =
404:     buildDependencies(
405:       goal,
406:       context
407:     );
408: 
409:   let status:
410:     GoalStatus =
411:     "active";
412: 
413:   if (
414:     goal.progress >= 100
415:   ) {
416:     status =
417:       "completed";
418:   } else if (
419:     obstacles.length > 0
420:   ) {
421:     status =
422:       "blocked";
423:   }
424: 
425:   return {
426:     ...goal,
427: 
428:     status,
429: 
430:     obstacles,
431: 
432:     dependencies,
433: 
434:     updatedAt:
435:       new Date(),
436:   };
437: }
438: 
439: /*
440: |--------------------------------------------------------------------------
441: | Persistence
442: |--------------------------------------------------------------------------
443: */
444: 
445: function serializePlan(
446:   plan: Plan
447: ) {
448:   return {
449:     id:
450:       plan.id,
451: 
452:     title:
453:       plan.title,
454: 
455:     goal:
456:       plan.goal,
457: 
458:     description:
459:       plan.description,
460: 
461:     status:
462:       plan.status,
463: 
464:     milestones:
465:       JSON.stringify(
466:         plan.milestones
467:       ),
468: 
469:     completedMilestones:
470:       JSON.stringify(
471:         plan.completedMilestones
472:       ),
473: 
474:     nextAction:
475:       plan.nextAction,
476: 
477:     priority:
478:       plan.priority,
479: 
480:     confidence:
481:       plan.confidence,
482: 
483:     createdAt:
484:       plan.createdAt.toISOString(),
485: 
486:     updatedAt:
487:       plan.updatedAt.toISOString(),
488:   };
489: }
490: 
491: function deserializePlan(
492:   row: typeof plans.$inferSelect
493: ): Plan {
494:   return {
495:     id:
496:       row.id,
497: 
498:     title:
499:       row.title,
500: 
501:     goal:
502:       row.goal,
503: 
504:     description:
505:       row.description,
506: 
507:     status:
508:       row.status as PlanStatus,
509: 
510:     milestones:
511:       JSON.parse(
512:         row.milestones
513:       ) as string[],
514: 
515:     completedMilestones:
516:       JSON.parse(
517:         row.completedMilestones
518:       ) as string[],
519: 
520:     nextAction:
521:       row.nextAction,
522: 
523:     priority:
524:       row.priority,
525: 
526:     confidence:
527:       row.confidence,
528: 
529:     createdAt:
530:       new Date(
531:         row.createdAt
532:       ),
533: 
534:     updatedAt:
535:       new Date(
536:         row.updatedAt
537:       ),
538:   };
539: }
