<file path="frontend/brain/content/normalization/TextNormalizer.ts">
 1: export class TextNormalizer {
 2:     static normalize(text: string): string {
 3:         return text
 4:             .normalize("NFC")
 5:             .replace(/\r\n/g, "\n")
 6:             .replace(/\r/g, "\n")
 7:             .replace(/[ \t]+/g, " ")
 8:             .replace(/\n{3,}/g, "\n\n")
 9:             .trim();
10:     }
11: 
12:     static sections(text: string): string[] {
13:         return text
14:             .split(/\n\s*\n/)
15:             .map(section => section.trim())
16:             .filter(section => section.length > 0);
17:     }
18: }
</file>

