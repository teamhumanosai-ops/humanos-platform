import {
  graphStore,
} from "./GraphStore";

import {
  GraphEdge,
  GraphNode,
  GraphNodeType,
} from "./types";

function now(): string {
  return new Date().toISOString();
}

function createNode(
  id: string,
  type: GraphNodeType,
  label: string,
  properties: Record<string, unknown> = {}
): GraphNode {
  return {
    id,
    type,
    label,
    properties,
    createdAt: now(),
    updatedAt: now(),
  };
}

function createEdge(
  from: string,
  to: string,
  type: GraphEdge["type"],
  weight = 1,
  properties: Record<string, unknown> = {}
): GraphEdge {
  return {
    id: `${from}:${type}:${to}`,
    from,
    to,
    type,
    weight,
    properties,
    createdAt: now(),
  };
}

export class GraphBuilder {
  addMemory(
    id: string,
    label: string,
    properties: Record<string, unknown> = {}
  ): GraphNode {
    const node = createNode(
      id,
      "memory",
      label,
      properties
    );

    if (!graphStore.hasNode(id)) {
      graphStore.addNode(node);
    }

    return node;
  }

  addTimelineEvent(
    id: string,
    label: string,
    properties: Record<string, unknown> = {}
  ): GraphNode {
    const node = createNode(
      id,
      "timeline",
      label,
      properties
    );

    if (!graphStore.hasNode(id)) {
      graphStore.addNode(node);
    }

    return node;
  }

  addKnowledge(
    id: string,
    label: string,
    properties: Record<string, unknown> = {}
  ): GraphNode {
    const node = createNode(
      id,
      "knowledge",
      label,
      properties
    );

    if (!graphStore.hasNode(id)) {
      graphStore.addNode(node);
    }

    return node;
  }

  addEntity(
    id: string,
    label: string,
    properties: Record<string, unknown> = {}
  ): GraphNode {
    const node = createNode(
      id,
      "entity",
      label,
      properties
    );

    if (!graphStore.hasNode(id)) {
      graphStore.addNode(node);
    }

    return node;
  }

  connect(
    from: string,
    to: string,
    type: GraphEdge["type"] = "related_to",
    weight = 1,
    properties: Record<string, unknown> = {}
  ): void {
    const edgeId =
      `${from}:${type}:${to}`;

    if (graphStore.hasEdge(edgeId)) {
      return;
    }

    graphStore.addEdge(
      createEdge(
        from,
        to,
        type,
        weight,
        properties
      )
    );
  }
}

export const graphBuilder =
  new GraphBuilder();
</file>

<file path="frontend/brain/graph/MemoryGraphAdapter.ts">
import { graphBuilder } from "./GraphBuilder";

import type {
  ExtractedRelationship,
} from "../memory/RelationshipAnalyzer";

export interface MemoryGraphRecord {
  id: string;

  label: string;

  properties?: Record<string, unknown>;

  entities?: string[];

  relationships?: ExtractedRelationship[];
}

function entityId(
  value: string
): string {
  return `entity:${value
    .trim()
    .toLowerCase()}`;
}

function addEntity(
  label: string
): string {
  const id = entityId(label);

  graphBuilder.addEntity(
    id,
    label,
    {
      source: "memory",
    }
  );

  return id;
}

export class MemoryGraphAdapter {
  sync(
    memory: MemoryGraphRecord
  ): void {
    graphBuilder.addMemory(
      memory.id,
      memory.label,
      memory.properties ?? {}
    );

    for (
      const entity of
      memory.entities ?? []
    ) {
      const id =
        addEntity(entity);

      graphBuilder.connect(
        memory.id,
        id,
        "mentions"
      );
    }

    for (
      const relationship of
      memory.relationships ?? []
    ) {
      const subjectId =
        addEntity(
          relationship.subject
        );

      const objectId =
        addEntity(
          relationship.object
        );

      graphBuilder.connect(
        subjectId,
        objectId,
        relationship.predicate as
          | "uses"
          | "built_with"
          | "depends_on"
          | "based_on"
          | "created_by"
          | "works_with"
          | "integrates_with"
          | "part_of"
          | "belongs_to",
        relationship.confidence,
        {
          source: "memory",
          confidence:
            relationship.confidence,
        }
      );
    }
  }
}

export const memoryGraphAdapter =
  new MemoryGraphAdapter();
</file>

