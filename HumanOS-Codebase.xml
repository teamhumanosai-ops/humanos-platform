319: function getRelevantGraphEdges(
320:   state: BrainState,
321:   relevantNodes:
322:     BrainState["graph"]
323: ): BrainState["graphEdges"] {
324:   if (
325:     relevantNodes.length === 0
326:   ) {
327:     return [];
328:   }
329: 
330:   const queryTokens =
331:     tokenize(
332:       state.userMessage
333:     );
334: 
335:   const relevantIds =
336:     new Set(
337:       relevantNodes.map(
338:         (node) =>
339:           node.id
340:       )
341:     );
342: 
343:   const nodesById =
344:     new Map(
345:       state.graph.map(
346:         (node) => [
347:           node.id,
348:           node,
349:         ]
350:       )
351:     );
352: 
353:   return state.graphEdges
354:     .filter(
355:       (edge) =>
356:         relevantIds.has(
357:           edge.from
358:         ) ||
359:         relevantIds.has(
360:           edge.to
361:         )
362:     )
363:     .map(
364:       (edge) => ({
365:         edge,
366: 
367:         score:
368:           scoreGraphEdge(
369:             edge,
370:             nodesById,
371:             queryTokens
372:           ),
373:       })
374:     )
375:     .sort(
376:       (a, b) =>
377:         b.score -
378:         a.score
379:     )
380:     .slice(
381:       0,
382:       16
383:     )
384:     .map(
385:       (item) =>
386:         item.edge
387:     );
388: }
