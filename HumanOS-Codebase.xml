 32:   query: string
 33: ): boolean {
 34:   const text =
 35:     query.toLowerCase();
 36: 
 37:   return [
 38:     "news",
 39:     "latest",
 40:     "today",
 41:     "current",
 42:     "breaking",
 43:     "update",
 44:     "updates",
 45:     "who won",
 46:     "winner",
 47:     "champion",
 48:     "result",
 49:     "results",
 50:     "score",
 51:     "scores",
 52:     "standings",
 53:     "fifa",
 54:     "world cup",
 55:     "ipl",
 56:     "cricket",
 57:     "nba",
 58:     "nfl",
 59:     "nhl",
 60:     "premier league",
 61:     "formula 1",
 62:     "f1",
 63:   ].some(
 64:     (term) =>
 65:       text.includes(term)
 66:   );
 67: }
 68: 
 69: function buildSearchQuery(
 70:   query: string
 71: ): string {
 72:   const year =
 73:     new Date()
 74:       .getFullYear()
 75:       .toString();
 76: 
 77:   if (
 78:     /\b20\d{2}\b/.test(query)
 79:   ) {
 80:     return query.trim();
 81:   }
 82: 
 83:   return `${query.trim()} ${year}`;
 84: }
 85: 
 86: export async function searchWeb(
 87:   query: string
 88: ): Promise<SearchResponse> {
 89:   const apiKey =
 90:     process.env.TAVILY_API_KEY;
 91: 
 92:   if (!apiKey) {
 93:     throw new Error(
 94:       "TAVILY_API_KEY is not configured."
 95:     );
 96:   }
 97: 
 98:   const searchedAt =
 99:     new Date().toISOString();
100: 
101:   const searchQuery =
102:     buildSearchQuery(query);
103: 
104:   const response =
105:     await fetch(
106:       TAVILY_ENDPOINT,
107:       {
108:         method: "POST",
109: 
110:         headers: {
111:           Authorization:
112:             `Bearer ${apiKey}`,
113: 
114:           "Content-Type":
115:             "application/json",
116:         },
117: 
118:         body: JSON.stringify({
119:           query: searchQuery,
120: 
121:           search_depth:
122:             "advanced",
123: 
124:           topic:
125:             isNewsOrCurrentQuery(
126:               query
127:             )
128:               ? "news"
129:               : "general",
130: 
131:           max_results: 6,
132: 
133:           chunks_per_source: 2,
134: 
135:           include_answer:
136:             "advanced",
137: 
138:           include_raw_content:
139:             false,
140:         }),
141:       }
142:     );
143: 
144:   if (!response.ok) {
145:     const errorText =
146:       await response.text();
147: 
148:     throw new Error(
149:       `Web search failed (${response.status}): ${errorText}`
150:     );
151:   }
152: 
153:   const data =
154:     (await response.json()) as TavilySearchResponse;
155: 
156:   const results =
157:     (data.results ?? [])
158:       .map(
159:         (result) => ({
160:           title:
161:             result.title?.trim() ??
162:             "Untitled source",
163: 
164:           url:
165:             result.url?.trim() ??
166:             "",
167: 
168:           snippet:
169:             result.content?.trim() ??
170:             "",
171: 
172:           publishedDate:
173:             result.published_date?.trim(),
174:         })
175:       )
176:       .filter(
177:         (result) =>
178:           result.url.length > 0 &&
179:           result.snippet.length > 0
180:       );
181: 
182:   return {
183:     query:
184:       data.query?.trim() ??
185:       searchQuery,
186: 
187:     answer:
188:       data.answer?.trim() ??
189:       null,
190: 
191:     results,
192: 
193:     searchedAt,
194:   };
195: }
</file>

