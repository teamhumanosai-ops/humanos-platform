<file path="frontend/brain/runtime/steps/baseStage.ts">
  1: import {
  2:   BrainState,
  3: } from "../../brainState";
  4: 
  5: import {
  6:   getDecision,
  7: } from "../../decision";
  8: 
  9: import {
 10:   getPlan,
 11: } from "../../planning";
 12: 
 13: import {
 14:   getExecution,
 15: } from "../../execution";
 16: 
 17: import {
 18:   Stage,
 19: } from "./stage";
 20: 
 21: /**
 22:  * Base implementation for all Human OS cognitive stages.
 23:  *
 24:  * Every stage automatically:
 25:  *
 26:  * - validates the incoming BrainState
 27:  * - records execution
 28:  * - executes its responsibility
 29:  * - validates the returned BrainState
 30:  * - updates timestamps
 31:  * - captures failures
 32:  *
 33:  * BrainState remains the single shared cognitive artifact.
 34:  *
 35:  * Domain engines never own BrainState.
 36:  */
 37: export abstract class BaseStage
 38:   implements Stage {
 39:   abstract readonly name: string;
 40: 
 41:   async execute(
 42:     state: BrainState
 43:   ): Promise<BrainState> {
 44:     const startedAt =
 45:       Date.now();
 46: 
 47:     try {
 48:       /*
 49:       |--------------------------------------------------------------------------
 50:       | Pre-stage BrainState invariant
 51:       |--------------------------------------------------------------------------
 52:       |
 53:       | Every stage must receive a coherent BrainState.
 54:       |
 55:       */
 56: 
 57:       validateBrainState(
 58:         state,
 59:         this.name
 60:       );
 61: 
 62:       /*
 63:       |--------------------------------------------------------------------------
 64:       | Record stage execution
 65:       |--------------------------------------------------------------------------
 66:       */
 67: 
 68:       state.executedStages.push(
 69:         this.name
 70:       );
 71: 
 72:       /*
 73:       |--------------------------------------------------------------------------
 74:       | Execute stage responsibility
 75:       |--------------------------------------------------------------------------
 76:       */
 77: 
 78:       const result =
 79:         await this.process(
 80:           state
 81:         );
 82: 
 83:       /*
 84:       |--------------------------------------------------------------------------
 85:       | State continuity invariant
 86:       |--------------------------------------------------------------------------
 87:       |
 88:       | A stage must return the same cognitive artifact contract.
 89:       |
 90:       */
 91: 
 92:       if (
 93:         !result
 94:       ) {
 95:         throw new Error(
 96:           `Stage "${this.name}" returned no BrainState.`
 97:         );
 98:       }
 99: 
100:       /*
101:       |--------------------------------------------------------------------------
102:       | Post-stage BrainState invariant
103:       |--------------------------------------------------------------------------
104:       */
105: 
106:       validateBrainState(
107:         result,
108:         this.name
109:       );
110: 
111:       /*
112:       |--------------------------------------------------------------------------
113:       | Timestamp
114:       |--------------------------------------------------------------------------
115:       */
116: 
117:       result.updatedAt =
118:         new Date();
119: 
120:       /*
121:       |--------------------------------------------------------------------------
122:       | Diagnostics
123:       |--------------------------------------------------------------------------
124:       */
125: 
126:       console.debug(
127:         `[Runtime] ${this.name} (${Date.now() - startedAt} ms)`
128:       );
129: 
130:       return result;
131:     } catch (
132:       error
133:     ) {
134:       const message =
135:         error instanceof Error
136:           ? error.message
137:           : String(error);
138: 
139:       /*
140:       |--------------------------------------------------------------------------
141:       | Preserve diagnostic context
142:       |--------------------------------------------------------------------------
143:       */
144: 
145:       state.errors.push(
146:         `${this.name}: ${message}`
147:       );
148: 
149:       console.error(
150:         `[Runtime] ${this.name} failed`,
151:         error
152:       );
153: 
154:       throw error;
155:     }
156:   }
157: 
158:   protected abstract process(
159:     state: BrainState
160:   ): Promise<BrainState>;
161: }
162: 
163: /**
164:  * Validate the structural invariants that must hold
165:  * across the Cognitive Runtime.
166:  *
167:  * This function intentionally validates only relationships
168:  * that the current BrainState and domain APIs can prove.
169:  *
170:  * It does NOT invent stronger relationships that the
171:  * existing data models do not represent.
172:  */
173: function validateBrainState(
174:   state: BrainState,
175:   stageName: string
176: ): void {
177:   /*
178:   |--------------------------------------------------------------------------
179:   | Basic state invariant
180:   |--------------------------------------------------------------------------
181:   */
182: 
183:   if (
184:     !state
185:   ) {
186:     throw new Error(
187:       `Stage "${stageName}" received an invalid BrainState.`
188:     );
189:   }
190: 
191:   /*
192:   |--------------------------------------------------------------------------
193:   | Input invariant
194:   |--------------------------------------------------------------------------
195:   */
196: 
197:   if (
198:     typeof state.userMessage !==
199:     "string"
200:   ) {
201:     throw new Error(
202:       `Stage "${stageName}" received BrainState with an invalid userMessage.`
203:     );
204:   }
205: 
206:   /*
207:   |--------------------------------------------------------------------------
208:   | Collection invariants
209:   |--------------------------------------------------------------------------
210:   */
211: 
212:   if (
213:     !Array.isArray(
214:       state.messages
215:     )
216:   ) {
217:     throw new Error(
218:       `Stage "${stageName}" received BrainState with invalid messages.`
219:     );
220:   }
221: 
222:   if (
223:     !Array.isArray(
224:       state.executedStages
225:     )
226:   ) {
227:     throw new Error(
228:       `Stage "${stageName}" received BrainState with invalid executedStages.`
229:     );
230:   }
231: 
232:   if (
233:     !Array.isArray(
234:       state.diagnostics
235:     )
236:   ) {
237:     throw new Error(
238:       `Stage "${stageName}" received BrainState with invalid diagnostics.`
239:     );
240:   }
241: 
242:   if (
243:     !Array.isArray(
244:       state.errors
245:     )
246:   ) {
247:     throw new Error(
248:       `Stage "${stageName}" received BrainState with invalid errors.`
249:     );
250:   }
251: 
252:   /*
253:   |--------------------------------------------------------------------------
254:   | Plan invariant
255:   |--------------------------------------------------------------------------
256:   |
257:   | If the runtime says a plan is active, that plan must
258:   | exist in the Planning Engine.
259:   |
260:   */
261: 
262:   if (
263:     state.currentPlanId
264:   ) {
265:     const plan =
266:       getPlan(
267:         state.currentPlanId
268:       );
269: 
270:     if (
271:       !plan
272:     ) {
273:       throw new Error(
274:         `BrainState invariant failed: currentPlanId "${state.currentPlanId}" does not reference an existing plan.`
275:       );
276:     }
277:   }
278: 
279:   /*
280:   |--------------------------------------------------------------------------
281:   | Decision invariant
282:   |--------------------------------------------------------------------------
283:   |
284:   | If the runtime says a decision is active, that decision
285:   | must exist in the Decision Engine.
286:   |
287:   */
288: 
289:   if (
290:     state.currentDecisionId
291:   ) {
292:     const decision =
293:       getDecision(
294:         state.currentDecisionId
295:       );
296: 
297:     if (
298:       !decision
299:     ) {
300:       throw new Error(
301:         `BrainState invariant failed: currentDecisionId "${state.currentDecisionId}" does not reference an existing decision.`
302:       );
303:     }
304:   }
305: 
306:   /*
307:   |--------------------------------------------------------------------------
308:   | Execution invariant
309:   |--------------------------------------------------------------------------
310:   |
311:   | If an execution is active:
312:   |
313:   | 1. It must exist.
314:   | 2. It must reference the active plan when a plan exists.
315:   |
316:   */
317: 
318:   if (
319:     state.currentExecutionId
320:   ) {
321:     const execution =
322:       getExecution(
323:         state.currentExecutionId
324:       );
325: 
326:     if (
327:       !execution
328:     ) {
329:       throw new Error(
330:         `BrainState invariant failed: currentExecutionId "${state.currentExecutionId}" does not reference an existing execution.`
331:       );
332:     }
333: 
334:     if (
335:       state.currentPlanId &&
336:       execution.planId !==
337:         state.currentPlanId
338:     ) {
339:       throw new Error(
340:         `BrainState invariant failed: execution "${execution.id}" belongs to plan "${execution.planId}" but BrainState references plan "${state.currentPlanId}".`
341:       );
342:     }
343:   }
344: 
345:   /*
346:   |--------------------------------------------------------------------------
347:   | Runtime ID relationships
348:   |--------------------------------------------------------------------------
349:   |
350:   | A decision cannot exist in the runtime without a plan.
351:   |
352:   */
353: 
354:   if (
355:     state.currentDecisionId &&
356:     !state.currentPlanId
357:   ) {
358:     throw new Error(
359:       "BrainState invariant failed: currentDecisionId exists without currentPlanId."
360:     );
361:   }
362: 
363:   /*
364:   |--------------------------------------------------------------------------
365:   | Execution relationship
366:   |--------------------------------------------------------------------------
367:   |
368:   | An execution cannot exist in the runtime without
369:   | an active plan and decision.
370:   |
371:   */
372: 
373:   if (
374:     state.currentExecutionId &&
375:     !state.currentPlanId
376:   ) {
377:     throw new Error(
378:       "BrainState invariant failed: currentExecutionId exists without currentPlanId."
379:     );
380:   }
381: 
382:   if (
383:     state.currentExecutionId &&
384:     !state.currentDecisionId
385:   ) {
386:     throw new Error(
387:       "BrainState invariant failed: currentExecutionId exists without currentDecisionId."
388:     );
389:   }
390: 
391:   /*
392:   |--------------------------------------------------------------------------
393:   | Current goal invariant
394:   |--------------------------------------------------------------------------
395:   |
396:   | An active plan should provide the current cognitive goal.
397:   |
398:   */
399: 
400:   if (
401:     state.currentPlanId &&
402:     !state.currentGoal
403:   ) {
404:     throw new Error(
405:       "BrainState invariant failed: currentPlanId exists without currentGoal."
406:     );
407:   }
408: }
</file>

<file path="frontend/brain/runtime/steps/reasoningGraphStage.ts">
  1: import {
  2:   BrainState,
  3: } from "../../brainState";
  4: 
  5: import {
  6:   GraphEdge,
  7: } from "../../graph";
  8: 
  9: import {
 10:   graphQuery,
 11: } from "../../graph";
 12: 
 13: import {
 14:   BaseStage,
 15: } from "./baseStage";
 16: 
 17: /**
 18:  * ReasoningGraphStage
 19:  *
 20:  * Integrates the relevant Knowledge Graph relationships
 21:  * into the runtime BrainState.
 22:  *
 23:  * BrainStateStage hydrates the graph nodes first.
 24:  * This stage then derives only the relationships connected
 25:  * to those hydrated nodes so downstream reasoning receives
 26:  * graph evidence belonging to the current cognitive state.
 27:  */
 28: export class ReasoningGraphStage
 29:   extends BaseStage {
 30:   readonly name =
 31:     "ReasoningGraph";
 32: 
 33:   protected async process(
 34:     state: BrainState
 35:   ): Promise<BrainState> {
 36:     /*
 37:     |--------------------------------------------------------------------------
 38:     | No graph context
 39:     |--------------------------------------------------------------------------
 40:     |
 41:     | Keep the graph boundary explicit. If BrainState contains
 42:     | no graph nodes, it should also contain no graph relationships.
 43:     |
 44:     */
 45: 
 46:     if (
 47:       state.graph.length === 0
 48:     ) {
 49:       state.graphEdges = [];
 50: 
 51:       return state;
 52:     }
 53: 
 54:     /*
 55:     |--------------------------------------------------------------------------
 56:     | Build the current BrainState graph boundary
 57:     |--------------------------------------------------------------------------
 58:     |
 59:     | Only relationships whose endpoints are already present in
 60:     | BrainState.graph are eligible for downstream reasoning.
 61:     |
 62:     */
 63: 
 64:     const graphNodeIds =
 65:       new Set(
 66:         state.graph.map(
 67:           (node) =>
 68:             node.id
 69:         )
 70:       );
 71: 
 72:     const relevantEdges =
 73:       graphQuery
 74:         .getEdges()
 75:         .filter(
 76:           (
 77:             edge: GraphEdge
 78:           ) =>
 79:             graphNodeIds.has(
 80:               edge.from
 81:             ) &&
 82:             graphNodeIds.has(
 83:               edge.to
 84:             )
 85:         );
 86: 
 87:     /*
 88:     |--------------------------------------------------------------------------
 89:     | Preserve the shared BrainState contract
 90:     |--------------------------------------------------------------------------
 91:     |
 92:     | Do not create another graph context object.
 93:     | BrainState remains the single cognitive artifact.
 94:     |
 95:     */
 96: 
 97:     state.graphEdges =
 98:       relevantEdges;
 99: 
100:     return state;
101:   }
102: }
</file>

<file path="frontend/brain/runtime/outcome.ts">
  1: import type {
  2:   ExecutionStatus,
  3: } from "../execution";
  4: 
  5: export type RuntimeOutcomeStatus =
  6:   | "in_progress"
  7:   | "completed"
  8:   | "failed"
  9:   | "blocked";
 10: 
 11: export type RuntimeOutcome = {
 12:   status:
 13:     RuntimeOutcomeStatus;
 14: 
 15:   result:
 16:     string | null;
 17: 
 18:   errors:
 19:     string[];
 20: 
 21:   metadata: {
 22:     executionId:
 23:       string | null;
 24: 
 25:     executionStatus:
 26:       ExecutionStatus | null;
 27: 
 28:     planId:
 29:       string | null;
 30: 
 31:     decisionId:
 32:       string | null;
 33: 
 34:     stagesExecuted:
 35:       string[];
 36: 
 37:     createdAt:
 38:       Date;
 39: 
 40:     completedAt:
 41:       Date;
 42:   };
 43: };
 44: 
 45: export function createRuntimeOutcome(
 46:   input: {
 47:     result:
 48:       string | null;
 49: 
 50:     errors:
 51:       string[];
 52: 
 53:     executionId:
 54:       string | null;
 55: 
 56:     executionStatus:
 57:       ExecutionStatus | null;
 58: 
 59:     planId:
 60:       string | null;
 61: 
 62:     decisionId:
 63:       string | null;
 64: 
 65:     stagesExecuted:
 66:       string[];
 67:   }
 68: ): RuntimeOutcome {
 69:   const completedAt =
 70:     new Date();
 71: 
 72:   const status:
 73:     RuntimeOutcomeStatus =
 74:     determineOutcomeStatus(
 75:       input
 76:     );
 77: 
 78:   return {
 79:     status,
 80: 
 81:     result:
 82:       input.result,
 83: 
 84:     errors:
 85:       [...input.errors],
 86: 
 87:     metadata: {
 88:       executionId:
 89:         input.executionId,
 90: 
 91:       executionStatus:
 92:         input.executionStatus,
 93: 
 94:       planId:
 95:         input.planId,
 96: 
 97:       decisionId:
 98:         input.decisionId,
 99: 
100:       stagesExecuted:
101:         [...input.stagesExecuted],
102: 
103:       createdAt:
104:         completedAt,
105: 
106:       completedAt,
107:     },
108:   };
109: }
110: 
111: function determineOutcomeStatus(
112:   input: {
113:     result:
114:       string | null;
115: 
116:     errors:
117:       string[];
118: 
119:     executionStatus:
120:       ExecutionStatus | null;
121:   }
122: ): RuntimeOutcomeStatus {
123:   /*
124:   |--------------------------------------------------------------------------
125:   | Runtime failures take precedence.
126:   |--------------------------------------------------------------------------
127:   */
128: 
129:   if (
130:     input.errors.length > 0
131:   ) {
132:     return "failed";
133:   }
134: 
135:   /*
136:   |--------------------------------------------------------------------------
137:   | Blocked execution.
138:   |--------------------------------------------------------------------------
139:   */
140: 
141:   if (
142:     input.executionStatus ===
143:     "blocked"
144:   ) {
145:     return "blocked";
146:   }
147: 
148:   /*
149:   |--------------------------------------------------------------------------
150:   | Active execution.
151:   |--------------------------------------------------------------------------
152:   */
153: 
154:   if (
155:     input.executionStatus ===
156:       "pending" ||
157:     input.executionStatus ===
158:       "in_progress"
159:   ) {
160:     return "in_progress";
161:   }
162: 
163:   /*
164:   |--------------------------------------------------------------------------
165:   | Completed cognitive response.
166:   |--------------------------------------------------------------------------
167:   */
168: 
169:   if (
170:     input.result?.trim()
171:   ) {
172:     return "completed";
173:   }
174: 
175:   /*
176:   |--------------------------------------------------------------------------
177:   | No response and no active execution.
178:   |--------------------------------------------------------------------------
179:   |
180:   | The runtime cannot claim completion when there
181:   | is no actual result. Keep the outcome conservative.
182:   |
183:   */
184: 
185:   return "in_progress";
186: }
</file>

