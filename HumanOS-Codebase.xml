 3: import { AnalysisResult } from "./AnalysisResult";
 4: import { ContentAnalyzer } from "./ContentAnalyzer";
 5: import { TextAnalyzer } from "./TextAnalyzer";
 6: 
 7: export class AnalyzerRegistry {
 8:     private static readonly analyzers: ContentAnalyzer[] = [
 9:         new TextAnalyzer(),
10:     ];
11: 
12:     static register(
13:         analyzer: ContentAnalyzer
14:     ): void {
15:         this.analyzers.unshift(analyzer);
16:     }
17: 
18:     static async analyze(
19:         content: ExtractedContent
20:     ): Promise<AnalysisResult> {
21:         /**
22:          * Phase 1
23:          *
24:          * We currently execute the first registered analyzer.
25:          *
26:          * Later milestones will introduce analyzer selection
27:          * based on artifact type and analysis capabilities.
28:          */
29: 
30:         const analyzer = this.analyzers[0];
