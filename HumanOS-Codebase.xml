<file path="frontend/brain/confidenceScorer.ts">
 1: import { Plan } from "./planning";
 2: 
 3: export function calculateConfidence(
 4:   plan: Plan,
 5:   action: string
 6: ): number {
 7:   let score = 0;
 8: 
 9:   // Priority contributes up to 40 points
10:   score += plan.priority * 40;
11: 
12:   // Current next action gets a boost
13:   if (action === plan.nextAction) {
14:     score += 40;
15:   }
16: 
17:   // Existing confidence contributes up to 20 points
18:   score += Math.round(plan.confidence * 20);
19: 
20:   return Math.min(score, 100);
21: }
</file>

