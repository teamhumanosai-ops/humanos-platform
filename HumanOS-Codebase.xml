<file path="frontend/brain/content/engines/pdf/PdfParseEngine.ts">
 1: import { PDFParse } from "pdf-parse";
 2: 
 3: import {
 4:     PdfEngine,
 5:     PdfExtractionResult,
 6: } from "./PdfEngine";
 7: 
 8: export class PdfParseEngine extends PdfEngine {
 9:     async extractText(
10:         content: Buffer
11:     ): Promise<PdfExtractionResult> {
12:         const parser = new PDFParse({
13:             data: content,
14:         });
15: 
16:         try {
17:             const textResult = await parser.getText();
18: 
19:             const infoResult = await parser.getInfo();
20: 
21:             return {
22:                 text: textResult.text,
23: 
24:                 pageCount: textResult.total ?? 0,
25: 
26:                 metadata: {
27:                     title: infoResult.info?.Title,
28: 
29:                     author: infoResult.info?.Author,
30: 
31:                     subject: infoResult.info?.Subject,
32: 
33:                     creator: infoResult.info?.Creator,
34: 
35:                     producer: infoResult.info?.Producer,
36: 
37:                     keywords:
38:                         infoResult.info?.Keywords
39:                             ?.split(",")
40:                             .map((keyword: string) =>
41:                                 keyword.trim()
42:                             ) ?? [],
43:                 },
44:             };
45:         } finally {
46:             await parser.destroy();
47:         }
48:     }
49: }
</file>

