 4: export function analyzeTimeline(
 5:   events: TimelineEvent[]
 6: ): Reflection[] {
 7:   const reflections: Reflection[] = [];
 8: 
 9:   const hasStartup = events.some(
10:     (event) => event.category === "Startup"
11:   );
12: 
13:   const achievements = events.filter(
14:     (event) => event.category === "Achievement"
15:   );
16: 
17:   if (hasStartup && achievements.length >= 1) {
18:     reflections.push({
19:       summary:
20:         "You are actively building projects and successfully completing important milestones.",
21: 
22:       evidence: events
23:         .filter(
24:           (event) =>
25:             event.category === "Startup" ||
26:             event.category === "Achievement"
27:         )
28:         .map((event) => event.title)
29:         .join(", "),
30: 
31:       confidence: 95,
32: 
33:       createdAt: new Date().toISOString(),
34:     });
35:   }
36: 
37:   return reflections;
38: }
